    <!-- ===========================================================
ESTILOS PARA BADGE DE ESTADO DEL DATAGRID
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <Style x:Key="EstadoBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Background" Value="#2A0A0A"/>
        <Setter Property="BorderBrush" Value="#551515"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Background" Value="#0A2A14"/>
                <Setter Property="BorderBrush" Value="#15552A"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstadoDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>

        <Setter Property="Fill" Value="#FF4444"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Fill" Value="#00E676"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstadoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Text" Value="Inactivo"/>
        <Setter Property="Foreground" Value="#FF6666"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Text" Value="Activo"/>
                <Setter Property="Foreground" Value="#00E676"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MembresiaBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
        <Setter Property="Background" Value="#1A1A30"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="activa">
                <Setter Property="Background" Value="{StaticResource BrushActivaFondo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="por_vencer">
                <Setter Property="Background" Value="{StaticResource BrushPorVencerFondo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="vencida">
                <Setter Property="Background" Value="{StaticResource BrushVencidaFondo}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MembresiaDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Fill" Value="#6A6A9A"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="activa">
                <Setter Property="Fill" Value="{StaticResource BrushActivaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="por_vencer">
                <Setter Property="Fill" Value="{StaticResource BrushPorVencerTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="vencida">
                <Setter Property="Fill" Value="{StaticResource BrushVencidaTexto}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MembresiaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#6A6A9A"/>
        <Setter Property="Text" Value="{Binding EstadoTexto}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="activa">
                <Setter Property="Foreground" Value="{StaticResource BrushActivaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="por_vencer">
                <Setter Property="Foreground" Value="{StaticResource BrushPorVencerTexto}"/>
                <Setter Property="Text" Value="Por vencer"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding EstadoVisual}" Value="vencida">
                <Setter Property="Foreground" Value="{StaticResource BrushVencidaTexto}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===========================================================
ESTILOS PARA EL BUSCADOR PARA QUE EL PLACEHOLDER DESAPAREZCA DESPACIO
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <Style x:Key="BuscadorStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#16162A"/>
        <Setter Property="Foreground" Value="#E8E8FF"/>
        <Setter Property="BorderBrush" Value="#252540"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <fa:ImageAwesome Icon="Search" Foreground="White" Height="16" Width="16" Grid.Column="0"/>

                            <Grid Grid.Column="1">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>

                                <TextBlock x:Name="PlaceholderText" 
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#3A3A5C"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===========================================================
ESTILOS PARA LOS CHECKBOXS DEL PANEL LATERAL
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <Style x:Key="DiaCheckEstilo" TargetType="{x:Type CheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,4,8,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="diaBorder" 
            Background="{StaticResource DiaFondoNormal}"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,6"
            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="diaBorder" Property="Background" Value="{StaticResource DiaFondoSeleccionado}"/>
                            <Setter TargetName="diaBorder" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource DiaTextoSeleccionado}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="diaBorder" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===========================================================
ESTILOS PARA ToolTips Oscuros
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ColorCardAlta}"/>
        <!-- #1A1A2E -->
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <!-- #E8E8FF -->
        <Setter Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
        <!-- #3A3A60 -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <!-- Efecto sutil de sombra para que resalte sobre el fondo -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


