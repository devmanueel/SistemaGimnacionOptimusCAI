    <!-- ═══════════════════════════════════════════════════════════
         PALETA OSCURA — SISTEMA GIMNASIO OPTIMUS CAI
         REGLA: todos los colores definidos ANTES de usarlos
    ═══════════════════════════════════════════════════════════ -->

    <!-- Fondos -->
    <SolidColorBrush x:Key="ColorFondo"         Color="#0A0A14"/>
    <SolidColorBrush x:Key="ColorCard"          Color="#12121E"/>
    <SolidColorBrush x:Key="ColorCardAlta"      Color="#1A1A2E"/>
    <SolidColorBrush x:Key="ColorBorde"         Color="#252540"/>
    <SolidColorBrush x:Key="ColorBordeAlto"     Color="#3A3A60"/>

    <!-- Keys de compatibilidad con páginas existentes -->
    <SolidColorBrush x:Key="ColorOscuroFondo"   Color="#0A0A14"/>
    <SolidColorBrush x:Key="ColorBlanco"        Color="#12121E"/>
    <SolidColorBrush x:Key="ColorInputFondo"    Color="#0D0D1A"/>

    <!-- Primario: cyan eléctrico -->
    <SolidColorBrush x:Key="ColorPrimario"      Color="#00CFFF"/>
    <SolidColorBrush x:Key="ColorPrimarioHover" Color="#00AADD"/>

    <!-- Acento: naranja energía -->
    <SolidColorBrush x:Key="ColorNaranja"       Color="#FF6B35"/>
    <SolidColorBrush x:Key="ColorNaranjaHover"  Color="#E85520"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="ColorTextoPrincipal"  Color="#E8E8FF"/>
    <SolidColorBrush x:Key="ColorTextoSecundario" Color="#6A6A9A"/>
    <SolidColorBrush x:Key="ColorVioleta" Color="#A78BFA" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="ColorInput"         Color="#16162A"/>
    <SolidColorBrush x:Key="ColorInputHover"    Color="#1E1E38"/>
    <SolidColorBrush x:Key="ColorInputFoco"     Color="#111126"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="ColorExito"         Color="#00E676"/>
    <SolidColorBrush x:Key="ColorError"         Color="#FF4444"/>
    <SolidColorBrush x:Key="ColorAdvertencia"   Color="#FFA726"/>

    <!-- Colores sólidos para degradados definidos en code/page -->
    <Color x:Key="ColorNaranjaColor"            >#FF6B35</Color>
    <Color x:Key="ColorNaranjaOscuroColor"      >#FF3D1F</Color>
    <Color x:Key="ColorCyanColor"               >#00CFFF</Color>
    <Color x:Key="ColorVioletaColor"            >#A78BFA</Color>
    <Color x:Key="ColorActiva"                  >#00E676</Color>
    <Color x:Key="ColorVencida"                 >#FF4444</Color>
    <Color x:Key="ColorPorVencer"               >#FFA726</Color>

    <!-- Colores para los badge -->
    <SolidColorBrush x:Key="BadgeVioletaFondo" Color="#1E1840"/>
    <SolidColorBrush x:Key="BadgeVioletaBorde" Color="#4C3A8E"/>
    <SolidColorBrush x:Key="BadgeVioletaHover" Color="#2D2460"/>

    <SolidColorBrush x:Key="BadgeNaranjaFondo" Color="#2A1600"/>
    <SolidColorBrush x:Key="BadgeNaranjaBorde" Color="#85451A"/>
    <SolidColorBrush x:Key="BadgeNaranjaHover" Color="#402200"/>

    <SolidColorBrush x:Key="BadgeCyanFondo"    Color="#060E14"/>
    <SolidColorBrush x:Key="BadgeCyanBorde"    Color="#007A99"/>
    <SolidColorBrush x:Key="BadgeCyanHover"    Color="#0F253A"/>

    <SolidColorBrush x:Key="BrushActivaFondo" Color="#0A2A14"/>
    <SolidColorBrush x:Key="BrushActivaTexto" Color="#00E676"/>

    <SolidColorBrush x:Key="BrushPorVencerFondo" Color="#2A1F00"/>
    <SolidColorBrush x:Key="BrushPorVencerTexto" Color="#FFA726"/>

    <SolidColorBrush x:Key="BrushVencidaFondo" Color="#2A0A0A"/>
    <SolidColorBrush x:Key="BrushVencidaTexto" Color="#FF6666"/>

    <!-- Colores para los Checkbox del panel lateral -->
    <SolidColorBrush x:Key="DiaFondoNormal" Color="#16162A"/>
    <SolidColorBrush x:Key="DiaFondoSeleccionado" Color="#00CFFF"/>
    <SolidColorBrush x:Key="DiaTextoSeleccionado" Color="#0A0A14"/>

    <!-- ═══════════════════════════════════════════════════════════
         TIPOGRAFÍA
         NOTA: LetterSpacing NO existe en WPF → no se usa
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="TituloEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="FontSize"   Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SubtituloEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="Margin"     Value="0,0,0,16"/>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         INPUT TextBox OSCURO
         FIX: DropShadowEffect NO se puede targetear en Triggers.
         Usamos cambio de BorderBrush y BorderThickness en su lugar.
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="InputEstilo" TargetType="{x:Type TextBox}">
        <Setter Property="Height"                   Value="46"/>
        <Setter Property="Background"               Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource ColorBorde}"/>
        <Setter Property="Foreground"               Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="CaretBrush"               Value="{StaticResource ColorPrimario}"/>
        <Setter Property="SelectionBrush"           Value="#3300CFFF"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="Margin"                   Value="0,0,0,20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- x:Name="borde" → sí se puede targetear porque es FrameworkElement -->
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG -->
    <!-- ═══════════════════════════════════════════════════════════
     DataPiker TextBox OSCURO
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════════════════
     DATEPICKER OSCURO — OPTIMUS CAI
═══════════════════════════════════════════════════════════ -->

    <Style x:Key="DatePickerInputInternoEstilo" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CaretBrush" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="ReadOnly"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Margin="4,0"
                                  Height="19"
                                  FontSize="14"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarDayButtonStyleCustom" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid>
                        <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="1"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorFondo}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid>
                        <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="0"
                            Margin="2"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorFondo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarItemEstiloLimpio" TargetType="{x:Type CalendarItem}">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="CalendarioDark" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="#1A1A2E"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButtonStyleCustom}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarItemEstiloLimpio}"/>
    </Style>

    <Style x:Key="DatePickerEstilo" TargetType="{x:Type DatePicker}">
        <Setter Property="CalendarStyle" Value="{DynamicResource CalendarioDark}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Border x:Name="borde"
                        Background="{StaticResource ColorInput}"
                        BorderBrush="{StaticResource ColorBorde}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Height="40">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Style="{StaticResource DatePickerInputInternoEstilo}"
                                           Focusable="{TemplateBinding Focusable}"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Center"/>

                            <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Focusable="False"
                                Background="Transparent"
                                BorderThickness="0"
                                    Height="25"
                                    
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBg"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBg" Property="Background"
                                                    Value="{StaticResource ColorInputHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <fa:ImageAwesome Icon="Calendar"
                                             Foreground="{StaticResource ColorTextoPrincipal}"
                                             Height="16" Width="16"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                            </Button>

                            <Popup x:Name="PART_Popup"
       PopupAnimation="None"
       Placement="Bottom"
       PlacementTarget="{Binding ElementName=borde}"
       StaysOpen="False">
                                <Border Background="#1A1A2E"
            BorderBrush="#252540"
            BorderThickness="1"
            CornerRadius="0"
            SnapsToDevicePixels="True">
                                    <Calendar x:Name="PART_Calendar"
                  Background="#1A1A2E"
                  BorderThickness="0"
                  BorderBrush="Transparent"
                  Foreground="{StaticResource ColorTextoPrincipal}"
                  Style="{StaticResource CalendarioDark}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- PasswordBox — misma estructura, sin DropShadowEffect en triggers -->
    <Style x:Key="PasswordEstilo" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="46"/>
        <Setter Property="Background"               Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource ColorBorde}"/>
        <Setter Property="Foreground"               Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin"                   Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
     Estilo ComboBox
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 2. ESTILO PARA EL COMBOBOX (EL CONTENEDOR) -->
    <Style x:Key="ComboBoxEstilo" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- El ToggleButton abarca todo el control para que sea cliqueable en cualquier parte -->
                        <ToggleButton x:Name="toggleButton"
                                  Grid.ColumnSpan="2"
                                  Focusable="False"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="borde"
                                        Background="{StaticResource ColorInput}"
                                        BorderBrush="{StaticResource ColorBorde}"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="arrow"
                                              Grid.Column="1"
                                              Data="M0,0 L4,4 L8,0 Z"
                                              Fill="{StaticResource ColorTextoPrincipal}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                            <Setter TargetName="borde" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Presentador del texto seleccionado (No interfiere con el clic) -->
                        <ContentPresenter x:Name="contentPresenter"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Margin="14,0,30,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                        <Popup x:Name="PART_Popup"
       AllowsTransparency="True"
       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
       Placement="Bottom"
       PopupAnimation="Fade">
                            <Border Background="#16162A"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,2,0,0"
            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">

                                <ScrollViewer MaxHeight="300" 
                      Style="{StaticResource PanelScrollViewerStyle}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>

                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
     Estilo ComboBoxItem
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 1. ESTILO PARA LOS ÍTEMS (LAS OPCIONES) -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="gd" Background="{TemplateBinding Background}" 
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- HOVER: Fondo cian y texto oscuro para legibilidad -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="#16162A"/>
                        </Trigger>
                        <!-- SELECCIONADO: Resaltado sutil -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="#3300CFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Cambios de JoakoG-->
    <!-- Estilos para los botones de filtro en SociosPage -->
    <Style x:Key="ChipFiltroEstilo" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bordeChip"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
                        <ContentPresenter x:Name="content"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- HOVER: Usando el mismo color que el DataPicker -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bordeChip" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>

                        <!-- EFECTO CLIC: Un poco más oscuro para feedback -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bordeChip" Property="Background" Value="{StaticResource ColorBorde}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG -->


    <!-- ═══════════════════════════════════════════════════════════
         BOTONES
         FIX: Sin DropShadowEffect en triggers (no es targeteable).
         Los efectos de sombra van en el XAML de cada página con
         <Button.Effect> fuera del template.
    ═══════════════════════════════════════════════════════════ -->

    <!-- Botón Primario: cyan -->
    <Style x:Key="BotonPrincipalEstilo" TargetType="Button">
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Background"      Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground"      Value="#0A0A14"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="FontFamily"      Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="20,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorPrimarioHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.82"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón Naranja (acción positiva / nuevo) -->
    <Style x:Key="BotonNaranjaEstilo" TargetType="Button">
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="FontFamily"      Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde" CornerRadius="10">
                        <!-- Degradado inline: no referencia recursos → no puede fallar -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#FF3D1F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="20,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón Cancelar / Cerrar -->
    <Style x:Key="BotonCerrarEstilo" TargetType="Button">
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ColorBorde}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"   Value="#2A0A0A"/>
                            <Setter TargetName="borde" Property="BorderBrush"  Value="{StaticResource ColorError}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorError}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID — totalmente oscuro
    ═══════════════════════════════════════════════════════════ -->

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="FontFamily"                 Value="Segoe UI Semibold, Segoe UI"/>
        <Setter Property="FontSize"                   Value="11"/>
        <Setter Property="FontWeight"                 Value="Bold"/>
        <Setter Property="Padding"                    Value="14,14,14,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness"            Value="0,0,0,1"/>
        <Setter Property="BorderBrush"                Value="{StaticResource ColorBorde}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"      Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" BorderThickness="0" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin"          Value="0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1A1A35"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1A2545"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         MENÚ LATERAL / SIDEBAR
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="AnimatedSidebarStyle" TargetType="Border">
        <Setter Property="Background"        Value="#080812"/>
        <Setter Property="Width"             Value="65"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderBrush"       Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness"   Value="0,0,1,0"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                         To="220" Duration="0:0:0.22"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                         To="65" Duration="0:0:0.18"
                                         AccelerationRatio="0.4"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="#8080B0"/>
        <Setter Property="Height"                     Value="52"/>
        <Setter Property="FontSize"                   Value="14"/>
        <Setter Property="FontFamily"                 Value="Segoe UI"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo" Background="{TemplateBinding Background}"
                            BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="indicador" Grid.Column="0"
                                    HorizontalAlignment="Left" Width="3"
                                    Background="Transparent" CornerRadius="0,2,2,0"/>
                            <ContentPresenter Grid.Column="0" Grid.ColumnSpan="2"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo"     Property="Background" Value="#12122A"/>
                            <Setter Property="Foreground"  Value="#E0E0FF"/>
                            <Setter TargetName="indicador" Property="Background"
                                    Value="{StaticResource ColorPrimario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="15,0,0,0"/>
        <Setter Property="Visibility"        Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType=Border, AncestorLevel=2}}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconoVectorStyle" TargetType="Path">
        <Setter Property="Width"   Value="20"/>
        <Setter Property="Height"  Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin"  Value="20,0,0,0"/>
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <!-- Botones barra de título -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#8080B0"/>
        <Setter Property="Width"           Value="45"/>
        <Setter Property="Height"          Value="35"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="#1E1E38"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#8B0000"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Cambios de JoakoG -->

    <!-- ESTILO PARA LOS BOTONES -->
    <Style x:Key="TabBtnEstilo" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#6A6A9A"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <!-- Importante: Ponemos el borde en 0 para que el botón no dibuje su propia línea -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#E8E8FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#00CFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ESTILO PARA LA BARRA DESLIZANTE (Aquí vive el diseño neón) -->
    <Style x:Key="BarraNeonEstilo" TargetType="Border">
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <!-- Esto le da el aire abajo del texto -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00CFFF" Offset="0"/>
                    <GradientStop Color="#A78BFA" Offset="0.5"/>
                    <GradientStop Color="#FF6B35" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <!-- El resplandor que tanto nos gusta -->
                <DropShadowEffect Color="#00CFFF" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG-->

    <!--
    ════════════════════════════════════════════════════════════
    SNIPPET PARA AGREGAR A MiDiccionario.xaml

    Pegá este Style ANTES del </ResourceDictionary> de cierre
    en tu archivo MiDiccionario.xaml. Es el chip de filtro
    reutilizable, así no tenés que duplicar el código en cada
    página (Socios, Actividades, Membresías, etc.)
    ════════════════════════════════════════════════════════════
-->

    <!-- Chip de filtro (Todos / Activos / Inactivos / etc.) -->
    <Style x:Key="BotonChipEstilo" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ColorBorde}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,0"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Width"           Value="105" />
        <Setter Property="Height"          Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">

                        <Border.Effect>
                            <DropShadowEffect x:Name="Shadow" BlurRadius="0" ShadowDepth="0" 
                                          Color="{StaticResource ColorCyanColor}" Opacity="0"/>
                        </Border.Effect>

                        <ContentPresenter x:Name="content"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInput}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                            <Setter TargetName="content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonChipActivoEstilo" BasedOn="{StaticResource BotonChipEstilo}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BadgeCyanFondo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
        <!-- <Setter Property="Foreground" Value="White"/> -->
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="40" VerticalAlignment="Center">
                        <Border x:Name="bordeActivo"
                            Height="32"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" 
                                              ShadowDepth="0" 
                                              Color="{StaticResource ColorCyanColor}" 
                                              Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ********************************* -->
    <!-- Cambios de JoakoG -->
    <!-- Estilo Base para los Botones de Acción -->
    <!-- Estilo Base con tu ColorBorde y ColorInput -->
    <Style x:Key="ButtonStyleAccionBase" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,0"/>
        <!-- Separación clave para evitar errores de clic -->
        <Setter Property="Background" Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="InternalBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Cambio sutil de fondo general -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InternalBorder" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón EDITAR: Usa tu ColorPrimario (Cyan) -->
    <Style x:Key="ButtonStyleEditar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="Background" Value="{StaticResource BadgeCyanHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón RENOVAR: Usa tu ColorExito (Verde) -->
    <Style x:Key="ButtonStyleRenovar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Background" Value="{StaticResource BrushActivaFondo}"/>
        <Setter Property="BorderBrush" Value="#15552A"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorExito}"/>
                <Setter Property="Background" Value="#0E3A1C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón ELIMINAR/CANCELAR: Usa tu ColorError (Rojo) -->
    <Style x:Key="ButtonStyleCancelar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Setter Property="Background" Value="#2A0A0A"/>
        <Setter Property="BorderBrush" Value="#551515"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorError}"/>
                <Setter Property="Background" Value="#3D0E0E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para BOTÓN ESTADO -->
    <Style x:Key="ButtonStyleEstado" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#FF5555"/>
                <!-- Iluminación Roja -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===========================================================
     ESTILOS DE LOS INDICADORES (KPIs)
     Usando la paleta oficial de Optimus CAI
     =========================================================== -->

    <!-- Estilo base para el contenedor de la tarjeta -->
    <Style x:Key="KpiCardBorderStyle" TargetType="Border">
        <!-- Usa tu color de tarjeta oscuro -->
        <Setter Property="Background" Value="{StaticResource ColorCard}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <!-- Usa tu color de borde definido -->
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para el texto de descripción (debajo del número) -->
    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Usa tu color de texto secundario (grisáceo) -->
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
    </Style>

    <!-- Estilo para el número grande -->
    <Style x:Key="KpiNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <!-- El color se define por instancia (Cyan, Éxito, Naranja, etc.) -->
    </Style>

    <!-- Estilo para el icono decorativo de fondo -->
    <Style x:Key="KpiIconStyle" TargetType="fa:ImageAwesome">
        <Setter Property="Opacity" Value="0.1"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- Estilos para los stats de MembresiasPage-->
    <Style x:Key="BorderStyleStatCard" TargetType="Border">
        <Setter Property="Background" Value="#12121E"/>
        <Setter Property="BorderBrush" Value="#252540"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TextBlockStatValor" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextBlockStatEtiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#6A6A9A"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <LinearGradientBrush x:Key="BrushGlowFinanciero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00CFFF" Offset="0.0"/>
        <GradientStop Color="#007BFF" Offset="1.0"/>
    </LinearGradientBrush>

    <Geometry x:Key="IconGraficoCrecimiento">
        M4,17H7V10H4V17M9,17H12V5H9V17M14,17H17V13H14V17M19,17V20H2V3H4V17H19Z
    </Geometry>

    <!-- ===========================================================
ESTILOS PARA EL SCROLL DEL PANEL LATERAL PARA QUE SEA GLOBAL
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <!-- Estilo para el "Thumb" (la parte que se desliza) -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Usamos ColorBordeAlto para que resalte un poco sobre el fondo -->
                    <Border Background="{StaticResource ColorBorde}" 
                        CornerRadius="4" 
                        Margin="12, 8, 0, 0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo General de la ScrollBar -->
    <Style x:Key="ModernScrollStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <!-- El carril de fondo -->
                        <Border Background="Transparent" CornerRadius="4" HorizontalAlignment="Left" />
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo del ScrollBar para paneles laterales -->
    <Style x:Key="PanelScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}"
                      ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter Grid.Column="0"
                                            ClipToBounds="False"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Column="1"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                               Style="{StaticResource ModernScrollStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para aplicar al Scroll en el DataGrid con x:key -->
    <Style x:Key="DataGridScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Column="1"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                               Style="{StaticResource ModernScrollStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modificar el scroll en DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <ScrollViewer x:Name="DG_ScrollViewer" 
                                  Focusable="false"
                                  Style="{StaticResource DataGridScrollViewerStyle}">

                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" 
                                                                  Grid.Column="0" Grid.Row="0"
                                                                  Visibility="{Binding HeadersVisibility, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                          Grid.Column="0" Grid.Row="1"
                                                          CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                               Grid.Column="1" Grid.Row="1"
                                               Value="{TemplateBinding VerticalOffset}"
                                               Maximum="{TemplateBinding ScrollableHeight}"
                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                               Style="{StaticResource ModernScrollStyle}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

