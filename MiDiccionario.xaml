    <!-- Cambios de JoakoG -->
    <!-- Estilo Base para los Botones de Acción -->
    <!-- Estilo Base con tu ColorBorde y ColorInput -->
    <Style x:Key="ButtonStyleAccionBase" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,0"/>
        <!-- Separación clave para evitar errores de clic -->
        <Setter Property="Background" Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="InternalBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Cambio sutil de fondo general -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InternalBorder" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón EDITAR: Cyan -->
    <Style x:Key="ButtonStyleEditar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ColorEditarCyan}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorEditarCyan}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón RENOVAR: Usa tu ColorExito (Verde) -->
    <Style x:Key="ButtonStyleRenovar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Background" Value="{StaticResource BrushActivaFondo}"/>
        <Setter Property="BorderBrush" Value="#15552A"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorExito}"/>
                <Setter Property="Background" Value="#0E3A1C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón ELIMINAR/CANCELAR: Usa tu ColorError (Rojo) -->
    <Style x:Key="ButtonStyleCancelar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Setter Property="BorderBrush" Value="#551515"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorError}"/>
                <Setter Property="Background" Value="#3D0E0E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para BOTÓN ESTADO -->
    <Style x:Key="ButtonStyleEstado" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Activo}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource ColorError}"/>
                <Setter Property="Background" Value="#2A1A1A"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Activo}" Value="False"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="#00E676"/>
                <Setter Property="Background" Value="#1A2A1A"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

