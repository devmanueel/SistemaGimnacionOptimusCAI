    <!-- ═══════════════════════════════════════════════════════════
         DESIGN SYSTEM — OPTIMUS CAI GIMNASIO
         Flat design, no gradients, no shadows
    ═══════════════════════════════════════════════════════════ -->

    <!-- Fondos — jerarquía de capas -->
    <SolidColorBrush x:Key="ColorFondo"         Color="#080A08"/>  <!-- bg-base -->
    <SolidColorBrush x:Key="ColorCard"          Color="#0D110D"/>  <!-- bg-surface -->
    <SolidColorBrush x:Key="ColorCardAlta"      Color="#111811"/>  <!-- bg-surface-2 -->
    <SolidColorBrush x:Key="ColorBorde"         Color="#1E281E"/>  <!-- border -->
    <SolidColorBrush x:Key="ColorBordeAlto"     Color="#3A8C3A"/>  <!-- green-mid -->
    <SolidColorBrush x:Key="ColorBordeCard"     Color="#1C2A1C"/>  <!-- card border variant -->

    <!-- Keys de compatibilidad -->
    <SolidColorBrush x:Key="ColorOscuroFondo"   Color="#080A08"/>
    <SolidColorBrush x:Key="ColorBlanco"        Color="#0D110D"/>
    <SolidColorBrush x:Key="ColorInputFondo"    Color="#111811"/>
    <SolidColorBrush x:Key="ColorFondoSidebar"  Color="#080A08"/>
    <SolidColorBrush x:Key="ColorCardOscuro"    Color="#111811"/>
    <SolidColorBrush x:Key="ColorNavActivoBg"   Color="#162016"/>

    <!-- Verde marca -->
    <SolidColorBrush x:Key="ColorPrimario"      Color="#4ADE80"/>
    <SolidColorBrush x:Key="ColorPrimarioHover" Color="#6BE8A0"/>

    <!-- Acento -->
    <SolidColorBrush x:Key="ColorNaranja"       Color="#6BE8A0"/>
    <SolidColorBrush x:Key="ColorNaranjaHover" Color="#6BE8A0"/>

    <!-- Texto — jerarquía -->
    <SolidColorBrush x:Key="ColorTextoPrincipal"  Color="#E8F5E8"/>  <!-- text-primary -->
    <SolidColorBrush x:Key="ColorTextoSecundario" Color="#7AAD7A"/>  <!-- text-secondary -->
    <SolidColorBrush x:Key="ColorTextoMuted"      Color="#3D5C3D"/>  <!-- text-muted -->
    <SolidColorBrush x:Key="ColorCuerpo"           Color="#C8D4C8"/>  <!-- body/row text -->
    <SolidColorBrush x:Key="ColorVioleta" Color="#4ADE80" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="ColorInput"         Color="#111811"/>
    <SolidColorBrush x:Key="ColorInputHover"   Color="#162016"/>
    <SolidColorBrush x:Key="ColorInputFoco"    Color="#080A08"/>

    <!-- CheckBox días (DiaCheckEstilo) -->
    <SolidColorBrush x:Key="DiaFondoNormal"         Color="#111811"/>
    <SolidColorBrush x:Key="DiaFondoSeleccionado"   Color="#162016"/>
    <SolidColorBrush x:Key="DiaTextoSeleccionado"   Color="#4ADE80"/>

    <!-- Editor acción Cyan -->
    <SolidColorBrush x:Key="ColorEditarCyan"    Color="#00CFFF"/>

    <!-- Estados / Semántica -->
    <SolidColorBrush x:Key="ColorExito"         Color="#4ADE80"/>
    <SolidColorBrush x:Key="ColorError"         Color="#C44040"/>
    <SolidColorBrush x:Key="ColorAdvertencia"   Color="#D4830A"/>
    <SolidColorBrush x:Key="ColorInfo"          Color="#3A8FD4"/>

    <!-- Colores sólidos (para code-behind) -->
    <Color x:Key="ColorNaranjaColor"            >#6BE8A0</Color>
    <Color x:Key="ColorNaranjaOscuroColor"      >#3A8C3A</Color>
    <Color x:Key="ColorCyanColor"               >#4ADE80</Color>
    <Color x:Key="ColorVioletaColor"            >#4ADE80</Color>
    <Color x:Key="ColorActiva"                  >#4ADE80</Color>
    <Color x:Key="ColorVencida"                 >#C44040</Color>
    <Color x:Key="ColorPorVencer"               >#D4830A</Color>

    <!-- Badge — pill shape -->
    <SolidColorBrush x:Key="BadgeActivaFondo"   Color="#162016"/>
    <SolidColorBrush x:Key="BadgeActivaTexto"   Color="#4ADE80"/>
    <SolidColorBrush x:Key="BadgeActivaBorde"   Color="#2A4020"/>

    <SolidColorBrush x:Key="BadgePorVencerFondo" Color="#1A1500"/>
    <SolidColorBrush x:Key="BadgePorVencerTexto" Color="#D4830A"/>
    <SolidColorBrush x:Key="BadgePorVencerBorde" Color="#3A2E00"/>

    <SolidColorBrush x:Key="BadgeCanceladaFondo" Color="#1A1010"/>
    <SolidColorBrush x:Key="BadgeCanceladaTexto" Color="#C44040"/>
    <SolidColorBrush x:Key="BadgeCanceladaBorde" Color="#3A1515"/>

    <SolidColorBrush x:Key="BadgeVerdeFondo"   Color="#162016"/>
    <SolidColorBrush x:Key="BadgeVerdeBorde"   Color="#2A4020"/>
    <SolidColorBrush x:Key="BadgeVerdeHover"   Color="#1E281E"/>

    <SolidColorBrush x:Key="BadgeAmbarFondo"    Color="#1A1500"/>
    <SolidColorBrush x:Key="BadgeAmbarBorde"    Color="#3A2E00"/>
    <SolidColorBrush x:Key="BadgeAmbarHover"    Color="#2A1F00"/>

    <SolidColorBrush x:Key="BadgeRojoFondo"     Color="#1A1010"/>
    <SolidColorBrush x:Key="BadgeRojoBorde"     Color="#3A1515"/>
    <SolidColorBrush x:Key="BadgeRojoHover"     Color="#2A1010"/>

    <SolidColorBrush x:Key="BrushActivaFondo"   Color="#162016"/>
    <SolidColorBrush x:Key="BrushActivaTexto"   Color="#4ADE80"/>

    <SolidColorBrush x:Key="BrushPorVencerFondo" Color="#1A1500"/>
    <SolidColorBrush x:Key="BrushPorVencerTexto" Color="#D4830A"/>

    <SolidColorBrush x:Key="BrushVencidaFondo"   Color="#1A1010"/>
    <SolidColorBrush x:Key="BrushVencidaTexto"   Color="#C44040"/>

    <!-- ═══════════════════════════════════════════════════════════
         TIPOGRAFÍA
         NOTA: LetterSpacing NO existe en WPF → no se usa
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="TituloEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="FontSize"   Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SubtituloEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="Margin"     Value="0,0,0,16"/>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         INPUT TextBox
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="InputEstilo" TargetType="{x:Type TextBox}">
        <Setter Property="Height"                   Value="40"/>
        <Setter Property="Background"               Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource ColorBorde}"/>
        <Setter Property="Foreground"               Value="{StaticResource ColorCuerpo}"/>
        <Setter Property="CaretBrush"               Value="{StaticResource ColorPrimario}"/>
        <Setter Property="SelectionBrush"           Value="#337AC943"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                  Value="12,8"/>
        <Setter Property="Margin"                   Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG -->
    <!-- ═══════════════════════════════════════════════════════════
     DataPiker TextBox OSCURO
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════════════════
     DATEPICKER OSCURO — OPTIMUS CAI
═══════════════════════════════════════════════════════════ -->

    <Style x:Key="DatePickerInputInternoEstilo" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CaretBrush" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="ReadOnly"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Margin="4,0"
                                  Height="19"
                                  FontSize="14"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarDayButtonStyleCustom" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid>
                        <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="1"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorFondo}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid>
                        <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="0"
                            Margin="2"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorFondo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarItemEstiloLimpio" TargetType="{x:Type CalendarItem}">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="CalendarioDark" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButtonStyleCustom}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarItemEstiloLimpio}"/>
    </Style>

    <Style x:Key="DatePickerEstilo" TargetType="{x:Type DatePicker}">
        <Setter Property="CalendarStyle" Value="{DynamicResource CalendarioDark}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Border x:Name="borde"
                        Background="{StaticResource ColorInput}"
                        BorderBrush="{StaticResource ColorBorde}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Height="40">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Style="{StaticResource DatePickerInputInternoEstilo}"
                                           Focusable="{TemplateBinding Focusable}"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Center"/>

                            <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Focusable="False"
                                Background="Transparent"
                                BorderThickness="0"
                                    Height="25"
                                    
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBg"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBg" Property="Background"
                                                    Value="{StaticResource ColorInputHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <fa:ImageAwesome Icon="Calendar"
                                             Foreground="{StaticResource ColorTextoPrincipal}"
                                             Height="16" Width="16"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                            </Button>

                            <Popup x:Name="PART_Popup"
       PopupAnimation="Fade"
       Placement="Bottom"
       PlacementTarget="{Binding ElementName=borde}"
       StaysOpen="False"
       AllowsTransparency="True">
                                <Border Background="Transparent" Padding="0">
                                    <Calendar x:Name="PART_Calendar"
                   Style="{StaticResource CalendarioDark}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- PasswordBox — misma estructura, sin DropShadowEffect en triggers -->
    <Style x:Key="PasswordEstilo" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="46"/>
        <Setter Property="Background"               Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource ColorBorde}"/>
        <Setter Property="Foreground"               Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin"                   Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
     Estilo ComboBox
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 2. ESTILO PARA EL COMBOBOX (EL CONTENEDOR) -->
    <Style x:Key="ComboBoxEstilo" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- El ToggleButton abarca todo el control para que sea cliqueable en cualquier parte -->
                        <ToggleButton x:Name="toggleButton"
                                  Grid.ColumnSpan="2"
                                  Focusable="False"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="borde"
                                        Background="{StaticResource ColorInput}"
                                        BorderBrush="{StaticResource ColorBorde}"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="arrow"
                                              Grid.Column="1"
                                              Data="M0,0 L4,4 L8,0 Z"
                                              Fill="{StaticResource ColorTextoPrincipal}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                            <Setter TargetName="borde" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Presentador del texto seleccionado (No interfiere con el clic) -->
                        <ContentPresenter x:Name="contentPresenter"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Margin="14,0,30,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                        <Popup x:Name="PART_Popup"
       AllowsTransparency="True"
       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
       Placement="Bottom"
       PopupAnimation="Fade">
                            <Border x:Name="popupBorde"
             Background="{StaticResource Bg2}"
             BorderBrush="{StaticResource ColorBorde}"
             BorderThickness="1"
             CornerRadius="8"
             Margin="0,2,0,0"
             MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8">
                                        <RectangleGeometry.Rect>
                                            <MultiBinding Converter="{StaticResource WidthHeightToRectConverter}">
                                                <Binding ElementName="popupBorde" Path="ActualWidth"/>
                                                <Binding ElementName="popupBorde" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Border.Clip>

                                <ScrollViewer MaxHeight="300" 
                      Style="{StaticResource PanelScrollViewerStyle}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>

                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
     Estilo ComboBoxItem
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 1. ESTILO PARA LOS ÍTEMS (LAS OPCIONES) -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="gd" Background="{TemplateBinding Background}" 
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- HOVER: Fondo cian y texto oscuro para legibilidad -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bg0}"/>
                        </Trigger>
                        <!-- SELECCIONADO: Resaltado sutil -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="#337AC943"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Cambios de JoakoG-->
    <!-- Estilos para los botones de filtro en SociosPage -->
    <Style x:Key="ChipFiltroEstilo" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bordeChip"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
                        <ContentPresenter x:Name="content"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- HOVER: Usando el mismo color que el DataPicker -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bordeChip" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>

                        <!-- EFECTO CLIC: Un poco más oscuro para feedback -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bordeChip" Property="Background" Value="{StaticResource ColorBorde}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

