<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:fa="http://schemas.fontawesome.io/icons/"

                    >
    

    <!-- ═══════════════════════════════════════════════════════════
         PALETA OSCURA — SISTEMA GIMNASIO OPTIMUS CAI
         REGLA: todos los colores definidos ANTES de usarlos
    ═══════════════════════════════════════════════════════════ -->

    <!-- Fondos -->
    <SolidColorBrush x:Key="ColorFondo"         Color="#0A0A14"/>
    <SolidColorBrush x:Key="ColorCard"          Color="#12121E"/>
    <SolidColorBrush x:Key="ColorCardAlta"      Color="#1A1A2E"/>
    <SolidColorBrush x:Key="ColorBorde"         Color="#252540"/>
    <SolidColorBrush x:Key="ColorBordeAlto"     Color="#3A3A60"/>

    <!-- Keys de compatibilidad con páginas existentes -->
    <SolidColorBrush x:Key="ColorOscuroFondo"   Color="#0A0A14"/>
    <SolidColorBrush x:Key="ColorBlanco"        Color="#12121E"/>
    <SolidColorBrush x:Key="ColorInputFondo"    Color="#0D0D1A"/>

    <!-- Primario: cyan eléctrico -->
    <SolidColorBrush x:Key="ColorPrimario"      Color="#00CFFF"/>
    <SolidColorBrush x:Key="ColorPrimarioHover" Color="#00AADD"/>

    <!-- Acento: naranja energía -->
    <SolidColorBrush x:Key="ColorNaranja"       Color="#FF6B35"/>
    <SolidColorBrush x:Key="ColorNaranjaHover"  Color="#E85520"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="ColorTextoPrincipal"  Color="#E8E8FF"/>
    <SolidColorBrush x:Key="ColorTextoSecundario" Color="#6A6A9A"/>
    <SolidColorBrush x:Key="ColorVioleta" Color="#A78BFA" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="ColorInput"         Color="#16162A"/>
    <SolidColorBrush x:Key="ColorInputHover"    Color="#1E1E38"/>
    <SolidColorBrush x:Key="ColorInputFoco"     Color="#111126"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="ColorExito"         Color="#00E676"/>
    <SolidColorBrush x:Key="ColorError"         Color="#FF4444"/>
    <SolidColorBrush x:Key="ColorAdvertencia"   Color="#FFA726"/>

    <!-- Colores sólidos para degradados definidos en code/page -->
    <Color x:Key="ColorNaranjaColor"            >#FF6B35</Color>
    <Color x:Key="ColorNaranjaOscuroColor"      >#FF3D1F</Color>
    <Color x:Key="ColorCyanColor"               >#00CFFF</Color>
    <Color x:Key="ColorVioletaColor"            >#A78BFA</Color>


    <!-- ═══════════════════════════════════════════════════════════
         TIPOGRAFÍA
         NOTA: LetterSpacing NO existe en WPF → no se usa
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="TituloEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="FontSize"   Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SubtituloEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="Margin"     Value="0,0,0,16"/>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         INPUT TextBox OSCURO
         FIX: DropShadowEffect NO se puede targetear en Triggers.
         Usamos cambio de BorderBrush y BorderThickness en su lugar.
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="InputEstilo" TargetType="{x:Type TextBox}">
        <Setter Property="Height"                   Value="46"/>
        <Setter Property="Background"               Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource ColorBorde}"/>
        <Setter Property="Foreground"               Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="CaretBrush"               Value="{StaticResource ColorPrimario}"/>
        <Setter Property="SelectionBrush"           Value="#3300CFFF"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="Margin"                   Value="0,0,0,20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- x:Name="borde" → sí se puede targetear porque es FrameworkElement -->
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG -->
    <!-- ═══════════════════════════════════════════════════════════
     DataPiker TextBox OSCURO
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 1. Estilo para el cuadro de texto interno del DatePicker (DatePickerTextBox) -->
    <!-- Es necesario para quitar los bordes blancos por defecto y poner el cursor cian -->
    <Style x:Key="DatePickerInputInternoEstilo" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- ESTO HACE LA BARRITA CIAN -->
        <Setter Property="CaretBrush" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <!-- Usamos un Grid simple para evitar Chrome (bordes) del sistema -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="ReadOnly"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ScrollViewer x:Name="PART_ContentHost" 
                                  Focusable="False" 
                                  Margin="4, 0"
                                  Height="19"
                                  FontSize="14"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2. Estilo principal para el DatePicker -->
    <Style x:Key="DatePickerEstilo" TargetType="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <!-- Contenedor visual principal con bordes redondeados -->
                    <Border x:Name="borde"
                        Background="{StaticResource ColorInput}"
                        BorderBrush="{StaticResource ColorBorde}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Height="46">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Usamos el estilo que creamos arriba para el texto interno -->
                            <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Style="{StaticResource DatePickerInputInternoEstilo}"
                                           Focusable="{TemplateBinding Focusable}"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Center"/>

                            <!-- Botón del calendario -->
                            <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False">
                                <!-- Ícono de calendario que combina con el texto -->
                                <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.9 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z" 
                                  Fill="{StaticResource ColorTextoPrincipal}" 
                                  Stretch="Uniform" Height="18" Width="18"/>
                            </Button>

                            <!-- Pop-up del calendario (no tocamos su estilo por ahora) -->
                            <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=bordeOuter}"
                               StaysOpen="False"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 1. HOVER (Igual que tu TextBox) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>

                        <!-- 2. FOCUS (Gana al Hover por estar debajo) -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox — misma estructura, sin DropShadowEffect en triggers -->
    <Style x:Key="PasswordEstilo" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="46"/>
        <Setter Property="Background"               Value="{StaticResource ColorInput}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource ColorBorde}"/>
        <Setter Property="Foreground"               Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin"                   Value="0,0,0,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputHover}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorBordeAlto}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorInputFoco}"/>
                            <Setter TargetName="borde" Property="BorderBrush"
                                    Value="{StaticResource ColorPrimario}"/>
                            <Setter TargetName="borde" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
     Estilo ComboBox
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 2. ESTILO PARA EL COMBOBOX (EL CONTENEDOR) -->
    <Style x:Key="ComboBoxEstilo" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- El ToggleButton abarca todo el control para que sea cliqueable en cualquier parte -->
                        <ToggleButton x:Name="toggleButton"
                                  Grid.ColumnSpan="2"
                                  Focusable="False"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="borde"
                                        Background="{StaticResource ColorInput}"
                                        BorderBrush="{StaticResource ColorBorde}"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="arrow"
                                              Grid.Column="1"
                                              Data="M0,0 L4,4 L8,0 Z"
                                              Fill="{StaticResource ColorTextoPrincipal}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorBordeAlto}"/>
                                            <Setter TargetName="borde" Property="Background" Value="{StaticResource ColorInputHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                            <Setter TargetName="borde" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Presentador del texto seleccionado (No interfiere con el clic) -->
                        <ContentPresenter x:Name="contentPresenter"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Margin="14,0,30,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                        <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           PopupAnimation="Fade">
                            <Border Background="#16162A"
                                BorderBrush="{StaticResource ColorBorde}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,2,0,0"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="300">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
     Estilo ComboBoxItem
     FEAT: Borro los estilos por defecto del DataPiker y defino
     unos estilos personalizados para mantener la consistencia del diseño original.
═══════════════════════════════════════════════════════════ -->
    <!-- 1. ESTILO PARA LOS ÍTEMS (LAS OPCIONES) -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="gd" Background="{TemplateBinding Background}" 
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- HOVER: Fondo cian y texto oscuro para legibilidad -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="#16162A"/>
                        </Trigger>
                        <!-- SELECCIONADO: Resaltado sutil -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="gd" Property="Background" Value="#3300CFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG-->

    <!-- Cambios de JoakoG -->
    <!-- Estilos para los botones de filtro en SociosPage -->
    <Style x:Key="ChipFiltroEstilo" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bordeChip"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
                        <ContentPresenter x:Name="content"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- HOVER: Usando el mismo color que el DataPicker -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bordeChip" Property="Background" Value="{StaticResource ColorInputHover}"/>
                        </Trigger>

                        <!-- EFECTO CLIC: Un poco más oscuro para feedback -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bordeChip" Property="Background" Value="{StaticResource ColorBorde}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG -->


    <!-- ═══════════════════════════════════════════════════════════
         BOTONES
         FIX: Sin DropShadowEffect en triggers (no es targeteable).
         Los efectos de sombra van en el XAML de cada página con
         <Button.Effect> fuera del template.
    ═══════════════════════════════════════════════════════════ -->

    <!-- Botón Primario: cyan -->
    <Style x:Key="BotonPrincipalEstilo" TargetType="Button">
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Background"      Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground"      Value="#0A0A14"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="FontFamily"      Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="20,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"
                                    Value="{StaticResource ColorPrimarioHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.82"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón Naranja (acción positiva / nuevo) -->
    <Style x:Key="BotonNaranjaEstilo" TargetType="Button">
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="FontFamily"      Value="Bahnschrift SemiBold, Segoe UI"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde" CornerRadius="10">
                        <!-- Degradado inline: no referencia recursos → no puede fallar -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#FF3D1F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="20,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón Cancelar / Cerrar -->
    <Style x:Key="BotonCerrarEstilo" TargetType="Button">
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ColorBorde}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"   Value="#2A0A0A"/>
                            <Setter TargetName="borde" Property="BorderBrush"  Value="{StaticResource ColorError}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorError}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID — totalmente oscuro
    ═══════════════════════════════════════════════════════════ -->

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="FontFamily"                 Value="Segoe UI Semibold, Segoe UI"/>
        <Setter Property="FontSize"                   Value="11"/>
        <Setter Property="FontWeight"                 Value="Bold"/>
        <Setter Property="Padding"                    Value="14,14,14,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness"            Value="0,0,0,1"/>
        <Setter Property="BorderBrush"                Value="{StaticResource ColorBorde}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"      Value="{StaticResource ColorTextoPrincipal}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" BorderThickness="0" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin"          Value="0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1A1A35"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1A2545"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         MENÚ LATERAL / SIDEBAR
    ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="AnimatedSidebarStyle" TargetType="Border">
        <Setter Property="Background"        Value="#080812"/>
        <Setter Property="Width"             Value="65"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderBrush"       Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness"   Value="0,0,1,0"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                         To="220" Duration="0:0:0.22"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                         To="65" Duration="0:0:0.18"
                                         AccelerationRatio="0.4"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="#8080B0"/>
        <Setter Property="Height"                     Value="52"/>
        <Setter Property="FontSize"                   Value="14"/>
        <Setter Property="FontFamily"                 Value="Segoe UI"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo" Background="{TemplateBinding Background}"
                            BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="indicador" Grid.Column="0"
                                    HorizontalAlignment="Left" Width="3"
                                    Background="Transparent" CornerRadius="0,2,2,0"/>
                            <ContentPresenter Grid.Column="0" Grid.ColumnSpan="2"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo"     Property="Background" Value="#12122A"/>
                            <Setter Property="Foreground"  Value="#E0E0FF"/>
                            <Setter TargetName="indicador" Property="Background"
                                    Value="{StaticResource ColorPrimario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="15,0,0,0"/>
        <Setter Property="Visibility"        Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType=Border, AncestorLevel=2}}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconoVectorStyle" TargetType="Path">
        <Setter Property="Width"   Value="20"/>
        <Setter Property="Height"  Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin"  Value="20,0,0,0"/>
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <!-- Botones barra de título -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#8080B0"/>
        <Setter Property="Width"           Value="45"/>
        <Setter Property="Height"          Value="35"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="#1E1E38"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#8B0000"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Cambios de JoakoG -->

    <!-- ESTILO PARA LOS BOTONES -->
    <Style x:Key="TabBtnEstilo" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#6A6A9A"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <!-- Importante: Ponemos el borde en 0 para que el botón no dibuje su propia línea -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="16,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#E8E8FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#00CFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ESTILO PARA LA BARRA DESLIZANTE (Aquí vive el diseño neón) -->
    <Style x:Key="BarraNeonEstilo" TargetType="Border">
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <!-- Esto le da el aire abajo del texto -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00CFFF" Offset="0"/>
                    <GradientStop Color="#A78BFA" Offset="0.5"/>
                    <GradientStop Color="#FF6B35" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <!-- El resplandor que tanto nos gusta -->
                <DropShadowEffect Color="#00CFFF" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cambios de JoakoG-->

    <!--
    ════════════════════════════════════════════════════════════
    SNIPPET PARA AGREGAR A MiDiccionario.xaml

    Pegá este Style ANTES del </ResourceDictionary> de cierre
    en tu archivo MiDiccionario.xaml. Es el chip de filtro
    reutilizable, así no tenés que duplicar el código en cada
    página (Socios, Actividades, Membresías, etc.)
    ════════════════════════════════════════════════════════════
-->

    <!-- Chip de filtro (Todos / Activos / Inactivos / etc.) -->
    <Style x:Key="BotonChipEstilo" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#6A6A9A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="#252540"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="14,6"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="#16162A"/>
                            <Setter Property="Foreground" Value="#E8E8FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ********************************* -->
    <!-- Cambios de JoakoG -->
    <!-- Estilo Base para los Botones de Acción -->
    <Style x:Key="ButtonStyleAccionBase" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#0D0D1F"/>
        <Setter Property="BorderBrush" Value="#252540"/>
        <!-- Color de borde por defecto -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Usamos TemplateBinding para que el Border responda a las propiedades del Button -->
                    <Border x:Name="InternalBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Trigger de iluminación general al pasar el mouse -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InternalBorder" Property="Background" Value="#1A1A35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para BOTÓN EDITAR -->
    <Style x:Key="ButtonStyleEditar" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#00CFFF"/>
                <!-- Iluminación Azul -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para BOTÓN ESTADO -->
    <Style x:Key="ButtonStyleEstado" BasedOn="{StaticResource ButtonStyleAccionBase}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#FF5555"/>
                <!-- Iluminación Roja -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===========================================================
     ESTILOS DE LOS INDICADORES (KPIs)
     Usando la paleta oficial de Optimus CAI
     =========================================================== -->

    <!-- Estilo base para el contenedor de la tarjeta -->
    <Style x:Key="KpiCardBorderStyle" TargetType="Border">
        <!-- Usa tu color de tarjeta oscuro -->
        <Setter Property="Background" Value="{StaticResource ColorCard}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <!-- Usa tu color de borde definido -->
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para el texto de descripción (debajo del número) -->
    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Usa tu color de texto secundario (grisáceo) -->
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
    </Style>

    <!-- Estilo para el número grande -->
    <Style x:Key="KpiNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <!-- El color se define por instancia (Cyan, Éxito, Naranja, etc.) -->
    </Style>

    <!-- Estilo para el icono decorativo de fondo -->
    <Style x:Key="KpiIconStyle" TargetType="fa:ImageAwesome">
        <Setter Property="Opacity" Value="0.1"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- ===========================================================
ESTILOS PARA EL SCROLL DEL COSTADO
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <!-- Estilo para el "Thumb" (la parte que se desliza) -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Usamos ColorBordeAlto para que resalte un poco sobre el fondo -->
                    <Border Background="{StaticResource ColorBorde}" 
                        CornerRadius="4" 
                        Margin="8,0,0,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo General de la ScrollBar -->
    <Style x:Key="ModernScrollStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <!-- El carril de fondo -->
                        <Border Background="Transparent" CornerRadius="4"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    
    <!-- Estilo para aplicar automáticamente a cualquier ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>

                        <!-- Aquí aplicamos nuestra ScrollBar personalizada -->
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Column="1"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                               Style="{StaticResource ModernScrollStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===========================================================
ESTILOS PARA EL BADGE DE ROL DEL DATAGRID USUARIOS
Usando la paleta oficial de Optimus CAI
=========================================================== -->

    <Style x:Key="RolBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Background" Value="#1E1840"/>
        <Setter Property="BorderBrush" Value="#4C3A8E"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding RolNombre}" Value="admin">
                <Setter Property="Background" Value="#2A1600"/>
                <Setter Property="BorderBrush" Value="#85451A"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Background" Value="#2D2460"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RolNombre}" Value="admin"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#402200"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RolTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Text" Value="Instructor"/>
        <Setter Property="Foreground" Value="{StaticResource ColorVioleta}"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding RolNombre}" Value="admin">
                <Setter Property="Text" Value="ADMIN"/>
                <Setter Property="Foreground" Value="{StaticResource ColorNaranja}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===========================================================
ESTILOS PARA EL BUSCADOR PARA QUE EL PLACEHOLDER DESAPAREZCA DESPACIO
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <Style x:Key="BuscadorStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#16162A"/>
        <Setter Property="Foreground" Value="#E8E8FF"/>
        <Setter Property="BorderBrush" Value="#252540"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <fa:ImageAwesome Icon="Search" Foreground="Gray" Height="16" Width="16" Grid.Column="0"/>

                            <Grid Grid.Column="1">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>

                                <TextBlock x:Name="PlaceholderText" 
                                       Text="Buscar por nombre, apellido o DNI..."
                                       Foreground="#3A3A5C"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===========================================================
ESTILOS PARA BADGE DE ESTADO DEL DATAGRID
Usando la paleta oficial de Optimus CAI
=========================================================== -->
    <Style x:Key="EstadoBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Background" Value="#2A0A0A"/>
        <Setter Property="BorderBrush" Value="#551515"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Background" Value="#0A2A14"/>
                <Setter Property="BorderBrush" Value="#15552A"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstadoDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>

        <Setter Property="Fill" Value="#FF4444"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Fill" Value="#00E676"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstadoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Text" Value="Inactivo"/>
        <Setter Property="Foreground" Value="#FF6666"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Activo}" Value="True">
                <Setter Property="Text" Value="Activo"/>
                <Setter Property="Foreground" Value="#00E676"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
