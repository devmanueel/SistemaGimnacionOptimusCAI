    <Style x:Key="TipoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorVioleta}"/>
    </Style>

    <Style x:Key="SociosBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
        <Setter Property="Background" Value="{StaticResource BadgeCyanFondo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BadgeCyanBorde}"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Background" Value="{StaticResource BadgeCyanHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SociosTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
