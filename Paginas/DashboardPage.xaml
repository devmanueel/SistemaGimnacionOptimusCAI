<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1360"
      Title="Tablero Principal"
      Background="#080A08">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0"
                        Background="{StaticResource GreenMain}"/>
                <StackPanel>
                    <TextBlock Text="TABLERO PRINCIPAL"
                               Style="{StaticResource TopbarTituloStyle}"
                               FontSize="19"/>
                    <TextBlock x:Name="lblFechaHoy"
                               Style="{StaticResource TopbarSubtituloStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Saludo al usuario -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="lblSaludo"
                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource Bg2}"
                        BorderBrush="{StaticResource Border1}" BorderThickness="1">
                    <TextBlock x:Name="lblIniciales"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource GreenMain}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ INPUT ASISTENCIA ══════════════════ -->
        <Border Grid.Row="1" Margin="0,0,0,20"
                Style="{StaticResource DashboardCardStyle}">
            <Grid>
                <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        Height="2" CornerRadius="2,2,0,0" Margin="-18,-16,-18,0"
                        Background="{StaticResource GreenMain}"/>
                <Grid Margin="0,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icono -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardIconCircleStyle}"
                            Background="#0A1A2A" Margin="0,0,16,0">
                        <fa:ImageAwesome Icon="IdCard" Foreground="{StaticResource GreenMain}"
                                         Height="22" Width="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>

                    <!-- TextBox DNI -->
                    <TextBox x:Name="txtDni" Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource InputEstilo}"
                             Height="48" FontSize="18"
                             FontFamily="Consolas, Courier New"
                             VerticalContentAlignment="Center"
                             MaxLength="8"
                             PreviewKeyDown="txtDni_PreviewKeyDown"/>

                    <!-- Boton Validar -->
                    <Button x:Name="btnValidar" Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource BotonPrincipalEstilo}"
                            Height="48" Width="140"
                            FontSize="13" FontWeight="Bold"
                            Content="► VALIDAR"
                            Margin="12,0,0,0"
                            Click="btnValidar_Click"/>

                    <!-- Estado del lector de huellas -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="0,10,0,0">
                        <fa:ImageAwesome x:Name="iconHuellaDash" Icon="HandPaperOutline"
                                         Height="13" Width="13" Margin="0,0,8,0"
                                         Foreground="{StaticResource TextSecondary}"
                                         VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblHuellaEstado"
                                   Text="Iniciando lector de huellas..."
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════ CONTENIDO PRINCIPAL ══════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── PANEL RESULTADO ASISTENCIA (reemplaza calendario) ── -->
            <Border Grid.Column="0" Margin="0,0,14,0"
                    Style="{StaticResource DashboardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource GreenMain}"/>

                    <StackPanel Grid.Row="1" Margin="20,14,20,10"
                                Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardPanelHeaderIconStyle}"
                                Background="#0A1A2A">
                            <fa:ImageAwesome Icon="CheckCircle" Foreground="{StaticResource GreenMain}"
                                             Height="14" Width="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RESULTADO DE ASISTENCIA"
                                   Style="{StaticResource DashboardPanelHeaderTextStyle}"/>
                    </StackPanel>

                    <!-- Panel de resultado -->
                    <Grid Grid.Row="2" Margin="16,0,16,16" VerticalAlignment="Top">
                        <Grid x:Name="panelResultado" Visibility="Collapsed">
                            <Border x:Name="borderResultado"
                                    CornerRadius="12" Padding="24,20"
                                    BorderThickness="1">
                                <StackPanel>
                                    <!-- Foto + Nombre -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Grid Margin="0,0,16,0">
                                            <Ellipse Width="64" Height="64">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#4ADE80"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="58" Height="58">
                                                <Ellipse.Fill>
                                                    <ImageBrush x:Name="imgFotoResultado"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="lblResultadoNombre"
                                                       Text="—"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock x:Name="lblResultadoTipo"
                                                       Text="—"
                                                       FontSize="12" Foreground="{StaticResource GreenMain}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Mensaje principal -->
                                    <TextBlock x:Name="lblResultadoMensaje"
                                               Text="—"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <!-- Info de membresia (socio) -->
                                    <StackPanel x:Name="panelInfoMembresia" Visibility="Collapsed">
                                        <Border Height="1" Background="#33FFFFFF" Margin="0,4,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Plan: "
                                                       FontSize="11" Foreground="#AAAACC"/>
                                            <TextBlock Grid.Column="1" x:Name="lblResultadoActividad"
                                                       Text="—" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Vence: "
                                                       FontSize="11" Foreground="#AAAACC"/>
                                            <TextBlock Grid.Column="1" x:Name="lblResultadoVencimiento"
                                                       Text="—" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Asistencias restantes: "
                                                       FontSize="11" Foreground="#AAAACC"/>
                                            <TextBlock Grid.Column="1" x:Name="lblResultadoAsistencias"
                                                       Text="—" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Info de fichaje (instructor) -->
                                    <StackPanel x:Name="panelInfoFichaje" Visibility="Collapsed">
                                        <Border Height="1" Background="#33FFFFFF" Margin="0,4,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Operacion: "
                                                       FontSize="11" Foreground="#AAAACC"/>
                                            <TextBlock Grid.Column="1" x:Name="lblResultadoOperacion"
                                                       Text="—" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Hora: "
                                                       FontSize="11" Foreground="#AAAACC"/>
                                            <TextBlock Grid.Column="1" x:Name="lblResultadoHora"
                                                       Text="—" FontSize="11"
                                                       FontFamily="Consolas" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Horas trabajadas: "
                                                       FontSize="11" Foreground="#AAAACC"/>
                                            <TextBlock Grid.Column="1" x:Name="lblResultadoHoras"
                                                       Text="—" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Placeholder cuando no hay resultado -->
                        <TextBlock x:Name="lblPlaceholder"
                                   Text="Ingrese un DNI para registrar asistencia"
                                   FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── PANEL DERECHO ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="205"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── PROXIMOS VENCIMIENTOS ── -->
                <Border Grid.Row="0" Style="{StaticResource DashboardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DashboardPanelTopBarStyle}"
                                Background="#D4830A"/>

                        <StackPanel Grid.Row="1" Margin="16,12,16,8"
                                    Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardPanelHeaderIconStyle}"
                                    Background="#1E1600">
                                <fa:ImageAwesome Icon="ClockOutline" Foreground="#D4830A"
                                                 Height="14" Width="14"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PROXIMOS VENCIMIENTOS"
                                       Style="{StaticResource DashboardPanelHeaderTextStyle}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="12,0,12,10"
                                      Style="{StaticResource PanelScrollViewerStyle}">
                            <StackPanel x:Name="panelVencimientos">
                                <TextBlock Text="Cargando..."
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           Margin="4,8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ── ACCESOS RAPIDOS ── -->
                <Border Grid.Row="2" Style="{StaticResource DashboardPanelStyle}"
                        MinHeight="170">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DashboardPanelTopBarStyle}"
                                Background="{StaticResource GreenMain}"/>

                        <StackPanel Grid.Row="1" Margin="16,12,16,8"
                                    Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardPanelHeaderIconStyle}"
                                    Background="#1E1840">
                                <fa:ImageAwesome Icon="Flash" Foreground="{StaticResource GreenMain}"
                                                 Height="14" Width="14"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ACCESOS RAPIDOS"
                                       Style="{StaticResource DashboardPanelHeaderTextStyle}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="2" Rows="2" Columns="2"
                                     Margin="12,0,12,10"
                                     VerticalAlignment="Top">

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoSocio"
                                    Click="btnRapidoSocio_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="UserPlus" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nuevo Socio" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoAsistencia"
                                    Click="btnRapidoAsistencia_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="CheckSquareOutline" Foreground="#D4830A"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Asistencia" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoVenta"
                                    Click="btnRapidoVenta_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="ShoppingBasket" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nueva Venta" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoReporte"
                                    Click="btnRapidoReporte_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="BarChart" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ver Reportes" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
