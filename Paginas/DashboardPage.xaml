<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
       Title="Dashboard"
       Background="#080A08">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0"
                        Background="{StaticResource GreenMain}"/>
                <StackPanel>
                    <TextBlock Text="TABLERO PRINCIPAL"
                               Style="{StaticResource TopbarTituloStyle}"
                               FontSize="19"/>
                    <TextBlock x:Name="lblFechaHoy"
                               Style="{StaticResource TopbarSubtituloStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Saludo al usuario -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="lblSaludo"
                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource Bg2}"
                        BorderBrush="{StaticResource Border1}" BorderThickness="1">
                    <TextBlock x:Name="lblIniciales"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource GreenMain}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ CARDS KPI ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Socios Activos -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Height="2" CornerRadius="2,2,0,0" Margin="-18,-16,-18,0"
                            Background="{StaticResource GreenMain}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="statSociosActivos" Text="0"
                                       Style="{StaticResource DashboardKpiNumeroStyle}"/>
                            <TextBlock Text="SOCIOS ACTIVOS"
                                       Style="{StaticResource DashboardKpiEtiquetaStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DashboardIconCircleStyle}"
                                Background="#0A1A2A">
                            <fa:ImageAwesome Icon="Users" Foreground="{StaticResource GreenMain}"
                                             Height="20" Width="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: Membresias Activas -->
            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Height="2" CornerRadius="2,2,0,0" Margin="-18,-16,-18,0"
                            Background="#3A8FD4"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="statMembresiasActivas" Text="0"
                                       Style="{StaticResource DashboardKpiNumeroStyle}"/>
                            <TextBlock Text="MEMBRESIAS ACTIVAS"
                                       Style="{StaticResource DashboardKpiEtiquetaStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DashboardIconCircleStyle}"
                                Background="#1E1840">
                            <fa:ImageAwesome Icon="IdCardOutline" Foreground="{StaticResource GreenMain}"
                                             Height="20" Width="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 3: Ingresos del Mes -->
            <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Height="2" CornerRadius="2,2,0,0" Margin="-18,-16,-18,0"
                            Background="#D4830A"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="statIngresosMes" Text="$0"
                                       FontSize="24" FontWeight="ExtraBold"
                                       Foreground="#00E676"/>
                            <TextBlock Text="INGRESOS DEL MES"
                                       Style="{StaticResource DashboardKpiEtiquetaStyle}"/>
                            <TextBlock x:Name="statBalanceMes" Text="Balance: $0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A0C070"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DashboardIconCircleStyle}"
                                Background="#0A2A14">
                            <fa:ImageAwesome Icon="Money" Foreground="#00E676"
                                             Height="20" Width="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 4: Asistencias Hoy -->
            <Border Grid.Column="6" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Height="2" CornerRadius="2,2,0,0" Margin="-18,-16,-18,0"
                            Background="{StaticResource ColorError}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="statAsistenciasHoy" Text="0"
                                       Style="{StaticResource DashboardKpiNumeroStyle}"
                                       Foreground="#D4830A"/>
                            <TextBlock Text="ASISTENCIAS HOY"
                                       Style="{StaticResource DashboardKpiEtiquetaStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DashboardIconCircleStyle}"
                                Background="#1E1600">
                            <fa:ImageAwesome Icon="CheckSquareOutline" Foreground="#D4830A"
                                             Height="20" Width="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ CONTENIDO PRINCIPAL ══════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── CALENDARIO ── -->
            <Border Grid.Column="0" Margin="0,0,14,0"
                    Style="{StaticResource DashboardPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource GreenMain}"/>

                    <Grid Grid.Row="1" Margin="20,16,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32"
                                CornerRadius="8" Background="{StaticResource Bg2}"
                                BorderBrush="{StaticResource Border1}" BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="❮" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="lblMesAnio" Grid.Column="1"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Border Grid.Column="2" Width="32" Height="32"
                                CornerRadius="8" Background="{StaticResource Bg2}"
                                BorderBrush="{StaticResource Border1}" BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="❯" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,8">
                            <TextBlock Text="LUN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Padding="0,4"/>
                            <TextBlock Text="MAR" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Padding="0,4"/>
                            <TextBlock Text="MIE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Padding="0,4"/>
                            <TextBlock Text="JUE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Padding="0,4"/>
                            <TextBlock Text="VIE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Padding="0,4"/>
                            <TextBlock Text="SAB" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Padding="0,4"/>
                            <TextBlock Text="DOM" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource ColorError}" HorizontalAlignment="Center" Padding="0,4"/>
                        </UniformGrid>

                        <UniformGrid x:Name="gridCalendario" Grid.Row="1"
                                     Rows="6" Columns="7"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── PANEL DERECHO ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── PRÓXIMOS VENCIMIENTOS ── -->
                <Border Grid.Row="0" Style="{StaticResource DashboardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DashboardPanelTopBarStyle}"
                                Background="#D4830A"/>

                        <StackPanel Grid.Row="1" Margin="16,14,16,10"
                                    Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardPanelHeaderIconStyle}"
                                    Background="#1E1600">
                                <fa:ImageAwesome Icon="ClockOutline" Foreground="#D4830A"
                                                 Height="14" Width="14"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PROXIMOS VENCIMIENTOS"
                                       Style="{StaticResource DashboardPanelHeaderTextStyle}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="12,0,12,12"
                                      Style="{StaticResource PanelScrollViewerStyle}">
                            <StackPanel x:Name="panelVencimientos">
                                <TextBlock Text="Cargando..."
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           Margin="4,8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ── ACCESOS RAPIDOS ── -->
                <Border Grid.Row="2" Style="{StaticResource DashboardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource DashboardPanelTopBarStyle}"
                                Background="{StaticResource GreenMain}"/>

                        <StackPanel Grid.Row="1" Margin="16,14,16,12"
                                    Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardPanelHeaderIconStyle}"
                                    Background="#1E1840">
                                <fa:ImageAwesome Icon="Flash" Foreground="{StaticResource GreenMain}"
                                                 Height="14" Width="14"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ACCESOS RAPIDOS"
                                       Style="{StaticResource DashboardPanelHeaderTextStyle}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="2" Rows="3" Columns="2"
                                     Margin="12,0,12,14">

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoSocio"
                                    Click="btnRapidoSocio_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="UserPlus" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nuevo Socio" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoCuota"
                                    Click="btnRapidoCuota_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="Money" Foreground="#00E676"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cobrar Cuota" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoAsistencia"
                                    Click="btnRapidoAsistencia_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="CheckSquareOutline" Foreground="#D4830A"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Asistencia" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoVenta"
                                    Click="btnRapidoVenta_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="ShoppingBasket" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nueva Venta" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoTurno"
                                    Click="btnRapidoTurno_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="Calendar" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nuevo Turno" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardAccesoStyle}"
                                    x:Name="btnRapidoReporte">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="BarChart" Foreground="{StaticResource GreenMain}"
                                                     Height="16" Width="16"
                                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ver Reportes" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
