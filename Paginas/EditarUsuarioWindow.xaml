<Window x:Class="SistemaGimnacionOptimusCAI.Paginas.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar mis datos"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Bg1}" CornerRadius="16"
            BorderBrush="{StaticResource Border2}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource Bg2}" CornerRadius="16,16,0,0"
                    Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="EDITAR MIS DATOS" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Modificá tu información personal" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="X" Click="btnCerrar_Click"
                            Width="36" Height="36" FontSize="16" FontWeight="Bold"
                            Foreground="{StaticResource TextMuted}" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource PanelScrollViewerStyle}" Margin="24,28,24,20">
                <StackPanel Margin="12,0">

                    <!-- Foto -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="80" Height="80" CornerRadius="40"
                                Background="{StaticResource Bg3}" BorderBrush="{StaticResource Border2}"
                                BorderThickness="1">
                            <Border.Clip>
                                <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                            </Border.Clip>
                            <Grid>
                                <Image x:Name="imgFoto" Stretch="UniformToFill"/>
                                <TextBlock x:Name="lblIniciales" Text="?" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button Content="CAMBIAR FOTO" Click="btnCambiarFoto_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource GreenMain}" FontSize="11" FontWeight="Bold"
                                Cursor="Hand" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Nombre y Apellido -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="NOMBRE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}"
                                     MaxLength="100"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="APELLIDO" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtApellido" Style="{StaticResource InputEstilo}"
                                     MaxLength="100"/>
                        </StackPanel>
                    </Grid>

                    <!-- DNI y Email -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="DNI" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtDni" Style="{StaticResource InputEstilo}"
                                     MaxLength="8" PreviewTextInput="txtDni_PreviewTextInput"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="EMAIL" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEmail" Style="{StaticResource InputEstilo}"
                                     MaxLength="191"/>
                        </StackPanel>
                    </Grid>

                    <!-- Teléfono y Domicilio -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TELÉFONO" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtTelefono" Style="{StaticResource InputEstilo}"
                                     MaxLength="20"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="DOMICILIO" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtDomicilio" Style="{StaticResource InputEstilo}"
                                     MaxLength="200"/>
                        </StackPanel>
                    </Grid>

                    <!-- Separador contraseña -->
                    <Border Background="{StaticResource Border2}" Height="1" Margin="0,20,0,12"/>
                    <TextBlock Text="CAMBIAR CONTRASEÑA (opcional)" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Nueva contraseña -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="NUEVA CONTRASEÑA" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource ColorInput}"
                                    BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                                    CornerRadius="8" Height="40">
                                <PasswordBox x:Name="txtClaveNueva"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource ColorCuerpo}"
                                             CaretBrush="{StaticResource ColorPrimario}"
                                             FontSize="13" VerticalContentAlignment="Center"
                                             Padding="12,0" MaxLength="50"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="REPETIR CONTRASEÑA" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource ColorInput}"
                                    BorderBrush="{StaticResource ColorBorde}" BorderThickness="1"
                                    CornerRadius="8" Height="40">
                                <PasswordBox x:Name="txtClaveConfirmar"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource ColorCuerpo}"
                                             CaretBrush="{StaticResource ColorPrimario}"
                                             FontSize="13" VerticalContentAlignment="Center"
                                             Padding="12,0" MaxLength="50"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER BOTONES -->
            <Border Grid.Row="2" Background="{StaticResource Bg2}" CornerRadius="0,0,16,16"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblError" Grid.Column="0" Text="" FontSize="11"
                               Foreground="{StaticResource ColorError}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Button Grid.Column="1" Content="CANCELAR" Click="btnCancelar_Click"
                            Style="{StaticResource BotonDangerLargoEstilo}"
                            Padding="18,0" Width="100" Margin="0,0,10,0"/>

                    <Button Grid.Column="2" Content="GUARDAR CAMBIOS" Click="btnGuardar_Click"
                            Style="{StaticResource BotonPrincipalEstilo}"
                            Height="40" Padding="24,0" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
