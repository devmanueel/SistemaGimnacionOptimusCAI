<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.ActividadesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Actividades">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="#FF4444"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="#4A4A7A"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A78BFA" Offset="0"/>
                            <GradientStop Color="#FF6B35" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="ACTIVIDADES Y PLANES"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Planes mensuales, clases sueltas y precios"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Buscador -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtBuscar" 
Style="{StaticResource BuscadorStyle}"
Width="290" 
Margin="0,0,12,0"
TextChanged="txtBuscar_TextChanged"/>

                <Button Content="＋  NUEVA ACTIVIDAD"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="185" Height="46" Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ STATS ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statTotal" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="TOTAL PLANES" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statActivos" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text="ACTIVOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statSociosTotal" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#00CFFF"/>
                    <TextBlock Text="SOCIOS ACTIVOS EN PLANES" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS ══════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="MOSTRAR:" Foreground="#4A4A7A" FontSize="11"
               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- CHIP SELECCIONADO (TODOS) -->
            <Button x:Name="chipTodos" Content="todos"
    Click="chipFiltro_Click" Tag="todos"
    Style="{StaticResource ChipFiltroEstilo}"
    Background="#1E1E38" Foreground="#E8E8FF"
    BorderThickness="0" Margin="0,0,8,0"/>

            <!-- CHIP DESELECCIONADO (ACTIVOS) -->
            <Button x:Name="chipActivos" Content="Activos"
    Click="chipFiltro_Click" Tag="activas"
    Style="{StaticResource ChipFiltroEstilo}"
    Background="Transparent" Foreground="#6A6A9A"
    BorderThickness="1" BorderBrush="#252540" Margin="0,0,8,0"/>

            <!-- CHIP DESELECCIONADO (INACTIVOS) -->
            <Button x:Name="chipInactivos" Content="Inactivos"
    Click="chipFiltro_Click" Tag="inactivas"
    Style="{StaticResource ChipFiltroEstilo}"
    Background="Transparent" Foreground="#6A6A9A"
    BorderThickness="1" BorderBrush="#252540" Cursor="Hand"/>
        </StackPanel>

        <!-- ══════════════════ CONTENIDO ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATAGRID -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="0.5"/>
                                <GradientStop Color="#12121E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="gridActividades"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="58"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A1A2E">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ACTIVIDAD" Binding="{Binding Nombre}" Width="1.5*"/>

                            <!-- Tipo badge -->
                            <DataGridTemplateColumn Header="TIPO" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TipoBadgeStyle}">
                                            <TextBlock Text="{Binding TipoTexto}" FontSize="11" 
               FontWeight="SemiBold"
               Foreground="{StaticResource ColorVioleta}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="DÍAS" Binding="{Binding DiasTexto}" Width="0.7*"/>

                            <!-- Precio destacado -->
                            <DataGridTemplateColumn Header="PRECIO" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PrecioTexto}" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="#00E676" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cantidad de socios -->
                            <DataGridTemplateColumn Header="SOCIOS" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SociosBadgeStyle}">
                                            <TextBlock Style="{StaticResource SociosTextStyle}" 
                           Text="{Binding SociosTexto}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Estado -->
                            <DataGridTemplateColumn Header="ESTADO" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource EstadoBadgeStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource EstadoDotStyle}"/>
                                                <TextBlock Style="{StaticResource EstadoTextStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <!-- BOTÓN EDITAR -->
                                            <Button Click="btnEditar_Click" 
Style="{StaticResource ButtonStyleEditar}" 
Margin="0,0,8,0">
                                                <fa:ImageAwesome Icon="Edit" Foreground="#00CFFF" Height="14"/>
                                            </Button>

                                            <!-- BOTÓN ESTADO -->
                                            <Button Click="btnToggleEstado_Click" 
Style="{StaticResource ButtonStyleEstado}">
                                                <fa:ImageAwesome Height="14">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Icon" Value="Trash"/>
                                                            <Setter Property="Foreground" Value="#FF5555"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Icon" Value="Undo"/>
                                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════ PANEL FORMULARIO ══════════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="380"
                    Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Línea superior -->
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="0.5"/>
                                <GradientStop Color="#00CFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="NUEVA ACTIVIDAD"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,14,22,0" Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel>

                            <!-- NOMBRE -->
                            <TextBlock Text="NOMBRE DE LA ACTIVIDAD *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}"
                                     LostFocus="txtNombre_LostFocus"/>
                            <TextBlock x:Name="errNombre" Style="{StaticResource LabelErrorEstilo}"/>

                            <!-- TIPO -->
                            <TextBlock Text="TIPO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbTipo" Style="{StaticResource ComboBoxEstilo}" 
                                      Margin="0,0,0,14" SelectionChanged="cmbTipo_SelectionChanged">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Mensual"            Tag="mensual"            Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Mensual con clases" Tag="mensual_con_clases" Foreground="#E8E8FF"/>
                                </ComboBox>

                            <!-- DÍAS/SESIONES POR SEMANA -->
                            <TextBlock x:Name="lblDias" Text="DÍAS POR SEMANA *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtDias" Style="{StaticResource InputEstilo}"
                                     MaxLength="1"
                                     PreviewTextInput="txtDias_PreviewTextInput"/>
                            <TextBlock x:Name="errDias" Style="{StaticResource LabelErrorEstilo}"/>

                            <!-- SELECTOR DE DÍAS (checkboxes Lun-Sáb) -->
                            <TextBlock x:Name="lblSelectorDias" Text="DÍAS HABILITADOS"
                                       Style="{StaticResource LabelCampoEstilo}"/>
                            <Border x:Name="panelDias" Background="Transparent" 
        Margin="0,0,0,14">
                                <WrapPanel>
                                    <CheckBox x:Name="chkLun" Content="Lunes"     Tag="1" Style="{DynamicResource DiaCheckEstilo}"/>
                                    <CheckBox x:Name="chkMar" Content="Martes"    Tag="2" Style="{StaticResource DiaCheckEstilo}"/>
                                    <CheckBox x:Name="chkMie" Content="Miércoles" Tag="3" Style="{StaticResource DiaCheckEstilo}"/>
                                    <CheckBox x:Name="chkJue" Content="Jueves"    Tag="4" Style="{StaticResource DiaCheckEstilo}"/>
                                    <CheckBox x:Name="chkVie" Content="Viernes"   Tag="5" Style="{StaticResource DiaCheckEstilo}"/>
                                    <CheckBox x:Name="chkSab" Content="Sábado"    Tag="6" Style="{StaticResource DiaCheckEstilo}"/>
                                </WrapPanel>
                            </Border>

                            <!-- PRECIO -->
                            <TextBlock Text="PRECIO * ($)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtPrecio" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtPrecio_PreviewTextInput"
                                     LostFocus="txtPrecio_LostFocus"/>
                            <TextBlock x:Name="errPrecio" Style="{StaticResource LabelErrorEstilo}"/>

                            <!-- Preview del precio -->
                            <Border x:Name="panelPreviewPrecio" 
        Background="#0A1A0A" 
        CornerRadius="8"
        Padding="12,8" 
        Margin="0,0,0,14"
        RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <TranslateTransform Y="10"/>
                                </Border.RenderTransform>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=lblPreviewPrecio}" Value="$0">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="10" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>

                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.4">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CircleEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblPreviewPrecio" Text="$0"
                   FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                   Foreground="#00E676" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones -->
                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
