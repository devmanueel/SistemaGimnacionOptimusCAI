<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.SociosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Socios">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="#FF4444"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="#4A4A7A"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,6"/>
            </Style>

            <!-- Botón de tab del formulario -->
            <Style x:Key="TabBtnEstilo" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="#6A6A9A"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="FontWeight"      Value="Bold"/>
                <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Padding"         Value="10,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E8E8FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- GRID raíz con fade-in al cargar -->
    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="gridRaiz"
                            Storyboard.TargetProperty="Opacity"
                            From="0" To="1" Duration="0:0:0.5"
                            DecelerationRatio="0.6"/>
                        <DoubleAnimation
                            Storyboard.TargetName="translateEntrada"
                            Storyboard.TargetProperty="Y"
                            From="20" To="0" Duration="0:0:0.5"
                            DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00CFFF" Offset="0"/>
                            <GradientStop Color="#A78BFA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="GESTIÓN DE SOCIOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Carnets, datos personales y huellas dactilares"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Buscador -->
                <Border Background="#16162A" CornerRadius="10"
                        BorderBrush="#252540" BorderThickness="1.5"
                        Width="290" Height="46" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="15"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="txtBuscar" Height="44" BorderThickness="0"
                                     Background="Transparent" Foreground="#E8E8FF"
                                     CaretBrush="#00CFFF" FontSize="14"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     TextChanged="txtBuscar_TextChanged"/>
                            <TextBlock Text="Buscar por nombre, DNI o N° de socio..."
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#3A3A5C">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Botón Nuevo Socio -->
                <Button Content="＋  NUEVO SOCIO"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="170" Height="46"
                        Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             STATS
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statTotal" Text="—"
                               FontFamily="Bahnschrift SemiBold" FontSize="26"
                               FontWeight="Bold" Foreground="#00CFFF"/>
                    <TextBlock Text="TOTAL DE SOCIOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statActivos" Text="—"
                               FontFamily="Bahnschrift SemiBold" FontSize="26"
                               FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text="ACTIVOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statInactivos" Text="—"
                               FontFamily="Bahnschrift SemiBold" FontSize="26"
                               FontWeight="Bold" Foreground="#FF5555"/>
                    <TextBlock Text="INACTIVOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statNuevosMes" Text="—"
                               FontFamily="Bahnschrift SemiBold" FontSize="26"
                               FontWeight="Bold" Foreground="#FF6B35"/>
                    <TextBlock Text="NUEVOS DEL MES" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             FILTROS de estado (chips)
        ══════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="MOSTRAR:" Foreground="#4A4A7A" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <Button x:Name="chipTodos" Content="Todos"
                    Click="chipFiltro_Click" Tag="todos"
                    Background="#1E1E38" Foreground="#E8E8FF"
                    BorderThickness="0" Cursor="Hand"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold"
                    Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="chipActivos" Content="Activos"
                    Click="chipFiltro_Click" Tag="activos"
                    Background="Transparent" Foreground="#6A6A9A"
                    BorderThickness="1" BorderBrush="#252540" Cursor="Hand"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold"
                    Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="chipInactivos" Content="Inactivos"
                    Click="chipFiltro_Click" Tag="inactivos"
                    Background="Transparent" Foreground="#6A6A9A"
                    BorderThickness="1" BorderBrush="#252540" Cursor="Hand"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════
             CONTENIDO: DataGrid + Panel formulario lateral
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATAGRID -->
            <Border Grid.Column="0" Background="#12121E"
                    CornerRadius="12" BorderBrush="#252540" BorderThickness="1"
                    Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="0.5"/>
                                <GradientStop Color="#12121E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="gridSocios"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="64"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A1A2E"
                              SelectionChanged="gridSocios_SelectionChanged">

                        <DataGrid.Columns>
                            <!-- Foto con anillo degradado -->
                            <DataGridTemplateColumn Width="72" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center">
                                            <Ellipse Width="48" Height="48">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#00CFFF" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="44" Height="44">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource BytesAImagen}}"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Número de socio: badge naranja -->
                            <DataGridTemplateColumn Header="N°" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#2A1600" CornerRadius="6"
                                                Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding NumeroFormateado}"
                                                       FontFamily="Consolas"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="#FF6B35"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="NOMBRE COMPLETO"
                                                Binding="{Binding NombreCompleto}" Width="1.6*"/>
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="0.8*"/>
                            <DataGridTextColumn Header="EDAD" Binding="{Binding EdadTexto}" Width="0.6*"/>
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="1.1*"/>

                            <!-- Estado badge con punto -->
                            <DataGridTemplateColumn Header="ESTADO" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A0A0A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="True">
                                                            <Setter Property="Background" Value="#0A2A14"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                    <Setter Property="Fill" Value="#00E676"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="#FF6666"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                    <Setter Property="Text" Value="Activo"/>
                                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="#1A1A30" Margin="0,0,8,0">
                                                <Button Click="btnEditar_Click" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Editar socio">
                                                    <TextBlock Text="✏" FontSize="15" Foreground="#00CFFF"/>
                                                </Button>
                                            </Border>
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="#1A1A30">
                                                <Button Click="btnToggleEstado_Click" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand">
                                                    <TextBlock FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="🗑"/>
                                                                <Setter Property="Foreground" Value="#FF5555"/>
                                                                <Setter Property="ToolTip" Value="Desactivar"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Text" Value="♻"/>
                                                                        <Setter Property="Foreground" Value="#00E676"/>
                                                                        <Setter Property="ToolTip" Value="Reactivar"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════
                 PANEL FORMULARIO LATERAL CON TABS
            ══════════════════════════════════════════════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="400"
                    Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Header con título y N° -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tabs -->
                        <RowDefinition Height="*"/>
                        <!-- Contenido tab -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botones -->
                    </Grid.RowDefinitions>

                    <!-- Línea decorativa superior -->
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="0.5"/>
                                <GradientStop Color="#00CFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Header del panel: título + número de socio -->
                    <Grid Grid.Row="1" Margin="22,18,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblTituloFormulario" Text="NUEVO SOCIO"
                                       FontFamily="Bahnschrift SemiBold, Segoe UI"
                                       FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2A1600" CornerRadius="6" Padding="10,4">
                            <TextBlock x:Name="lblNumeroSocio" Text="#0001"
                                       FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                       Foreground="#FF6B35"/>
                        </Border>
                    </Grid>

                    <!-- TABS: Datos / Contacto / Otros -->
                    <Grid Grid.Row="2" Margin="22,14,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnTabDatos"      Grid.Column="0"
                                Content="DATOS"          Tag="datos"
                                Style="{StaticResource TabBtnEstilo}"
                                Click="btnTab_Click"/>
                        <Button x:Name="btnTabContacto"  Grid.Column="1"
                                Content="CONTACTO"       Tag="contacto"
                                Style="{StaticResource TabBtnEstilo}"
                                Click="btnTab_Click"/>
                        <Button x:Name="btnTabOtros"     Grid.Column="2"
                                Content="OTROS / HUELLA" Tag="otros"
                                Style="{StaticResource TabBtnEstilo}"
                                Click="btnTab_Click"/>
                    </Grid>

                    <!-- CONTENIDO de los tabs -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  Margin="22,14,22,0">
                        <Grid>
                            <!-- ── TAB 1: DATOS PERSONALES ───────────── -->
                            <StackPanel x:Name="tabDatos">

                                <!-- Foto -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Grid>
                                        <Ellipse Width="106" Height="106">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF6B35" Offset="0"/>
                                                    <GradientStop Color="#A78BFA" Offset="0.5"/>
                                                    <GradientStop Color="#00CFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="100" Height="100" HorizontalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="imgFotoFormulario" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Button Width="28" Height="28" VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right" Cursor="Hand"
                                                ToolTip="Cambiar foto" Click="btnSubirFoto_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FF6B35" Offset="0"/>
                                                                <GradientStop Color="#FF3D1F" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="📷" FontSize="12" Margin="0,0,0,1"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}"
                                         LostFocus="txtNombre_LostFocus"/>
                                <TextBlock x:Name="errNombre" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="APELLIDO *" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtApellido" Style="{StaticResource InputEstilo}"
                                         LostFocus="txtApellido_LostFocus"/>
                                <TextBlock x:Name="errApellido" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="DNI *  (7 u 8 dígitos)" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtDni" Style="{StaticResource InputEstilo}"
                                         MaxLength="8"
                                         PreviewTextInput="txtDni_PreviewTextInput"
                                         DataObject.Pasting="txtDni_Pasting"
                                         LostFocus="txtDni_LostFocus"/>
                                <TextBlock x:Name="errDni" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource LabelCampoEstilo}"/>
                                <Border Background="#16162A" CornerRadius="10" Height="46"
                                        BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                    <DatePicker x:Name="dpNacimiento"
                                                BorderThickness="0" Background="Transparent"
                                                FontSize="14" VerticalContentAlignment="Center"
                                                Padding="10,0" Foreground="#E8E8FF"/>
                                </Border>

                                <TextBlock Text="SEXO" Style="{StaticResource LabelCampoEstilo}"/>
                                <Border Background="#16162A" CornerRadius="10" Height="46"
                                        BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                    <ComboBox x:Name="cmbSexo" BorderThickness="0" Background="Transparent"
                                              Foreground="#E8E8FF" VerticalContentAlignment="Center"
                                              FontSize="14" Padding="10,0">
                                        <ComboBoxItem Content="Masculino" Tag="M"   Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Femenino"  Tag="F"   Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Otro"      Tag="Otro" Foreground="#E8E8FF" IsSelected="True"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <!-- ── TAB 2: CONTACTO ───────────── -->
                            <StackPanel x:Name="tabContacto" Visibility="Collapsed">

                                <TextBlock Text="TELÉFONO" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtTelefono" Style="{StaticResource InputEstilo}"
                                         MaxLength="20" LostFocus="txtTelefono_LostFocus"/>
                                <TextBlock x:Name="errTelefono" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="EMAIL" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource InputEstilo}"
                                         LostFocus="txtEmail_LostFocus"/>
                                <TextBlock x:Name="errEmail" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="DOMICILIO" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtDomicilio" Style="{StaticResource InputEstilo}"/>

                                <TextBlock Text="PROFESIÓN" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtProfesion" Style="{StaticResource InputEstilo}"/>

                                <TextBlock Text="¿CÓMO NOS CONOCIÓ?" Style="{StaticResource LabelCampoEstilo}"/>
                                <Border Background="#16162A" CornerRadius="10" Height="46"
                                        BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                    <ComboBox x:Name="cmbComoConocio" BorderThickness="0" Background="Transparent"
                                              Foreground="#E8E8FF" VerticalContentAlignment="Center"
                                              FontSize="14" Padding="10,0" IsEditable="True">
                                        <ComboBoxItem Content="Recomendación de amigo" Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Redes sociales"          Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Pasé por la calle"       Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Publicidad"              Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Familiar"                Foreground="#E8E8FF"/>
                                        <ComboBoxItem Content="Otro"                    Foreground="#E8E8FF"/>
                                    </ComboBox>
                                </Border>

                            </StackPanel>

                            <!-- ── TAB 3: OTROS + HUELLA ───────────── -->
                            <StackPanel x:Name="tabOtros" Visibility="Collapsed">

                                <!-- Sección HUELLA -->
                                <Border Background="#0A1A2A" CornerRadius="10"
                                        BorderBrush="#1A3A5A" BorderThickness="1"
                                        Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="🔒" FontSize="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="HUELLA / PIN DE ACCESO"
                                                       Foreground="#00CFFF" FontSize="12"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="El PIN se genera automáticamente como SHA-256 del DNI. El socio podrá acceder al gimnasio con su huella registrada o ingresando su DNI."
                                                   Foreground="#6A8AAA" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <!-- Indicador de PIN registrado -->
                                        <StackPanel x:Name="panelPinEstado" Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#00E676"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="lblPinEstado"
                                                       Text="PIN configurado automáticamente"
                                                       Foreground="#00E676" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Checkbox para regenerar PIN al editar -->
                                        <CheckBox x:Name="chkRegenerarPin"
                                                  Content="Regenerar PIN (al cambiar DNI)"
                                                  Foreground="#A0A0C0" FontSize="11"
                                                  Margin="0,12,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="OBSERVACIONES" Style="{StaticResource LabelCampoEstilo}"/>
                                <Border Background="#16162A" CornerRadius="10"
                                        BorderBrush="#252540" BorderThickness="1.5"
                                        Margin="0,0,0,14">
                                    <TextBox x:Name="txtObservaciones"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#E8E8FF" CaretBrush="#00CFFF"
                                             FontSize="13" Padding="14,10"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="100" VerticalScrollBarVisibility="Auto"/>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Botones Cancelar / Guardar -->
                    <Grid Grid.Row="4" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
