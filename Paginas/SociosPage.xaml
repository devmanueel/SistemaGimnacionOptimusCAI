<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.SociosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Socios">

    <Page.Background>
        <SolidColorBrush Color="#080A08"/>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <helpers:InicialesConverter x:Key="InicialesConverter"/>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="{StaticResource ColorError}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,10"/>
            </Style>

            <Style x:Key="TabBtnEstilo" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"        Value="11"/>
                <Setter Property="FontWeight"      Value="Bold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Padding"         Value="10,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TabBtnEstilo2" TargetType="Button" BasedOn="{StaticResource TabBtnEstilo}"/>

        </ResourceDictionary>
    </Page.Resources>

    <!-- GRID raíz con fade-in al cargar -->
    <Grid x:Name="gridRaiz" Margin="0" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="gridRaiz"
                            Storyboard.TargetProperty="Opacity"
                            From="0" To="1" Duration="0:0:0.5"
                            DecelerationRatio="0.6"/>
                        <DoubleAnimation
                            Storyboard.TargetName="translateEntrada"
                            Storyboard.TargetProperty="Y"
                            From="20" To="0" Duration="0:0:0.5"
                            DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Gestión de socios" Style="{StaticResource TopbarTituloStyle}"/>
                <TextBlock Text="Carnets, datos personales y huellas dactilares" Style="{StaticResource TopbarSubtituloStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Buscador -->
                <Border Style="{StaticResource BuscadorNuevoStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="Search"
                                         Foreground="{StaticResource TextMuted}"
                                         Height="14" Width="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="txtBuscar"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource GreenMain}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="txtBuscar_TextChanged"/>
                            <TextBlock Text="Buscar por socio, DNI o N°"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=txtBuscar}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Botón Baja Inactivos -->
                <Button x:Name="btnBajaInactivos"
                        Content="Baja inactivos"
                        Width="130"
                        Height="34"
                        Margin="0,0,10,0"
                        Style="{StaticResource BotonDangerEstilo}"
                        Click="btnBajaInactivos_Click"/>

                <!-- Botón Nuevo Socio -->
                <Button Content="Nuevo socio"
                        Width="120"
                        Height="34"
                        Style="{StaticResource BotonNuevoSocioStyle}"
                        Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             STATS CARDS
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statTotal" Text="—" Style="{StaticResource StatsNumeroStyle}"/>
                        <TextBlock Text="TOTAL DE SOCIOS" Style="{StaticResource StatsEtiquetaStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Users"
                                     Foreground="{StaticResource TextMuted}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatsCardConBordeVerde}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statActivos" Text="—" Style="{StaticResource StatsNumeroActivosStyle}"/>
                        <TextBlock Text="ACTIVOS" Style="{StaticResource StatsEtiquetaStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Check"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statInactivos" Text="—" Style="{StaticResource StatsNumeroMutedStyle}"/>
                        <TextBlock Text="INACTIVOS" Style="{StaticResource StatsEtiquetaStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Times"
                                     Foreground="{StaticResource TextSecondary}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource StatsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statNuevosMes" Text="—" Style="{StaticResource StatsNumeroAcentoStyle}"/>
                        <TextBlock Text="NUEVOS DEL MES" Style="{StaticResource StatsEtiquetaStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="UserPlus"
                                     Foreground="#00CFFF"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             FILTROS
        ══════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,14,16,0">
            <TextBlock Text="MOSTRAR:" Foreground="{StaticResource TextMuted}" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="chipTodos"
                    Style="{StaticResource BotonChipActivoEstilo}"
                    Margin="0,0,6,0"
                    Click="chipFiltro_Click"
                    Tag="todos"
                    Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Todos"/>
                    <TextBlock x:Name="chipTodosNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="chipActivos"
                    Style="{StaticResource BotonChipEstilo}"
                    Margin="0,0,6,0"
                    Click="chipFiltro_Click"
                    Tag="activos"
                    Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Activos"/>
                    <TextBlock x:Name="chipActivosNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="chipInactivos"
                    Style="{StaticResource BotonChipEstilo}"
                    Click="chipFiltro_Click"
                    Tag="inactivos"
                    Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Inactivos"/>
                    <TextBlock x:Name="chipInactivosNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>

        </StackPanel>

        <!-- ══════════════════════════════════════════════════
             CONTENIDO: Tabla + Panel formulario lateral
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="16,14,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── TABLA (ListView + GridView) ───────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource Bg1}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource Border1}"
                    BorderThickness="0.5"
                    Margin="0,0,14,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource GreenMid}"
                            CornerRadius="10,10,0,0"/>

                    <DataGrid Grid.Row="1" x:Name="gridSocios"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="56"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Border1}"
                               SelectionChanged="gridSocios_SelectionChanged">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollStyle}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Avatar -->
                            <DataGridTemplateColumn Width="56" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                            <Ellipse Width="36" Height="36">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#1C2A1C"/>
                                                </Ellipse.Fill>
                                                <Ellipse.Stroke>
                                                    <SolidColorBrush Color="#263326"/>
                                                </Ellipse.Stroke>
                                                <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                                            </Ellipse>
                                            <Ellipse Width="28" Height="28">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource BytesAImagen}}"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- N° -->
                            <DataGridTemplateColumn Header="N°" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NumeroSocioBadgeStyle}">
                                            <TextBlock Text="{Binding NumeroFormateado}"
                                                       Style="{StaticResource NumeroSocioTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Nombre + Email -->
                            <DataGridTemplateColumn Header="NOMBRE COMPLETO" Width="1.6*"
                                                    SortMemberPath="NombreCompleto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NombreCompleto}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Email}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DNI -->
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="0.8*"/>

                            <!-- Edad -->
                            <DataGridTextColumn Header="EDAD" Binding="{Binding EdadTexto}" Width="0.6*"/>

                            <!-- Teléfono -->
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="1.1*"/>

                            <!-- Estado -->
                            <DataGridTemplateColumn Header="ESTADO" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource GreenMain}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       Text="{Binding EstadoTexto}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource ButtonStyleEditar}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Editar socio"
                                                    Click="btnEditar_Click">
                                                <fa:ImageAwesome Icon="Edit"
                                                                   Foreground="{StaticResource ColorEditarCyan}"
                                                                   Height="14"/>
                                            </Button>
                                            <Button Style="{StaticResource ButtonStyleEstado}"
                                                    Click="btnToggleEstado_Click">
                                                <Button.ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Dar de baja"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Text" Value="Dar de alta"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.ToolTip>
                                                <fa:ImageAwesome Height="14">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Icon" Value="Times"/>
                                                            <Setter Property="Foreground" Value="#FF5555"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Icon" Value="Undo"/>
                                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════
                 PANEL FORMULARIO LATERAL CON TABS
            ══════════════════════════════════════════════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="400"
                    Background="{StaticResource Bg1}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource Border1}"
                    BorderThickness="0.5"
                    Visibility="Collapsed"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource GreenMid}"
                            CornerRadius="12,12,0,0"/>

                    <!-- Header -->
                    <Grid Grid.Row="1" Margin="22,18,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblTituloFormulario" Text="NUEVO SOCIO"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource NumeroSocioBadgeStyle}">
                            <TextBlock x:Name="lblNumeroSocio" Text="#0001"
                                       Style="{StaticResource NumeroSocioTextStyle}"/>
                        </Border>
                    </Grid>

                    <!-- TABS -->
                    <Grid Grid.Row="2" Margin="22,14,22,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,4">
                            <Button x:Name="btnTabDatos" Tag="datos" Content="DATOS"
                                    Style="{StaticResource TabBtnEstilo}"
                                    Click="BtnTab_Click" IsEnabled="False"/>
                            <Button x:Name="btnTabContacto" Tag="contacto" Content="CONTACTO"
                                    Style="{StaticResource TabBtnEstilo}"
                                    Click="BtnTab_Click"/>
                            <Button x:Name="btnTabOtros" Tag="otros" Content="OTROS / HUELLA"
                                    Style="{StaticResource TabBtnEstilo}"
                                    Click="BtnTab_Click"/>
                        </UniformGrid>

                        <Border x:Name="barraTab" Grid.Row="1"
                                Height="2" CornerRadius="1"
                                Background="{StaticResource GreenMain}"
                                HorizontalAlignment="Left" Width="118">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- CONTENIDO TABS -->
                    <ScrollViewer Grid.Row="3"
                                  Style="{StaticResource PanelScrollViewerStyle}"
                                  Padding="0,0,15,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="22,8,22,0">
                        <StackPanel>
                            <!-- TAB 1: DATOS -->
                            <StackPanel x:Name="tabDatos">
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Grid Margin="0,15,0,0">
                                        <Ellipse Width="106" Height="106">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="#1C2A1C"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="100" Height="100" HorizontalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="imgFotoFormulario" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Button Width="28" Height="28" VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right" Cursor="Hand"
                                                ToolTip="Cambiar foto" Click="btnSubirFoto_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="14"
                                                            Background="{StaticResource GreenMain}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="📷" FontSize="12" Margin="0,0,0,1"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}"
                                         LostFocus="txtNombre_LostFocus"/>
                                <TextBlock x:Name="errNombre" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="APELLIDO *" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtApellido" Style="{StaticResource InputEstilo}"
                                         LostFocus="txtApellido_LostFocus"/>
                                <TextBlock x:Name="errApellido" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="DNI * (7 u 8 dígitos)" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtDni" Style="{StaticResource InputEstilo}"
                                         MaxLength="8"
                                         PreviewTextInput="txtDni_PreviewTextInput"
                                         DataObject.Pasting="txtDni_Pasting"
                                         LostFocus="txtDni_LostFocus"/>
                                <TextBlock x:Name="errDni" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource LabelCampoEstilo}"/>
                                <DatePicker x:Name="dpNacimiento"
                                            Style="{StaticResource DatePickerEstilo}"
                                            Margin="0,0,0,16"/>

                                <TextBlock Margin="0,0,0,6" Text="SEXO" Style="{StaticResource LabelCampoEstilo}"/>
                                <ComboBox x:Name="cmbSexo"
                                          Style="{StaticResource ComboBoxEstilo}"
                                          Margin="0,0,0,14">
                                    <ComboBoxItem Content="Masculino" Tag="M"/>
                                    <ComboBoxItem Content="Femenino" Tag="F"/>
                                    <ComboBoxItem Content="Otro" Tag="Otro" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- TAB 2: CONTACTO -->
                            <StackPanel x:Name="tabContacto" Visibility="Collapsed">
                                <TextBlock Text="TELÉFONO" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtTelefono" Style="{StaticResource InputEstilo}"
                                         MaxLength="20" LostFocus="txtTelefono_LostFocus"/>
                                <TextBlock x:Name="errTelefono" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="EMAIL" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource InputEstilo}"
                                         LostFocus="txtEmail_LostFocus"/>
                                <TextBlock x:Name="errEmail" Style="{StaticResource LabelErrorEstilo}"/>

                                <TextBlock Text="DOMICILIO" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtDomicilio" Style="{StaticResource InputEstilo}"/>

                                <TextBlock Text="PROFESIÓN" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtProfesion" Style="{StaticResource InputEstilo}"/>

                                <TextBlock Text="¿CÓMO NOS CONOCIÓ?" Style="{StaticResource LabelCampoEstilo}"/>
                                <ComboBox x:Name="cmbComoConocio"
                                          FontSize="14" Padding="10,0"
                                          Style="{StaticResource ComboBoxEstilo}"
                                          Margin="0,0,0,14">
                                    <ComboBoxItem Content="Recomendación de amigo"/>
                                    <ComboBoxItem Content="Redes sociales"/>
                                    <ComboBoxItem Content="Pasé por la calle"/>
                                    <ComboBoxItem Content="Publicidad"/>
                                    <ComboBoxItem Content="Familiar"/>
                                    <ComboBoxItem Content="Otro" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- TAB 3: OTROS + HUELLA -->
                            <StackPanel x:Name="tabOtros" Visibility="Collapsed">
                                <Border Background="{StaticResource Bg3}" CornerRadius="10"
                                        BorderBrush="{StaticResource Border2}" BorderThickness="0.5"
                                        Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <fa:ImageAwesome Icon="Lock" Foreground="{StaticResource GreenMain}"
                                                             Height="16" Width="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="HUELLA / PIN DE ACCESO"
                                                       Foreground="{StaticResource GreenMain}" FontSize="12"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="El PIN se genera automáticamente como SHA-256 del DNI. El socio podrá acceder al gimnasio con su huella registrada o ingresando su DNI."
                                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <StackPanel x:Name="panelPinEstado" Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource GreenMain}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="lblPinEstado"
                                                       Text="PIN configurado automáticamente"
                                                       Foreground="{StaticResource GreenMain}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox x:Name="chkRegenerarPin"
                                                  Content="Regenerar PIN (al cambiar DNI)"
                                                  Foreground="{StaticResource TextSecondary}" FontSize="11"
                                                  Margin="0,12,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="OBSERVACIONES" Style="{StaticResource LabelCampoEstilo}"/>
                                <Border Background="{StaticResource Bg2}" CornerRadius="8"
                                        BorderBrush="{StaticResource Border2}" BorderThickness="1"
                                        Margin="0,0,0,14">
                                    <TextBox x:Name="txtObservaciones"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource GreenMain}"
                                             FontSize="13" Padding="12,10"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="100" VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones Cancelar / Guardar -->
                    <Grid Grid.Row="4" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>