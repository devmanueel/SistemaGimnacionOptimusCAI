<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.ProductosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Productos">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="{StaticResource ColorError}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>

            <!-- Botón toggle activo/inactivo en cards -->
            <Style x:Key="ProductoBtnToggleStyle" TargetType="Button">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="borde" Property="Background" Value="#162016"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Activo}" Value="True">
                        <Setter Property="Background" Value="#1A1010"/>
                        <Setter Property="BorderBrush" Value="#3A1515"/>
                        <Setter Property="Foreground" Value="#C44040"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Activo}" Value="False">
                        <Setter Property="Background" Value="#111811"/>
                        <Setter Property="BorderBrush" Value="#1E281E"/>
                        <Setter Property="Foreground" Value="#00E676"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- CARD del producto -->
            <Style x:Key="ProductoCardEstilo" TargetType="Border">
                <Setter Property="Width"           Value="220"/>
                <Setter Property="Height"          Value="320"/>
                <Setter Property="Margin"          Value="8"/>
                <Setter Property="Background"      Value="#111811"/>
                <Setter Property="BorderBrush"     Value="{StaticResource Border1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="12"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="ClipToBounds"    Value="True"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GreenMain}"/>
                        <Setter Property="Background"  Value="{StaticResource ColorInputHover}"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.03" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.03" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.0" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.0" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="PRODUCTOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Kiosco, suplementos y mercadería"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtBuscar" Tag="Buscar producto..."
                         Style="{StaticResource BuscadorStyle}" Width="290" 
                         Margin="0,0,12,0" TextChanged="txtBuscar_TextChanged"/>

                <Button Content="NUEVO PRODUCTO"
                        Tag="Plus"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="195" Height="46" Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ STATS ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statTotal" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="TOTAL PRODUCTOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Cube"
                                     Foreground="{StaticResource TextPrimary}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statSinStock" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource ColorError}"/>
                        <TextBlock Text="SIN STOCK" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="TimesCircle"
                                     Foreground="{StaticResource ColorError}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statBajoStock" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="#D4830A"/>
                        <TextBlock Text="BAJO STOCK" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Flag"
                                     Foreground="#D4830A"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="6" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statValorInventario" Text="—"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="VALOR INVENTARIO" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Dollar"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS ══════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="STOCK:" Foreground="{StaticResource TextMuted}" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="chipTodos"     Content="Todos"     Click="chipFiltro_Click" Tag="todos"
                        Style="{StaticResource BotonChipActivoEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipConStock"  Content="Con stock" Click="chipFiltro_Click" Tag="con_stock"
                        Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipBajoStock" Content="Bajo stock" Click="chipFiltro_Click" Tag="bajo_stock"
                        Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipSinStock"  Content="Sin stock" Click="chipFiltro_Click" Tag="sin_stock"
                        Style="{StaticResource BotonChipEstilo}"/>
            </StackPanel>

            <!-- Filtro de categoría -->
            <ComboBox x:Name="cmbFiltroCategoria"
                      Grid.Column="2"
                      Width="250"
          Style="{StaticResource ComboBoxEstilo}"
          Height="40"
          SelectionChanged="cmbFiltroCategoria_SelectionChanged">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                </ComboBox.Resources>
            </ComboBox>
        </Grid>

        <!-- ══════════════════ CONTENIDO ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ GRILLA DE CARDS ══════ -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="14" Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Estado vacío -->
                            <StackPanel Grid.Row="0" x:Name="panelVacio"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,80,0,0" Visibility="Collapsed">
                                <TextBlock Text="📦" FontSize="64" HorizontalAlignment="Center"
                                           Opacity="0.4"/>
                                <TextBlock Text="No hay productos cargados"
                                           FontFamily="Bahnschrift SemiBold"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Empezá agregando tu primer producto al kiosco"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- WrapPanel donde se generan las cards -->
                            <WrapPanel Grid.Row="1" x:Name="panelProductos"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════ PANEL DETALLE/FORMULARIO ══════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="400"
                    Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="NUEVO PRODUCTO"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" 
                                  Margin="22,14,22,0" Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel>

                            <!-- Foto -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Width="120" Height="120" CornerRadius="14"
                                        Background="#111811" BorderBrush="{StaticResource Border1}" BorderThickness="2"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="imgFotoFormulario" Stretch="UniformToFill"/>
                                        <TextBlock x:Name="lblSinFoto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <fa:ImageAwesome Icon="Archive" Foreground="#FF000000" Opacity="0.5"
                                                             Height="60" Width="60" VerticalAlignment="Center"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Button Content="Cambiar foto" Click="btnSubirFoto_Click"
                                        Background="Transparent" Foreground="{StaticResource GreenMain}"
                                        BorderThickness="0.5" BorderBrush="{StaticResource GreenMain}"
                                        Cursor="Hand" Padding="10,4" Margin="0,8,0,0"
                                        FontSize="11" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}"
                                     LostFocus="txtNombre_LostFocus"/>
                            <TextBlock x:Name="errNombre" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="CATEGORÍA" Style="{StaticResource LabelCampoEstilo}"/>

                            <ComboBox x:Name="cmbCategoria" Style="{StaticResource ComboBoxEstilo}">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Bebidas"      Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Suplementos"  Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Snacks"       Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Ropa"         Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Accesorios"   Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Higiene"      Foreground="{StaticResource TextPrimary}"/>
                                </ComboBox>
                            

                            <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#111811" CornerRadius="10"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,14">
                                <TextBox x:Name="txtDescripcion" Background="Transparent"
                                         BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                         CaretBrush="{StaticResource GreenMain}" FontSize="13" Padding="14,10"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="60" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <TextBlock Text="PRECIO * ($)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtPrecio" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtPrecio_PreviewTextInput"
                                     LostFocus="txtPrecio_LostFocus"/>
                            <TextBlock x:Name="errPrecio" Style="{StaticResource LabelErrorEstilo}"/>

                            <Border x:Name="panelPreviewPrecio" Background="#0A1A0A" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblPreviewPrecio" Text="$0"
                                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                               Foreground="#00E676" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock x:Name="lblStock" Text="STOCK INICIAL" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtStock" Style="{StaticResource InputEstilo}"
                                             PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                             Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="STOCK MÍNIMO" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtStockMin" Style="{StaticResource InputEstilo}"
                                             PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                             Text="5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sección AJUSTAR STOCK (solo en edición) -->
                            <Border x:Name="panelAjusteStock" Background="{StaticResource ColorInput}"
                                    BorderBrush="{StaticResource ColorBorde}" BorderThickness="0.5"
                                    CornerRadius="10" Padding="14" Margin="0,8,0,14"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="📦" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AJUSTAR STOCK" Foreground="{StaticResource GreenMain}"
                                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#111811" CornerRadius="8" Height="38"
                                                BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,8,0">
                                            <TextBox x:Name="txtCantidadAjuste" Background="Transparent"
                                                     BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                                     CaretBrush="{StaticResource GreenMain}" FontSize="14" Padding="10,0"
                                                     VerticalContentAlignment="Center"
                                                     PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="＋" Click="btnSumarStock_Click"
                                                    Width="34" Height="34" FontSize="14" FontWeight="Bold"
                                                    Background="#0A2A14" Foreground="#00E676"
                                                    BorderThickness="0.5" BorderBrush="#00E676"
                                                    Cursor="Hand" Margin="0,0,4,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="－" Click="btnRestarStock_Click"
                                                    Width="34" Height="34" FontSize="14" FontWeight="Bold"
                                                    Background="#1E1600" Foreground="#D4830A"
                                                    BorderThickness="0.5" BorderBrush="#D4830A"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Stock actual:" Foreground="{StaticResource TextMuted}"
                                               FontSize="14" Margin="0,8"/>
                                    <TextBlock x:Name="lblStockActual" Text="0 unidades"
                                               FontFamily="Bahnschrift SemiBold"
                                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

