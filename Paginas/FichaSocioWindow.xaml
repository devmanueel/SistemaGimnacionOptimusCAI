<Window x:Class="SistemaGimnacionOptimusCAI.Paginas.FichaSocioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Ficha de Socio"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="ByteToImage"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Bg1}" CornerRadius="16"
            BorderBrush="{StaticResource Border2}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource Bg2}" CornerRadius="16,16,0,0"
                    Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Foto circular -->
                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Background="{StaticResource Bg3}" Margin="0,0,18,0">
                        <Border.Clip>
                            <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36"/>
                        </Border.Clip>
                        <Image x:Name="imgFoto" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Datos principales -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="lblNombre" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="lblNumeroSocio" Text="#0000" FontSize="13"
                                       Foreground="{StaticResource GreenMain}" FontWeight="SemiBold"
                                       Margin="0,0,14,0"/>
                            <Border x:Name="badgeEstado" CornerRadius="8" Padding="10,2"
                                    Background="{StaticResource Bg4}" Margin="0,0,14,0">
                                <TextBlock x:Name="lblEstado" Text="—" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource GreenMain}"/>
                            </Border>
                            <TextBlock x:Name="lblCelular" Text="" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botones header -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="btnHuella" Click="btnHuella_Click"
                                Style="{StaticResource BotonSecundarioEstilo}"
                                Height="40" Padding="14,0" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Registrar huella dactilar del socio">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome x:Name="iconBtnHuella"
                                                 Icon="Hand_Paper_Outline"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 Height="14" Width="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="lblBtnHuella" Text="HUELLA"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="GENERAR CARNET" Click="btnGenerarCarnet_Click"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Height="40" Padding="20,0" FontSize="12" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="X" Click="btnCerrar_Click"
                                Width="36" Height="36" FontSize="16" FontWeight="Bold"
                                Foreground="{StaticResource TextMuted}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO CON TABS -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                        Margin="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                            Padding="{TemplateBinding Padding}" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush"
                                                    Value="{StaticResource GreenMain}"/>
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource TextPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB MEMBRESÍAS -->
                <TabItem Header="MEMBRESÍAS">
                    <Grid Margin="20,12">
                        <DataGrid x:Name="gridMembresias" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeaderWidth="0" RowHeight="44"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#111811">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ACTIVIDAD"    Binding="{Binding ActividadNombre}" Width="2*"/>
                                <DataGridTextColumn Header="PLAN"         Binding="{Binding TipoPlanTexto}"   Width="1*"/>
                                <DataGridTextColumn Header="ESTADO"       Binding="{Binding EstadoTexto}"     Width="1*"/>
                                <DataGridTextColumn Header="VENCIMIENTO"  Binding="{Binding FechaVencimientoTexto}" Width="1.2*"/>
                                <DataGridTextColumn Header="MONTO"        Binding="{Binding MontoTexto}"      Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB ASISTENCIAS -->
                <TabItem Header="ASISTENCIAS">
                    <Grid Margin="20,12">
                        <DataGrid x:Name="gridAsistencias" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeaderWidth="0" RowHeight="40"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#111811">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA Y HORA"  Binding="{Binding HoraAcceso}" Width="2*"/>
                                <DataGridTextColumn Header="ACTIVIDAD"     Binding="{Binding ActividadNombre}" Width="2*"/>
                                <DataGridTextColumn Header="RESULTADO"     Binding="{Binding ResultadoTexto}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB FICHA MÉDICA -->
                <TabItem Header="FICHA MÉDICA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,12"
                                  Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="PESO (KG)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtPeso" Style="{StaticResource InputEstilo}" MaxLength="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="ALTURA (CM)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAltura" Style="{StaticResource InputEstilo}" MaxLength="3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="GRUPO SANGUÍNEO" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtGrupo" Style="{StaticResource InputEstilo}" MaxLength="5"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="ENFERMEDADES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEnfermedades" Style="{StaticResource InputEstilo}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBlock Text="MEDICAMENTOS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                            <TextBox x:Name="txtMedicamentos" Style="{StaticResource InputEstilo}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBlock Text="RESTRICCIONES FÍSICAS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                            <TextBox x:Name="txtRestricciones" Style="{StaticResource InputEstilo}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="CONTACTO EMERGENCIA" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtContactoEmergencia" Style="{StaticResource InputEstilo}" MaxLength="150"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="TEL. EMERGENCIA" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtTelEmergencia" Style="{StaticResource InputEstilo}" MaxLength="20"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkApto" Content="APTO FÍSICO" Grid.Column="0"
                                          Foreground="{StaticResource TextPrimary}" FontSize="12"
                                          Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FECHA APTO" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="dpFechaApto" Style="{StaticResource DatePickerEstilo}" Width="160" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="OBSERVACIONES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                            <TextBox x:Name="txtObsMedicas" Style="{StaticResource InputEstilo}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Button Content="GUARDAR FICHA MÉDICA" Click="btnGuardarFicha_Click"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Height="44" Width="Auto" Padding="28,0" Margin="0,20,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
