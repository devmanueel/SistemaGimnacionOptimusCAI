<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.CasillerosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1360"
      Title="Casilleros">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>

            <!-- ESTILO DEL CASILLERO (botón visual tipo locker) -->
            <Style x:Key="CasilleroBtnEstilo" TargetType="Button">
                <Setter Property="Width"      Value="92"/>
                <Setter Property="Height"     Value="118"/>
                <Setter Property="Margin"     Value="6"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="esc" ScaleX="1" ScaleY="1" CenterX="46" CenterY="59"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="esc"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.05" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="esc"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.05" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="esc"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="esc"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="CASILLEROS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Asignación, mantenimiento y disponibilidad"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="AGREGAR"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="135" Height="46" Margin="0,0,8,0"
                        Tag="Plus"
                        Click="btnAgregar_Click"/>
                <Button Background="#1A1840" Foreground="{StaticResource GreenMain}"
                        BorderThickness="1.5" BorderBrush="{StaticResource GreenMain}"
                        FontWeight="Bold" FontSize="13"
                        Cursor="Hand" Width="180" Height="50"
                        Click="btnCrearMasa_Click">
                    
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Columns" Foreground="{StaticResource GreenMain}" Height="14" Margin="0,0,10,0"/>
                        <TextBlock Text="CREAR EN MASA" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ STATS ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statTotal" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="TOTAL CASILLEROS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Inbox"
                                     Foreground="{StaticResource TextPrimary}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statLibres" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="LIBRES" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="CheckCircle"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statOcupados" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="OCUPADOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Lock"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="6" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statMantenimiento" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="#D4830A"/>
                        <TextBlock Text="MANTENIMIENTO" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Wrench"
                                     Foreground="#D4830A"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="8" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statIngresoPotencial" Text="—"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="INGRESO POTENCIAL/MES" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Dollar"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS + LEYENDA ══════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filtros -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="MOSTRAR:" Foreground="{StaticResource TextMuted}" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="chipTodos"      Content="Todos"        Click="chipFiltro_Click" Tag="todos"
                        Style="{StaticResource BotonChipActivoEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipLibres"     Content="Libres"       Click="chipFiltro_Click" Tag="libre"
                        Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipOcupados"   Content="Ocupados"     Click="chipFiltro_Click" Tag="ocupado"
                        Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipManten"     Content="Mantenimiento" Click="chipFiltro_Click" Tag="mantenimiento"
                        Style="{StaticResource BotonChipEstilo}"/>
            </StackPanel>

            <!-- Buscador en el medio -->
            <TextBox x:Name="txtBuscar" Tag="Buscar por número o socio" Grid.Column="2"
                     Style="{StaticResource BuscadorStyle}" Width="250" 
                     TextChanged="txtBuscar_TextChanged"/>
            
        </Grid>

        <!-- ══════════════════ CONTENIDO ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ GRILLA DE LOCKERS ══════ -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Estado vacío (cuando no hay casilleros) -->
                            <StackPanel Grid.Row="0" x:Name="panelVacio"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,80,0,0" Visibility="Collapsed">
                                <TextBlock Text="🗄️" FontSize="64" HorizontalAlignment="Center"
                                           Opacity="0.4"/>
                                <TextBlock Text="No hay casilleros todavía"
                                           FontFamily="Bahnschrift SemiBold"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Usá &quot;Crear en masa&quot; para agregar muchos a la vez"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- WrapPanel donde se generan los casilleros -->
                            <WrapPanel Grid.Row="1" x:Name="panelCasilleros"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════ PANEL DETALLE ══════ -->
            <Border x:Name="panelDetalle" Grid.Column="1" Width="380"
                    Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="lineaSuperior" Grid.Row="0" Background="{StaticResource GreenMain}"/>

                    <!-- Header del panel -->
                    <Grid Grid.Row="1" Margin="22,20,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DETALLE DEL CASILLERO"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="lblNumeroDetalle" Text="#000"
                                       FontFamily="Bahnschrift SemiBold, Consolas"
                                       FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="badgeEstado"
                                CornerRadius="4" Padding="12,6" VerticalAlignment="Center"
                                Background="#0A2A14">
                            <TextBlock x:Name="lblEstadoDetalle" Text="Libre"
                                       FontSize="12" FontWeight="Bold" Foreground="#00E676"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource Border1}"
                            VerticalAlignment="Bottom" Margin="22,12,22,0"/>

                    <!-- Contenido scroll -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource PanelScrollViewerStyle}"
                                  Margin="22,18,22,0">
                        <StackPanel>

                            <!-- ── Sección SOCIO ASIGNADO (solo si está ocupado) ── -->
                            <Border x:Name="panelSocio" Background="#0A1A2A"
                                    BorderBrush="#1A3A5A" BorderThickness="0.5"
                                    CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="ASIGNADO A" Foreground="#6A8AAA"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Grid Margin="0,0,12,0">
                                            <Ellipse Width="56" Height="56">
                                                <Ellipse.Fill><SolidColorBrush Color="#4ADE80"/></Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="50" Height="50">
                                                <Ellipse.Fill>
                                                    <ImageBrush x:Name="imgSocio" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="lblSocioNombre" Text="—"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock x:Name="lblSocioNumero" Text="#0000"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource GreenMain}"/>
                                            <TextBlock x:Name="lblAsignadoDesde" Text="—"
                                                       FontSize="11" Foreground="#6A8AAA"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── Asignar a un socio (solo si libre) ── -->
                            <StackPanel x:Name="panelAsignar" Visibility="Collapsed">
                                <TextBlock Text="ASIGNAR A SOCIO" Style="{StaticResource LabelCampoEstilo}"/>
                                <ComboBox x:Name="cmbSocio"
                                          Style="{StaticResource ComboBoxEstilo}"
                                          VerticalContentAlignment="Center" Height="46">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TextoCombo}" Foreground="{StaticResource TextPrimary}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="ASIGNAR CASILLERO"
                                        Style="{StaticResource BotonPrincipalEstilo}"
                                        Height="44" FontSize="13" Margin="0,0,0,16"
                                        Click="btnAsignar_Click"/>
                            </StackPanel>

                            <!-- ── Datos del casillero ── -->
                            <TextBlock Text="PRECIO MENSUAL" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtPrecio" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtPrecio_PreviewTextInput"/>

                            <TextBlock Text="OBSERVACIONES" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="{StaticResource Bg2}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,14">
                                <TextBox x:Name="txtObservaciones"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource GreenMain}"
                                         FontSize="13" Padding="14,10"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="70" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <Button Content="GUARDAR CAMBIOS"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Height="40" FontSize="12" Margin="0,0,0,18"
                                    Click="btnGuardarCambios_Click"/>

                            <Border Height="1" Background="{StaticResource Border1}" Margin="0,0,0,16"/>

                            <!-- ── Acciones según estado ── -->
                            <StackPanel x:Name="panelAcciones">

                                <!-- Liberar (solo si ocupado) -->
                                <Button x:Name="btnLiberar" Content="🔓  LIBERAR CASILLERO"
                                        Background="#1E1600" Foreground="#D4830A"
                                        BorderThickness="1.5" BorderBrush="#D4830A"
                                        FontWeight="Bold" FontSize="13"
                                        Cursor="Hand" Height="42" Margin="0,0,0,8"
                                        Visibility="Collapsed"
                                        Click="btnLiberar_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Mantenimiento (solo si libre o si en mantenimiento → vuelve a libre) -->
                                <Button x:Name="btnMantenimiento" Background="#1E1600" Foreground="#D4830A"
                                        BorderThickness="1.5" BorderBrush="#D4830A"
                                        FontWeight="Bold" FontSize="12"
                                        Cursor="Hand" Height="40" Margin="0,0,0,8"
                                        Click="btnMantenimiento_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Wrench" Foreground="#D4830A" Height="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="PONER EN MANTENIMIENTO" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnEliminar"
                                        Style="{StaticResource BotonDangerLargoEstilo}"
                                        ToolTip="Eliminar casillero"
                                        Click="btnEliminar_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Trash" Foreground="#FF5555" Height="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="ELIMINAR CASILLERO" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botón cerrar -->
                    <Button Grid.Row="3" Content="CERRAR"
                            Style="{StaticResource BotonDangerLargoEstilo}"
                            Margin="22,12,22,18" Click="btnCerrar_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>

