<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.RutinasPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        d:DesignHeight="768" d:DesignWidth="1280"
        Title="Rutinas">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
            <Style x:Key="BotonAgregarEstilo" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,6,14,6"/>
                <Setter Property="Height" Value="35" />
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,0,6,6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ColorPrimarioHover}"/>
                                    <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                    <Setter TargetName="borde" Property="Background" Value="#0D110D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" Duration="0:0:0.5"
                                            DecelerationRatio="0.6"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="RUTINAS DE ENTRENAMIENTO"
                                FontFamily="Bahnschrift SemiBold, Segoe UI"
                                FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Plantillas de ejercicios para asignar a socios"
                                FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="NUEVA RUTINA" Tag="Plus"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="180" Height="46" 
                        ToolTip="Nueva rutina"
                        Click="btnNuevaRutina_Click"/>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statTotal" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="TOTAL RUTINAS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="ListUl"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statActivas" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ACTIVAS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="CheckCircle"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statEjercicios" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="EJERCICIOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="ListUl"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statSocios" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="SOCIOS ASIGNADOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Users"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- CONTENIDO: lista izq + detalle der + panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LISTA DE RUTINAS ══ -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                        BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <!-- Buscador -->
                    <TextBox x:Name="txtBuscar" Tag="Buscar rutina..." Grid.Row="1"
                             Style="{StaticResource BuscadorStyle}" Width="Auto" Height="42"
                             Margin="12,16,12,12" TextChanged="txtBuscar_TextChanged"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12, 8"
                                    Padding="12,0,12,12" Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" x:Name="panelSinRutinas"
                                            HorizontalAlignment="Center" Margin="0,40,0,0"
                                            Visibility="Collapsed">
                                <fa:ImageAwesome Icon="FileTextOutline" Foreground="{StaticResource GreenMain}"
                                                 Height="80" HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center" Opacity="0.3"/>
                                <TextBlock Text="No hay rutinas cargadas"
                                            FontSize="13" Foreground="{StaticResource TextMuted}"
                                            HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Crea tu primera rutina arriba"
                                            FontSize="11" Foreground="{StaticResource TextMuted}"
                                            HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" x:Name="panelRutinas"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ DETALLE DE LA RUTINA ══ -->
            <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="12"
                        BorderBrush="{StaticResource Border1}" BorderThickness="0.5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <!-- Estado vacio -->
                    <StackPanel Grid.Row="1" Grid.RowSpan="2" x:Name="panelSinSeleccion"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="FileTextOutline" Foreground="{StaticResource GreenMain}" 
                 Height="80" HorizontalAlignment="Center" 
                 VerticalAlignment="Center" Opacity="0.3" Margin="0, 35, 0, 0"/>
                        <TextBlock Text="Seleccioná una rutina"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                    HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Hace click en una de la lista o creá una nueva"
                                    FontSize="12" Foreground="{StaticResource TextMuted}"
                                    HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Detalle -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="panelDetalle" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header del detalle -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="24,18,24,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblDetalleNombre" Text="—"
                                                FontFamily="Bahnschrift SemiBold, Segoe UI"
                                                FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="lblDetalleDuracion" Text="—"
                                                    FontSize="11" Foreground="{StaticResource GreenMain}"
                                                    FontWeight="SemiBold"/>
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="lblDetalleResumen" Text="—"
                                                    FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="lblDetalleAsignaciones" Text="—"
                                                    FontSize="11" Foreground="#00E676"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblDetalleDetalles" Text=""
                                                FontSize="12" Foreground="{StaticResource TextMuted}"
                                                TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="btnAsignar" Content="  ASIGNAR"
                                                Style="{StaticResource BotonGhostEstilo}"
                                                Width="100" Height="34" FontSize="11"
                                                Margin="0,0,8,0"
                                                Tag="Users"
                                                ToolTip="Asignar socio"
                                                Click="btnAsignar_Click"/>
                                    <Button x:Name="btnEditarRutina"
                                                Style="{StaticResource ButtonStyleEditar}"
                                                Cursor="Hand" Margin="0,0,8,0"
                                                ToolTip="Editar rutina"
                                                Click="btnEditarRutina_Click">
                                        <fa:ImageAwesome Icon="Edit" Foreground="{StaticResource ColorEditarCyan}" Height="14"/>
                                    </Button>
                                    <Button x:Name="btnEliminarRutina"
                                                Style="{StaticResource ButtonStyleCancelar}"
                                                Margin="0,0,8,0"
                                                ToolTip="Eliminar rutina"
                                                Click="btnEliminarRutina_Click">
                                        <fa:ImageAwesome Icon="Times" Foreground="#FF5555" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bloques + boton agregar bloque -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                            <StackPanel>
                                <StackPanel x:Name="panelBloques"/>

                                <!-- Boton agregar bloque -->
                                <Button x:Name="btnAgregarBloque" Content="＋ AGREGAR BLOQUE"
                                            Style="{StaticResource BotonGhostEstilo}"
                                            Height="44" FontSize="12"
                                            Margin="0,8,0,16"
                                            ToolTip="Nuevo bloque"
                                            Click="btnAgregarBloque_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

        <!-- ══════════════════ PANEL RUTINA ══════════════════ -->
        <Border x:Name="panelRutina" Grid.Column="2" Width="400"
                Background="{StaticResource Bg1}" CornerRadius="12"
                BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                Margin="14,0,0,0" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#4ADE80" CornerRadius="12,12,0,0"/>
                <StackPanel Grid.Row="1" Margin="22,18,22,12">
                    <TextBlock x:Name="lblTituloPanelRutina" Text="NUEVA RUTINA"
                                FontFamily="Bahnschrift SemiBold"
                                FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Margin="22,8,22,0" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PanelScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtRutNombre" Style="{StaticResource InputEstilo}"/>
                        <TextBlock Text="DETALLES (descripcion, objetivos, etc.)" Style="{StaticResource LabelCampoEstilo}"/>
                        <Border Background="{StaticResource Bg2}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,14">
                            <TextBox x:Name="txtRutDetalles" Background="Transparent"
                                        BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                        CaretBrush="{StaticResource GreenMain}" FontSize="13" Padding="14,10"
                                        AcceptsReturn="True" TextWrapping="Wrap"
                                        Height="80" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <TextBlock Text="DURACIÓN (semanas)" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtRutSemanas" Style="{StaticResource InputEstilo}"
                                    PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                    Text="4"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="3" Margin="22,12,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0"
                                ToolTip=""
                                Click="btnRutCancelar_Click"/>
                    <Button Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0"
                                ToolTip=""
                                Click="btnRutGuardar_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════ PANEL BLOQUE ══════════════════ -->
        <Border x:Name="panelBloque" Grid.Column="2" Width="400"
                Background="{StaticResource Bg1}" CornerRadius="12"
                BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                Margin="14,0,0,0" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource GreenMain}" CornerRadius="12,12,0,0"/>
                <StackPanel Grid.Row="1" Margin="22,18,22,12">
                    <TextBlock x:Name="lblTituloPanelBloque" Text="NUEVO BLOQUE"
                                FontFamily="Bahnschrift SemiBold"
                                FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Margin="22,8,22,0" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PanelScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock Text="NOMBRE DEL BLOQUE *" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtBlqNombre" Style="{StaticResource InputEstilo}"/>
                        <TextBlock Text="ORDEN" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtBlqOrden" Style="{StaticResource InputEstilo}"
                                    PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                    Text="1"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="3" Margin="22,12,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0"
                                ToolTip=""
                                Click="btnBlqCancelar_Click"/>
                    <Button Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0"
                                ToolTip=""
                                Click="btnBlqGuardar_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════ PANEL EJERCICIO ══════════════════ -->
        <Border x:Name="panelEjercicio" Grid.Column="2" Width="400"
                Background="{StaticResource Bg1}" CornerRadius="12"
                BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                Margin="14,0,0,0" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource GreenMain}" CornerRadius="12,12,0,0"/>
                <StackPanel Grid.Row="1" Margin="22,18,22,12">
                    <TextBlock x:Name="lblTituloPanelEj" Text="NUEVO EJERCICIO"
                                FontFamily="Bahnschrift SemiBold"
                                FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Margin="22,8,22,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NOMBRE DEL EJERCICIO *" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtEjNombre" Style="{StaticResource InputEstilo}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="SERIES" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtEjSeries" Style="{StaticResource InputEstilo}"
                                            PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="REPS" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtEjReps" Style="{StaticResource InputEstilo}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="PESO" Style="{StaticResource LabelCampoEstilo}"/>
                                <TextBox x:Name="txtEjPeso" Style="{StaticResource InputEstilo}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="DESCANSO (segundos)" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtEjDescanso" Style="{StaticResource InputEstilo}"
                                    PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>
                        <TextBlock Text="LINK DE VIDEO (YouTube, etc.)" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtEjVideo" Style="{StaticResource InputEstilo}"/>
                        <TextBlock Text="NOTAS" Style="{StaticResource LabelCampoEstilo}"/>
                        <Border Background="{StaticResource Bg2}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,14">
                            <TextBox x:Name="txtEjNotas" Background="Transparent"
                                        BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                        CaretBrush="{StaticResource GreenMain}" FontSize="13" Padding="14,10"
                                        AcceptsReturn="True" TextWrapping="Wrap"
                                        Height="60" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <TextBlock Text="ORDEN" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtEjOrden" Style="{StaticResource InputEstilo}"
                                    PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                    Text="1"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="3" Margin="22,12,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0"
                                ToolTip=""
                                Click="btnEjCancelar_Click"/>
                    <Button Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0"
                                ToolTip=""
                                Click="btnEjGuardar_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════ PANEL ASIGNAR ══════════════════ -->
        <Border x:Name="panelAsignar" Grid.Column="2" Width="400"
                Background="{StaticResource Bg1}" CornerRadius="12"
                BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                Margin="14,0,0,0" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource GreenMain}" CornerRadius="12,12,0,0"/>
                <StackPanel Grid.Row="1" Margin="22,18,22,12">
                    <TextBlock Text="ASIGNAR A SOCIO"
                                FontFamily="Bahnschrift SemiBold"
                                FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="lblAsignarRutina" Text=""
                                FontSize="11" Foreground="{StaticResource GreenMain}" Margin="0,4,0,0"/>
                    <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Margin="22,8,22,0" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource PanelScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock Text="SOCIO" Style="{StaticResource LabelCampoEstilo}"/>
                        <ComboBox x:Name="cmbAsignarSocio" Style="{StaticResource ComboBoxEstilo}"
                                   IsTextSearchEnabled="True"
                                  DisplayMemberPath="TextoCombo"/>
                        <Button Content="＋ ASIGNAR"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Height="40" Margin="0,6,0,16"
                                    ToolTip="Asignar"
                                    Click="btnConfirmarAsignar_Click"/>
                        <Border Height="1" Background="{StaticResource Border1}" Margin="0,0,0,12"/>
                        <TextBlock Text="ASIGNACIONES ACTUALES"
                                    FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                    Margin="0,0,0,8"/>
                        <StackPanel x:Name="panelAsignaciones"/>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="3" Content="CERRAR"
                            Style="{StaticResource BotonDangerLargoEstilo}"
                            Height="40" Margin="22,12,22,18"
                            ToolTip="Cerrar"
                            Click="btnCerrarAsignar_Click"/>
            </Grid>
        </Border>
        </Grid>

    </Grid>
</Page>

