<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.RutinasPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        d:DesignHeight="768" d:DesignWidth="1360"
        Title="Rutinas">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="BotonAgregarEstilo" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,6,14,6"/>
                <Setter Property="Height" Value="35" />
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,0,6,6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ColorPrimarioHover}"/>
                                    <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                    <Setter TargetName="borde" Property="Background" Value="#0D110D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="RUTINAS DE ENTRENAMIENTO"
                                FontFamily="Bahnschrift SemiBold, Segoe UI"
                                FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Plantillas de ejercicios para asignar a socios"
                                FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="NUEVA RUTINA" Tag="Plus"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="180" Height="46"
                        ToolTip="Nueva rutina"
                        Click="btnNuevaRutina_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statTotal" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="TOTAL RUTINAS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="ListUl"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statActivas" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ACTIVAS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="CheckCircle"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statEjercicios" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="EJERCICIOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="ListUl"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" CornerRadius="10"
                        Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statSocios" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="SOCIOS ASIGNADOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Users"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                        BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <TextBox x:Name="txtBuscar" Tag="Buscar rutina..." Grid.Row="1"
                             Style="{StaticResource BuscadorStyle}" Width="Auto" Height="42"
                             Margin="12,12,12,10" TextChanged="txtBuscar_TextChanged"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,6"
                                    Padding="12,0,12,10" Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" x:Name="panelSinRutinas"
                                            HorizontalAlignment="Center" Margin="0,40,0,0"
                                            Visibility="Collapsed">
                                <fa:ImageAwesome Icon="FileTextOutline" Foreground="{StaticResource GreenMain}"
                                                 Height="80" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" Opacity="0.3"/>
                                <TextBlock Text="No hay rutinas cargadas"
                                            FontSize="13" Foreground="{StaticResource TextMuted}"
                                            HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Crea tu primera rutina arriba"
                                            FontSize="11" Foreground="{StaticResource TextMuted}"
                                            HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" x:Name="panelRutinas"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="12"
                        BorderBrush="{StaticResource Border1}" BorderThickness="0.5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" x:Name="panelSinSeleccion"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="FileTextOutline" Foreground="{StaticResource GreenMain}"
                                 Height="80" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Opacity="0.3" Margin="0, 35, 0, 0"/>
                        <TextBlock Text="Seleccioná una rutina"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                    HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Hace click en una de la lista o creá una nueva"
                                    FontSize="12" Foreground="{StaticResource TextMuted}"
                                    HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1" x:Name="panelDetalle" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="24,18,24,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblDetalleNombre" Text="—"
                                                FontFamily="Bahnschrift SemiBold, Segoe UI"
                                                FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="lblDetalleDuracion" Text="—"
                                                    FontSize="11" Foreground="{StaticResource GreenMain}"
                                                    FontWeight="SemiBold"/>
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="lblDetalleResumen" Text="—"
                                                    FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="lblDetalleAsignaciones" Text="—"
                                                    FontSize="11" Foreground="#00E676"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblDetalleDetalles" Text=""
                                                FontSize="12" Foreground="{StaticResource TextMuted}"
                                                TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="btnAsignar" Content="  ASIGNAR"
                                                Style="{StaticResource BotonGhostEstilo}"
                                                Width="100" Height="34" FontSize="11"
                                                Margin="0,0,8,0"
                                                Tag="Users"
                                                ToolTip="Asignar socio"
                                                Click="btnAsignar_Click"/>
                                    <Button x:Name="btnEditarRutina"
                                                Style="{StaticResource ButtonStyleEditar}"
                                                Cursor="Hand" Margin="0,0,8,0"
                                                ToolTip="Editar rutina"
                                                Click="btnEditarRutina_Click">
                                        <fa:ImageAwesome Icon="Edit" Foreground="{StaticResource ColorEditarCyan}" Height="14"/>
                                    </Button>
                                    <Button x:Name="btnEliminarRutina"
                                                Style="{StaticResource ButtonStyleCancelar}"
                                                Margin="0,0,8,0"
                                                ToolTip="Eliminar rutina"
                                                Click="btnEliminarRutina_Click">
                                        <fa:ImageAwesome Icon="Times" Foreground="#FF5555" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                            <StackPanel>
                                <StackPanel x:Name="panelBloques"/>

                                <Button x:Name="btnAgregarBloque" Content="＋ AGREGAR BLOQUE"
                                            Style="{StaticResource BotonGhostEstilo}"
                                            Height="44" FontSize="12"
                                            Margin="0,8,0,16"
                                            ToolTip="Nuevo bloque"
                                            Click="btnAgregarBloque_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
