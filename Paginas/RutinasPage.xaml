<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.RutinasPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
        mc:Ignorable="d"
        d:DesignHeight="768" d:DesignWidth="1280"
        Title="Rutinas">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#4A4A7A"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" Duration="0:0:0.5"
                                            DecelerationRatio="0.6"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6B35" Offset="0"/>
                            <GradientStop Color="#A78BFA" Offset="0.5"/>
                            <GradientStop Color="#00CFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="RUTINAS DE ENTRENAMIENTO"
                                FontFamily="Bahnschrift SemiBold, Segoe UI"
                                FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Plantillas de ejercicios para asignar a socios"
                                FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="＋ NUEVA RUTINA"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Width="180" Height="46" Click="btnNuevaRutina_Click"/>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                        Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statTotal" Text="—" FontFamily="Bahnschrift SemiBold"
                                FontSize="26" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="TOTAL RUTINAS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="10"
                        Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statActivas" Text="—" FontFamily="Bahnschrift SemiBold"
                                FontSize="26" FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text="ACTIVAS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="4,0,4,0" CornerRadius="10"
                        Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statEjercicios" Text="—" FontFamily="Bahnschrift SemiBold"
                                FontSize="26" FontWeight="Bold" Foreground="#FF6B35"/>
                    <TextBlock Text="EJERCICIOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="10"
                        Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statSocios" Text="—" FontFamily="Bahnschrift SemiBold"
                                FontSize="26" FontWeight="Bold" Foreground="#00CFFF"/>
                    <TextBlock Text="SOCIOS ASIGNADOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CONTENIDO: lista izq + detalle der -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LISTA DE RUTINAS ══ -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                        BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Buscador -->
                    <TextBox x:Name="txtBuscar" Tag="Buscar rutina..." Grid.Row="1"
                             Style="{StaticResource BuscadorStyle}" Width="Auto" Height="42"
                             Margin="12,12,12,0" TextChanged="txtBuscar_TextChanged"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                    Padding="12,4,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" x:Name="panelSinRutinas"
                                            HorizontalAlignment="Center" Margin="0,40,0,0"
                                            Visibility="Collapsed">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="No hay rutinas cargadas"
                                            FontSize="13" Foreground="#6A6A9A"
                                            HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Crea tu primera rutina arriba"
                                            FontSize="11" Foreground="#4A4A7A"
                                            HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" x:Name="panelRutinas"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ DETALLE DE LA RUTINA ══ -->
            <Border Grid.Column="1" Background="#12121E" CornerRadius="12"
                        BorderBrush="#252540" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Estado vacio -->
                    <StackPanel Grid.Row="1" Grid.RowSpan="2" x:Name="panelSinSeleccion"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="80" Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock Text="Seleccioná una rutina"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="18" FontWeight="Bold" Foreground="#6A6A9A"
                                    HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Hace click en una de la lista o creá una nueva"
                                    FontSize="12" Foreground="#4A4A7A"
                                    HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Detalle -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="panelDetalle" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header del detalle -->
                        <Border Grid.Row="0" BorderBrush="#252540" BorderThickness="0,0,0,1" Padding="24,18,24,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblDetalleNombre" Text="—"
                                                FontFamily="Bahnschrift SemiBold, Segoe UI"
                                                FontSize="20" FontWeight="Bold" Foreground="#E8E8FF"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="lblDetalleDuracion" Text="—"
                                                    FontSize="11" Foreground="#A78BFA"
                                                    FontWeight="SemiBold"/>
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="#3A3A5C"/>
                                        <TextBlock x:Name="lblDetalleResumen" Text="—"
                                                    FontSize="11" Foreground="#6A6A9A"/>
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="#3A3A5C"/>
                                        <TextBlock x:Name="lblDetalleAsignaciones" Text="—"
                                                    FontSize="11" Foreground="#00E676"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblDetalleDetalles" Text=""
                                                FontSize="12" Foreground="#A0A0C0"
                                                TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="btnAsignar" Content="👥  ASIGNAR"
                                                Background="#0A1A2A" Foreground="#00CFFF"
                                                BorderBrush="#00CFFF" BorderThickness="1"
                                                Width="110" Height="34" FontSize="11" FontWeight="Bold"
                                                Cursor="Hand" Margin="0,0,8,0"
                                                Click="btnAsignar_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="btnEditarRutina" Content="✏  EDITAR"
                                                Background="#1A1A30" Foreground="#A78BFA"
                                                BorderBrush="#A78BFA" BorderThickness="1"
                                                Width="100" Height="34" FontSize="11" FontWeight="Bold"
                                                Cursor="Hand" Margin="0,0,8,0"
                                                Click="btnEditarRutina_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="btnEliminarRutina" Content="🗑"
                                                Background="#1A0A0A" Foreground="#FF5555"
                                                BorderBrush="#5A1A1A" BorderThickness="1"
                                                Width="34" Height="34" FontSize="13" FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="btnEliminarRutina_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bloques + boton agregar bloque -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                            <StackPanel>
                                <StackPanel x:Name="panelBloques"/>

                                <!-- Boton agregar bloque -->
                                <Button x:Name="btnAgregarBloque" Content="＋ AGREGAR BLOQUE"
                                            Background="Transparent" Foreground="#A78BFA"
                                            BorderBrush="#A78BFA" BorderThickness="1.5"
                                            Height="44" FontSize="12" FontWeight="Bold"
                                            Cursor="Hand" Margin="0,8,0,16"
                                            Click="btnAgregarBloque_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ MODAL CRUD RUTINA ══════════════════ -->
        <Border x:Name="modalRutina" Background="#CC000000" Visibility="Collapsed">
            <Border Width="440" Background="#12121E" CornerRadius="12"
                        BorderBrush="#252540" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24,22,24,12">
                        <TextBlock x:Name="lblTituloModalRutina" Text="NUEVA RUTINA"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="16" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="24,8,24,0">
                        <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtRutNombre" Style="{StaticResource InputEstilo}"/>

                        <TextBlock Text="DETALLES (descripcion, objetivos, etc.)" Style="{StaticResource LabelCampoEstilo}"/>
                        <Border Background="#16162A" CornerRadius="10"
                                    BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                            <TextBox x:Name="txtRutDetalles" Background="Transparent"
                                        BorderThickness="0" Foreground="#E8E8FF"
                                        CaretBrush="#A78BFA" FontSize="13" Padding="14,10"
                                        AcceptsReturn="True" TextWrapping="Wrap"
                                        Height="80" VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock Text="DURACIÓN (semanas)" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtRutSemanas" Style="{StaticResource InputEstilo}"
                                    PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                    Text="4"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="24,16,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                    Style="{StaticResource BotonCerrarEstilo}"
                                    Margin="0,0,8,0" Click="btnRutCancelar_Click"/>
                        <Button Grid.Column="1" Content="GUARDAR"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Margin="8,0,0,0" Click="btnRutGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ══════════════════ MODAL CRUD BLOQUE ══════════════════ -->
        <Border x:Name="modalBloque" Background="#CC000000" Visibility="Collapsed">
            <Border Width="380" Background="#12121E" CornerRadius="12"
                        BorderBrush="#252540" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#A78BFA"/>
                    <StackPanel Grid.Row="1" Margin="22,22,22,12">
                        <TextBlock x:Name="lblTituloModalBloque" Text="NUEVO BLOQUE"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="22,8,22,0">
                        <TextBlock Text="NOMBRE DEL BLOQUE *" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtBlqNombre" Style="{StaticResource InputEstilo}"/>
                        <TextBlock Text="ORDEN" Style="{StaticResource LabelCampoEstilo}"/>
                        <TextBox x:Name="txtBlqOrden" Style="{StaticResource InputEstilo}"
                                    PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                    Text="1"/>
                    </StackPanel>
                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                    Style="{StaticResource BotonCerrarEstilo}"
                                    Margin="0,0,8,0" Click="btnBlqCancelar_Click"/>
                        <Button Grid.Column="1" Content="GUARDAR"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Margin="8,0,0,0" Click="btnBlqGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ══════════════════ MODAL CRUD EJERCICIO ══════════════════ -->
        <Border x:Name="modalEjercicio" Background="#CC000000" Visibility="Collapsed">
            <Border Width="460" Background="#12121E" CornerRadius="12"
                        BorderBrush="#252540" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxHeight="640" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF6B35"/>
                    <StackPanel Grid.Row="1" Margin="22,22,22,12">
                        <TextBlock x:Name="lblTituloModalEj" Text="NUEVO EJERCICIO"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Margin="22,8,22,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="NOMBRE DEL EJERCICIO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtEjNombre" Style="{StaticResource InputEstilo}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="SERIES" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtEjSeries" Style="{StaticResource InputEstilo}"
                                                PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="REPS" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtEjReps" Style="{StaticResource InputEstilo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="PESO" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtEjPeso" Style="{StaticResource InputEstilo}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="DESCANSO (segundos)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtEjDescanso" Style="{StaticResource InputEstilo}"
                                        PreviewTextInput="txtSoloNumeros_PreviewTextInput"/>

                            <TextBlock Text="LINK DE VIDEO (YouTube, etc.)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtEjVideo" Style="{StaticResource InputEstilo}"/>

                            <TextBlock Text="NOTAS" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10"
                                        BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                <TextBox x:Name="txtEjNotas" Background="Transparent"
                                            BorderThickness="0" Foreground="#E8E8FF"
                                            CaretBrush="#FF6B35" FontSize="13" Padding="14,10"
                                            AcceptsReturn="True" TextWrapping="Wrap"
                                            Height="60" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <TextBlock Text="ORDEN" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtEjOrden" Style="{StaticResource InputEstilo}"
                                        PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                        Text="1"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                    Style="{StaticResource BotonCerrarEstilo}"
                                    Margin="0,0,8,0" Click="btnEjCancelar_Click"/>
                        <Button Grid.Column="1" Content="GUARDAR"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Margin="8,0,0,0" Click="btnEjGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ══════════════════ MODAL ASIGNAR ══════════════════ -->
        <Border x:Name="modalAsignar" Background="#CC000000" Visibility="Collapsed">
            <Border Width="440" Background="#12121E" CornerRadius="12"
                        BorderBrush="#252540" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxHeight="600" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#00CFFF"/>
                    <StackPanel Grid.Row="1" Margin="24,22,24,12">
                        <TextBlock Text="ASIGNAR A SOCIO"
                                    FontFamily="Bahnschrift SemiBold"
                                    FontSize="16" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <TextBlock x:Name="lblAsignarRutina" Text=""
                                    FontSize="11" Foreground="#A78BFA" Margin="0,4,0,0"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="24,8,24,12">
                        <TextBlock Text="SOCIO" Style="{StaticResource LabelCampoEstilo}"/>
                        <Border Background="#16162A" CornerRadius="10" Height="46"
                                    BorderBrush="#252540" BorderThickness="1.5">
                            <ComboBox x:Name="cmbAsignarSocio" BorderThickness="0"
                                        Background="Transparent" Foreground="#E8E8FF"
                                        VerticalContentAlignment="Center"
                                        FontSize="13" Padding="10,0" IsEditable="True"
                                        IsTextSearchEnabled="True"
                                        DisplayMemberPath="TextoCombo">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                </ComboBox.Resources>
                            </ComboBox>
                        </Border>
                        <Button Content="＋ ASIGNAR"
                                    Style="{StaticResource BotonPrincipalEstilo}"
                                    Height="40" Margin="0,12,0,0"
                                    Click="btnConfirmarAsignar_Click"/>
                    </StackPanel>
                    <Border Grid.Row="3" BorderBrush="#252540" BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">
                            <StackPanel x:Name="panelAsignaciones"/>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="4" Content="CERRAR"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Height="40" Margin="24,12,24,18"
                                Click="btnCerrarAsignar_Click"/>
                </Grid>
            </Border>
        </Border>

    </Grid>
</Page>
