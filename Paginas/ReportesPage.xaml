<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1360"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      Title="Reportes">

    <Page.Background>
        <SolidColorBrush Color="#080A08"/>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tab Button estilo -->
            <Style x:Key="TabBtnStyle" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="#5A6B5A"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Padding"         Value="16,10"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="borde" Property="Background" Value="#16201A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab Button Activo -->
            <Style x:Key="TabBtnActiveStyle" TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                <Setter Property="Foreground"  Value="#00CFFF"/>
                <Setter Property="BorderBrush" Value="#00CFFF"/>
            </Style>

            <!-- Card de total -->
            <Style x:Key="CardTotalStyle" TargetType="Border">
                <Setter Property="Background"     Value="#0F1A0F"/>
                <Setter Property="BorderBrush"    Value="#1E3020"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"   Value="10"/>
                <Setter Property="Padding"        Value="18,14"/>
            </Style>

            <!-- Botón exportar -->
            <Style x:Key="BtnExportStyle" TargetType="Button">
                <Setter Property="Background"      Value="#0F1A0F"/>
                <Setter Property="Foreground"      Value="#9FD96E"/>
                <Setter Property="BorderBrush"     Value="#2A4A1A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="14,8"/>
                <Setter Property="FontSize"        Value="11"/>
                <Setter Property="FontWeight"      Value="Bold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Margin"          Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="borde" Property="Background" Value="#162010"/>
                                    <Setter TargetName="borde" Property="BorderBrush" Value="#7AC943"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fila deuda vencida -->
            <Style x:Key="FilaDeudaEstilo" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EsVencida}" Value="True">
                        <Setter Property="Background" Value="#1A0808"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding EsVencida}" Value="False">
                        <Setter Property="Background" Value="#1A1208"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="REPORTES" FontSize="22" FontWeight="Bold"
                       Foreground="#E8F0E8"/>
            <TextBlock Text="Análisis financiero, sueldos y estado de membresías"
                       FontSize="12" Foreground="#5A6B5A" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tabs de navegación -->
        <Border Grid.Row="1" BorderBrush="#1E3020" BorderThickness="0,0,0,1" Margin="24,14,24,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabIngresos" Content="INGRESOS Y GANANCIAS"
                        Style="{StaticResource TabBtnActiveStyle}"
                        Click="TabIngresos_Click"/>
                <Button x:Name="btnTabSueldos" Content="SUELDOS DOCENTES"
                        Style="{StaticResource TabBtnStyle}"
                        Visibility="Collapsed"
                        Click="TabSueldos_Click"/>
                <Button x:Name="btnTabDeudas" Content="SOCIOS CON DEUDA"
                        Style="{StaticResource TabBtnStyle}"
                        Visibility="Collapsed"
                        Click="TabDeudas_Click"/>
                <Button x:Name="btnTabMisVentas" Content="MIS VENTAS"
                        Style="{StaticResource TabBtnStyle}"
                        Click="TabMisVentas_Click"/>
            </StackPanel>
        </Border>

        <!-- Contenido de tabs -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,14,24,16" Style="{StaticResource PanelScrollViewerStyle}">
            <Grid>

                <!-- ═══════════════════════════════════════════════
                     TAB 1: INGRESOS Y GANANCIAS (solo admin)
                ═══════════════════════════════════════════════ -->
                <StackPanel x:Name="panelIngresos" Visibility="Visible">

                    <!-- Filtros -->
                    <Border Background="#0A120A" BorderBrush="#1E3020" BorderThickness="1"
                            CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="DESDE" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpDesde" Width="130"
                                            Style="{StaticResource DatePickerEstilo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="HASTA" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpHasta" Width="130"
                                            Style="{StaticResource DatePickerEstilo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="ACTIVIDAD" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbActividad" Width="140"
                                          Style="{StaticResource ComboBoxEstilo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="MÉTODO DE PAGO" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbMetodoPago" Width="130"
                                          Style="{StaticResource ComboBoxEstilo}">
                                    <ComboBoxItem Content="Todos" Tag=""/>
                                    <ComboBoxItem Content="Efectivo" Tag="efectivo"/>
                                    <ComboBoxItem Content="Tarjeta" Tag="tarjeta"/>
                                    <ComboBoxItem Content="Transferencia" Tag="transferencia"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,12,0">
                                <TextBlock Text="INSTRUCTOR" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbInstructor" Width="140"
                                          Style="{StaticResource ComboBoxEstilo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                <Button x:Name="btnFiltrar" Click="btnFiltrar_Click"
                                        Width="160" Height="44" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="borderBtn" CornerRadius="10" BorderThickness="0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00CFFF" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                                                               VerticalAlignment="Center" Margin="14,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="CONSULTAR"
                                                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="#0A0A14"
                                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="borderBtn" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cards de totales -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardTotalStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="INGRESOS TOTALES" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A"/>
                                <TextBlock x:Name="lblTotalIngresos" Text="$0.00"
                                           FontSize="28" FontWeight="Bold" Foreground="#00CFFF"
                                           Margin="0,4,0,0"/>
                                <TextBlock x:Name="lblCantIngresos" Text="0 movimientos"
                                           FontSize="11" Foreground="#5A6B5A"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardTotalStyle}" Margin="0,0,8,0"
                                BorderBrush="#3A1010">
                            <StackPanel>
                                <TextBlock Text="EGRESOS TOTALES" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A"/>
                                <TextBlock x:Name="lblTotalEgresos" Text="$0.00"
                                           FontSize="28" FontWeight="Bold" Foreground="#FF5555"
                                           Margin="0,4,0,0"/>
                                <TextBlock x:Name="lblCantEgresos" Text="0 movimientos"
                                           FontSize="11" Foreground="#5A6B5A"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardTotalStyle}"
                                BorderBrush="#1A3A1A">
                            <StackPanel>
                                <TextBlock Text="BALANCE" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A"/>
                                <TextBlock x:Name="lblBalance" Text="$0.00"
                                           FontSize="28" FontWeight="Bold" Foreground="#7AC943"
                                           Margin="0,4,0,0"/>
                                <TextBlock x:Name="lblBalanceDesc" Text="del período"
                                           FontSize="11" Foreground="#5A6B5A"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Gráfico de barras — Ingresos por mes -->
                    <Border Background="#0A120A" BorderBrush="#1E3020" BorderThickness="1"
                            CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblAnioGrafico" Text="INGRESOS POR MES — 2026"
                                           FontSize="12" FontWeight="Bold" Foreground="#E8F0E8"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Border Width="10" Height="10" Background="#00CFFF" CornerRadius="2" Margin="0,0,4,0"/>
                                        <TextBlock Text="Ingresos" FontSize="10" Foreground="#A0B0A0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" Background="#A78BFA" CornerRadius="2" Margin="0,0,4,0"/>
                                        <TextBlock Text="Egresos" FontSize="10" Foreground="#A0B0A0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="gridGraficoMeses" Height="180" VerticalAlignment="Bottom"/>
                            <Grid x:Name="gridGraficoLabels" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de exportación -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="📄 EXPORTAR PDF" Style="{StaticResource BtnExportStyle}"
                                Click="btnExportarPdf_Click"/>
                        <Button Content="📊 EXPORTAR EXCEL" Style="{StaticResource BtnExportStyle}"
                                Click="btnExportarExcel_Click"/>
                    </StackPanel>

                    <!-- DataGrid movimientos -->
                    <DataGrid x:Name="dgMovimientos"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"                              MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA"          Binding="{Binding FechaTexto}"     Width="90"/>
                            <DataGridTextColumn Header="CONCEPTO"       Binding="{Binding Concepto}"       Width="*"/>
                            <DataGridTextColumn Header="TIPO"           Binding="{Binding Tipo}"           Width="80"/>
                            <DataGridTextColumn Header="ACTIVIDAD"      Binding="{Binding ActividadNombre}" Width="140"/>
                            <DataGridTextColumn Header="REGISTRADO POR" Binding="{Binding RegistradoPor}"  Width="130"/>
                            <DataGridTextColumn Header="INSTRUCTOR"     Binding="{Binding InstructorNombre}" Width="120"/>
                            <DataGridTextColumn Header="MÉTODO"         Binding="{Binding MetodoPago}"     Width="100"/>
                            <DataGridTextColumn Header="MONTO"          Binding="{Binding MontoTexto}"     Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="lblAviso500" Text="⚠ Se muestran los primeros 500 movimientos del período."
                               FontSize="11" Foreground="#A0C070" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════
                     TAB 2: SUELDOS DE DOCENTES (solo admin)
                ═══════════════════════════════════════════════ -->
                <StackPanel x:Name="panelSueldos" Visibility="Collapsed">

                    <Border Background="#0A120A" BorderBrush="#1E3020" BorderThickness="1"
                            CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="DESDE" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpSueldoDesde" Width="130"
                                            Style="{StaticResource DatePickerEstilo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="HASTA" FontSize="10" FontWeight="Bold"
                                           Foreground="#5A6B5A" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpSueldoHasta" Width="130"
                                            Style="{StaticResource DatePickerEstilo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <Button x:Name="btnConsultarSueldos" Click="btnConsultarSueldos_Click"
                                        Width="160" Height="44" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="borderBtnS" CornerRadius="10" BorderThickness="0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00CFFF" Offset="0"/>
                                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                                                               VerticalAlignment="Center" Margin="14,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="CONSULTAR"
                                                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="#0A0A14"
                                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="borderBtnS" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Total sueldos card -->
                    <Border Style="{StaticResource CardTotalStyle}" Margin="0,0,0,14"
                            HorizontalAlignment="Left" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="TOTAL A PAGAR" FontSize="10" FontWeight="Bold"
                                       Foreground="#5A6B5A"/>
                            <TextBlock x:Name="lblTotalSueldos" Text="$0.00"
                                       FontSize="28" FontWeight="Bold" Foreground="#A78BFA"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="📄 EXPORTAR PDF" Style="{StaticResource BtnExportStyle}"
                                Click="btnExportarSueldosPdf_Click"/>
                        <Button Content="📊 EXPORTAR EXCEL" Style="{StaticResource BtnExportStyle}"
                                Click="btnExportarSueldosExcel_Click"/>
                    </StackPanel>

                    <!-- ── PANEL TARIFA GLOBAL (SDD_Fix_Sueldos_Docentes) ────────── -->
                    <Border Background="#12121E" CornerRadius="10"
                            BorderBrush="#252540" BorderThickness="1"
                            Padding="20,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="💰" FontSize="20" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TARIFA POR HORA — TODOS LOS INSTRUCTORES"
                                               FontFamily="Bahnschrift SemiBold"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#A78BFA"/>
                                    <TextBlock Text="Un solo valor aplicado a todos. Cambiarlo afecta el cálculo de todos."
                                               FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#16162A" CornerRadius="10"
                                    BorderBrush="#A78BFA" BorderThickness="1.5"
                                    Height="46" Width="220" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="$" FontSize="16"
                                               FontWeight="Bold" Foreground="#A78BFA"
                                               VerticalAlignment="Center" Margin="14,0,6,0"/>
                                    <TextBox x:Name="txtTarifaGlobal"
                                             Grid.Column="1"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="#E8E8FF" CaretBrush="#A78BFA"
                                             FontFamily="Consolas" FontSize="16"
                                             FontWeight="SemiBold"
                                             VerticalContentAlignment="Center"
                                             KeyDown="txtTarifaGlobal_KeyDown"/>
                                    <TextBlock Grid.Column="2" Text="/h" FontSize="12"
                                               Foreground="#6A6A9A"
                                               VerticalAlignment="Center" Margin="4,0,12,0"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2" x:Name="btnGuardarTarifa"
                                    Content="✓ APLICAR A TODOS"
                                    Click="btnGuardarTarifa_Click"
                                    Background="#1A1440" Foreground="#A78BFA"
                                    BorderBrush="#A78BFA" BorderThickness="1.5"
                                    FontSize="11" FontWeight="Bold"
                                    Cursor="Hand" Margin="12,0,0,0" Height="46" Padding="16,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── ALERTA AGUINALDO (jun/dic) ─────────────────────────── -->
                    <Border x:Name="panelAlertaAguinaldo" Visibility="Collapsed"
                            Background="#2A1F00" CornerRadius="10"
                            BorderBrush="#FFA726" BorderThickness="1"
                            Padding="16,12" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="18" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CORRESPONDE PAGAR AGUINALDO ESTE MES"
                                           FontFamily="Bahnschrift SemiBold"
                                           FontSize="12" FontWeight="Bold" Foreground="#FFA726"/>
                                <TextBlock Text="Recordá liquidar el aguinaldo de cada instructor. El sistema no lo calcula automáticamente."
                                           FontSize="11" Foreground="#A0804A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid: solo lectura, tarifa viene del global -->
                    <DataGrid x:Name="dgSueldos"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INSTRUCTOR"       Binding="{Binding NombreCompleto}"    Width="*"/>
                            <DataGridTextColumn Header="ACTIVIDAD"        Binding="{Binding ActividadNombre}"   Width="120"/>
                            <DataGridTextColumn Header="DÍAS"             Binding="{Binding DiasTrabajTexto}"   Width="70"/>
                            <DataGridTextColumn Header="HORAS"            Binding="{Binding HorasTexto}"        Width="80"/>
                            <DataGridTextColumn Header="TARIFA/H"         Binding="{Binding TarifaTexto}"       Width="110"/>
                            <DataGridTextColumn Header="SUELDO ESTIMADO"  Binding="{Binding SueldoTexto}"       Width="140"/>
                            <DataGridTextColumn Header="INGRESOS GENER."  Binding="{Binding IngresosGenerTexto}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════
                     TAB 3: SOCIOS CON DEUDA (solo admin)
                ═══════════════════════════════════════════════ -->
                <StackPanel x:Name="panelDeudas" Visibility="Collapsed">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="📄 EXPORTAR PDF" Style="{StaticResource BtnExportStyle}"
                                Click="btnExportarDeudasPdf_Click"/>
                        <Button Content="🔄 ACTUALIZAR" Style="{StaticResource BtnExportStyle}"
                                Click="btnActualizarDeudas_Click"/>
                    </StackPanel>

                    <!-- Vencidas -->
                    <Border Background="#180808" BorderBrush="#3A1010" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="MEMBRESÍAS VENCIDAS" FontSize="13" FontWeight="Bold"
                                           Foreground="#FF5555"/>
                                <Border Background="#3A1010" CornerRadius="10" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock x:Name="lblCountVencidas" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#FF8080"/>
                                </Border>
                            </StackPanel>
                            <DataGrid x:Name="dgVencidas"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"          Binding="{Binding NumeroSocioTexto}"  Width="70"/>
                                    <DataGridTextColumn Header="SOCIO"      Binding="{Binding NombreCompleto}"    Width="*"/>
                                    <DataGridTextColumn Header="ACTIVIDAD"  Binding="{Binding ActividadNombre}"   Width="120"/>
                                    <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding VencimientoTexto}" Width="100"/>
                                    <DataGridTextColumn Header="DÍAS VENCIDA" Binding="{Binding DiasVencida}"     Width="100"/>
                                    <DataGridTextColumn Header="TELÉFONO"  Binding="{Binding Telefono}"           Width="120"/>
                                    <DataGridTemplateColumn Header="AVISAR" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="💬 WhatsApp" Tag="{Binding}"
                                                        Style="{StaticResource BtnExportStyle}"
                                                        Margin="2" FontSize="10"
                                                        Click="btnWhatsAppDeuda_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Próximas a vencer -->
                    <Border Background="#181008" BorderBrush="#3A2A10" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="PRÓXIMAS A VENCER (7 días)" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFA000"/>
                                <Border Background="#3A2A10" CornerRadius="10" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock x:Name="lblCountProximas" Text="0"
                                               FontSize="11" FontWeight="Bold" Foreground="#FFB840"/>
                                </Border>
                            </StackPanel>
                            <DataGrid x:Name="dgProximas"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"           Binding="{Binding NumeroSocioTexto}"  Width="70"/>
                                    <DataGridTextColumn Header="SOCIO"       Binding="{Binding NombreCompleto}"    Width="*"/>
                                    <DataGridTextColumn Header="ACTIVIDAD"   Binding="{Binding ActividadNombre}"   Width="120"/>
                                    <DataGridTextColumn Header="VENCIMIENTO"  Binding="{Binding VencimientoTexto}" Width="100"/>
                                    <DataGridTextColumn Header="DÍAS PARA VENCER" Binding="{Binding DiasParaVencer}" Width="120"/>
                                    <DataGridTextColumn Header="TELÉFONO"   Binding="{Binding Telefono}"           Width="120"/>
                                    <DataGridTemplateColumn Header="AVISAR" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="💬 WhatsApp" Tag="{Binding}"
                                                        Style="{StaticResource BtnExportStyle}"
                                                        Margin="2" FontSize="10"
                                                        Click="btnWhatsAppDeuda_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════
                     TAB 4: MIS VENTAS (todos los roles)
                ═══════════════════════════════════════════════ -->
                <StackPanel x:Name="panelMisVentas" Visibility="Collapsed">

                    <!-- Card resumen -->
                    <Border Style="{StaticResource CardTotalStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="lblResumenVentas"
                                       Text="Hoy vendiste 0 veces por un total de $0.00"
                                       FontSize="16" FontWeight="Bold" Foreground="#E8F0E8"/>
                            <TextBlock x:Name="lblFechaHoy"
                                       FontSize="11" Foreground="#5A6B5A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🔄 ACTUALIZAR" Width="120" HorizontalAlignment="Left"
                            Style="{StaticResource BtnExportStyle}" Margin="0,0,0,10"
                            Click="btnActualizarMisVentas_Click"/>

                    <DataGrid x:Name="dgMisVentas"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HORA"     Binding="{Binding HoraTexto}"     Width="80"/>
                            <DataGridTextColumn Header="ÍTEMS"    Binding="{Binding CantidadItems}"  Width="70"/>
                            <DataGridTextColumn Header="MÉTODO"   Binding="{Binding MetodoPago}"     Width="110"/>
                            <DataGridTextColumn Header="TOTAL"    Binding="{Binding TotalTexto}"     Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
