<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.UsuariosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Usuarios">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter para foto: misma clase que ya tenés funcionando -->
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>

            <!-- Input con error: hereda InputEstilo (Background + BorderBrush
                 se aplican por TemplateBinding, funciona con BasedOn) -->
            <Style x:Key="InputErrorEstilo" TargetType="TextBox"
                   BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="{StaticResource ColorError}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <!-- Label de error debajo de cada campo -->
            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Estilos para los labels-->
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Grid raíz con animación fade-in al cargar -->
    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="gridRaiz"
                            Storyboard.TargetProperty="Opacity"
                            From="0" To="1"
                            Duration="0:0:0.5"
                            DecelerationRatio="0.6"/>
                        <DoubleAnimation
                            Storyboard.TargetName="translateEntrada"
                            Storyboard.TargetProperty="Y"
                            From="20" To="0"
                            Duration="0:0:0.5"
                            DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="*"/>
            <!-- DataGrid + Formulario -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             HEADER: Título + Buscador + Botón Nuevo
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Título con barra naranja lateral -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="GESTIÓN DE USUARIOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Administradores e instructores del sistema"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Buscador + Botón -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <!-- Buscador oscuro -->
                <TextBox x:Name="txtBuscar" 
         Style="{StaticResource BuscadorStyle}"
         Width="290" 
         Margin="0,0,12,0"
         TextChanged="txtBuscar_TextChanged"/>

                <!-- Botón Nuevo Usuario naranja -->
                <Button Content=" NUEVO USUARIO"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Tag="Plus"
                        Width="178" Height="46"
                        Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             STATS: 4 tarjetas de métricas
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL USUARIOS -->
            <Border Grid.Column="0" Style="{StaticResource KpiCardBorderStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="statTotal" Text="3" Style="{StaticResource KpiNumberStyle}" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="TOTAL USUARIOS" Style="{StaticResource KpiLabelStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Icon="Users" Style="{StaticResource KpiIconStyle}" Foreground="{StaticResource GreenMain}"/>
                </Grid>
            </Border>

            <!-- ACTIVOS -->
            <Border Grid.Column="2" Style="{StaticResource KpiCardBorderStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="statActivos" Text="3" Style="{StaticResource KpiNumberStyle}" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ACTIVOS" Style="{StaticResource KpiLabelStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Icon="CheckCircle" Style="{StaticResource KpiIconStyle}" Foreground="{StaticResource GreenMain}"/>
                </Grid>
            </Border>

            <!-- ADMINISTRADORES -->
            <Border Grid.Column="4" Style="{StaticResource KpiCardBorderStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="statAdmins" Text="3" Style="{StaticResource KpiNumberStyle}" Foreground="{StaticResource ColorNaranja}"/>
                        <TextBlock Text="ADMINISTRADORES" Style="{StaticResource KpiLabelStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Icon="CheckCircle" Style="{StaticResource KpiIconStyle}" Foreground="{StaticResource ColorNaranja}"/>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource KpiCardBorderStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="statInstructores" Text="3" Style="{StaticResource KpiNumberStyle}" Foreground="{StaticResource ColorVioleta}"/>
                        <TextBlock Text="INSTRUCTORES" Style="{StaticResource KpiLabelStyle}"/>
                    </StackPanel>
                    <fa:ImageAwesome Icon="CheckCircle" Style="{StaticResource KpiIconStyle}" Foreground="{StaticResource ColorVioleta}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             CONTENIDO: DataGrid + Panel Formulario
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATAGRID -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}"
                    CornerRadius="12" BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                    Margin="0,0,14,0" ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <!-- Línea decorativa superior -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Línea cyan/violeta decorativa -->
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="gridUsuarios"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              RowHeight="64"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#111811"
                              SelectionChanged="gridUsuarios_SelectionChanged">

                        <DataGrid.Columns>

                            <!-- Foto con anillo degradado -->
                            <DataGridTemplateColumn Width="78" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center">
                                            <Ellipse Width="48" Height="48">
                                                <Ellipse.Fill><SolidColorBrush Color="#4ADE80"/></Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="40" Height="40">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource BytesAImagen}}"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="NOMBRE COMPLETO"
                                                Binding="{Binding NombreCompleto}"
                                                Width="1.8*"/>

                            <DataGridTextColumn Header="DNI"
                                                Binding="{Binding Dni}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="EMAIL"
                                                Binding="{Binding Email}"
                                                Width="2*"/>

                            <!-- ROL badge -->
                            <DataGridTemplateColumn Header="ROL" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RolBadgeStyle}">
                                            <TextBlock Style="{StaticResource RolTextStyle}"  />
                                            <!-- AGREGAR PARA QUE MUESTRE admin o empleado Text="{Binding RolNombre}"-->
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ESTADO badge con punto indicador -->
                            <DataGridTemplateColumn Header="ESTADO" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource EstadoBadgeStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource EstadoDotStyle}"/>
                                                <TextBlock Style="{StaticResource EstadoTextStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ACCIONES -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <!-- BOTÓN EDITAR -->
                                            <Button Click="btnEditar_Click"
Style="{StaticResource ButtonStyleEditar}"
Margin="0,0,6,0"
ToolTip="Editar usuario">
                                                <fa:ImageAwesome Icon="Edit" Foreground="{StaticResource ColorEditarCyan}" Height="14"/>
                                            </Button>

                                            <!-- BOTÓN CAMBIAR CONTRASEÑA -->
                                            <Button Click="btnCambiarClave_Click"
Style="{StaticResource ButtonStyleEditar}"
Margin="0,0,6,0"
ToolTip="Cambiar contraseña">
                                                <fa:ImageAwesome Icon="Key" Foreground="#FFB347" Height="14"/>
                                            </Button>

                                            <!-- BOTÓN ESTADO -->
                                            <Button Click="btnToggleEstado_Click"
Style="{StaticResource ButtonStyleEstado}">
                                                <Button.ToolTip>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Dar de baja"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Text" Value="Dar de alta"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.ToolTip>
                                                <fa:ImageAwesome Height="14">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Icon" Value="Trash"/>
                                                            <Setter Property="Foreground" Value="#FF5555"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Icon" Value="Undo"/>
                                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════
                 PANEL FORMULARIO LATERAL
            ══════════════════════════════════ -->
            <Border x:Name="panelFormulario"
                    Grid.Column="1" Width="370"
                    Background="{StaticResource Bg1}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource Border1}"
                    BorderThickness="0.5"
                    Visibility="Collapsed"
                    ClipToBounds="True">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="panelTranslate"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <!-- Línea top degradada -->
                        <RowDefinition Height="Auto"/>
                        <!-- Título -->
                        <RowDefinition Height="*"/>
                        <!-- Campos scroll -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botones -->
                    </Grid.RowDefinitions>

                    <!-- Línea superior tricolor -->
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <!-- Título del formulario -->
                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="NUEVO USUARIO"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Campos -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="22,14,22,0"
                                  Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="8, 0">

                            <!-- Foto circular con anillo degradado -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Grid>
                                    <Ellipse Width="106" Height="106" Margin="0, 4, 0, 0" >
                                        <Ellipse.Fill><SolidColorBrush Color="#4ADE80"/></Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="100" Height="100" HorizontalAlignment="Center">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="imgFotoFormulario" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Button Width="28" Height="28"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right"
                                            Cursor="Hand" ToolTip="Cambiar foto"
                                            Click="btnSubirFoto_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="14">
                                                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="📷" FontSize="12" Margin="0,0,0,1"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Macro para etiqueta de campo: caps pequeñas -->
                            <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}"
                                     LostFocus="txtNombre_LostFocus"/>
                            <TextBlock x:Name="errNombre" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="APELLIDO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtApellido" Style="{StaticResource InputEstilo}"
                                     LostFocus="txtApellido_LostFocus"/>
                            <TextBlock x:Name="errApellido" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="DNI *  (7 u 8 dígitos)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtDni" Style="{StaticResource InputEstilo}"
                                     MaxLength="8"
                                     PreviewTextInput="txtDni_PreviewTextInput"
                                     DataObject.Pasting="txtDni_Pasting"
                                     LostFocus="txtDni_LostFocus"/>
                            <TextBlock x:Name="errDni" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="EMAIL  (opcional)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtEmail" Style="{StaticResource InputEstilo}"
                                     LostFocus="txtEmail_LostFocus"/>
                            <TextBlock x:Name="errEmail" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="TELÉFONO  (opcional, 10 dígitos sin 0 inicial)" Style="{StaticResource LabelCampoEstilo}"/>

                            <TextBox x:Name="txtTelefono" Style="{StaticResource InputEstilo}"
                                     MaxLength="10"
                                     PreviewTextInput="txtTelefono_PreviewTextInput"
                                     DataObject.Pasting="txtTelefono_Pasting"
                                     LostFocus="txtTelefono_LostFocus"
                                     ToolTip="Ingresá 10 dígitos sin el 0 inicial. Ejemplo: 3884123456"/>
                            <TextBlock x:Name="errTelefono" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="DOMICILIO  (opcional)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtDomicilio" Style="{StaticResource InputEstilo}"
                                     MaxLength="200"/>

                            <TextBlock x:Name="lblClave" Text="CONTRASEÑA *"
                                       Style="{StaticResource LabelCampoEstilo}"/>
                            <PasswordBox x:Name="txtClave" Style="{StaticResource PasswordEstilo}"
                                         PasswordChanged="txtClave_PasswordChanged"/>
                            <TextBlock x:Name="errClave" Style="{StaticResource LabelErrorEstilo}"/>
                            
                            <TextBlock x:Name="lblClaveAclaracion"
                                       Text="Dejá vacío para no cambiar la contraseña."
                                       FontSize="11" Foreground="{StaticResource TextMuted}" FontStyle="Italic"
                                       Margin="0,-8,0,12" Visibility="Collapsed"/>

                            <TextBlock Text="TARIFA POR HORA  (solo instructores)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtTarifaHora" Style="{StaticResource InputEstilo}"
                                     MaxLength="10"
                                     PreviewTextInput="txtTarifaHora_PreviewTextInput"/>
                            <TextBlock Text="Dejá en 0 si es administrador. Ej: 5000 = $5.000/h"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       FontStyle="Italic" Margin="0,-8,0,12"/>

                            <TextBlock Text="ROL *" Style="{StaticResource LabelCampoEstilo}"/>

                                <ComboBox x:Name="cmbRol"
                                          Style="{StaticResource ComboBoxEstilo}">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                                         Color="#111811"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"
                                                         Color="#E8F5E8"/>
                                    </ComboBox.Resources>
                                <ComboBoxItem Tag="1">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Icono de Seguridad -->
                                        <fa:ImageAwesome Icon="Shield" Foreground="#FF9F43" Height="14" Width="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Administrador" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="2">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Icono de Usuario -->
                                        <fa:ImageAwesome Icon="User" Foreground="#6C5DD3" Height="12" Width="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Empleado / Instructor" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Name="errRol" Style="{StaticResource LabelErrorEstilo}"/>

                            <Border Height="1" Background="{StaticResource Bg4}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones Cancelar / Guardar -->
                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>

