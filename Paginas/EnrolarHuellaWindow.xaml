<Window x:Class="SistemaGimnacionOptimusCAI.Paginas.EnrolarHuellaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Registrar Huella"
        Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Bg1}" CornerRadius="16"
            BorderBrush="{StaticResource Border2}" BorderThickness="1.5">
        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <fa:ImageAwesome Icon="Hand_Paper_Outline"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="20" Width="20" Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>
                    <TextBlock Text="REGISTRAR HUELLA DIGITAL"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="lblSocioNombre" Text="—"
                           FontSize="13" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <!-- Contenido central -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">

                <!-- Ícono de huella grande -->
                <fa:ImageAwesome x:Name="iconHuella"
                                 Icon="Hand_Paper_Outline"
                                 Foreground="{StaticResource TextMuted}"
                                 Height="72" Width="72"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,20"/>

                <!-- Mensaje de estado -->
                <TextBlock x:Name="lblEstado"
                           Text="Preparando el lector..."
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Detalle (razón de rechazo, etc.) -->
                <TextBlock x:Name="lblDetalle"
                           Text=""
                           FontSize="12" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Barra de progreso (4 capturas) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse x:Name="dot1" Width="14" Height="14" Margin="5,0"
                             Fill="{StaticResource Border1}"/>
                    <Ellipse x:Name="dot2" Width="14" Height="14" Margin="5,0"
                             Fill="{StaticResource Border1}"/>
                    <Ellipse x:Name="dot3" Width="14" Height="14" Margin="5,0"
                             Fill="{StaticResource Border1}"/>
                    <Ellipse x:Name="dot4" Width="14" Height="14" Margin="5,0"
                             Fill="{StaticResource Border1}"/>
                </StackPanel>
                <TextBlock x:Name="lblCapturas" Text="0 / 4 capturas"
                           FontSize="11" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="btnCancelar" Content="Cancelar"
                        Style="{StaticResource BotonSecundarioEstilo}"
                        Width="110" Height="38" Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>
                <Button x:Name="btnCerrar" Content="Cerrar"
                        Style="{StaticResource BotonPrincipalEstilo}"
                        Width="110" Height="38"
                        Visibility="Collapsed"
                        Click="btnCerrar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
