<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.TurnosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:fa="http://schemas.fontawesome.io/icons/"
       mc:Ignorable="d"
       d:DesignHeight="768" d:DesignWidth="1280"
       Title="Turnos">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5A6B5A"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,15"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="HORARIOS Y TURNOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Cronograma semanal de actividades"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="NUEVO TURNO"
                    Tag="Plus"
                    Style="{StaticResource BotonNaranjaEstilo}"
                    Width="180" Height="46" Click="btnNuevo_Click"/>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statTotal" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="TOTAL TURNOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Calendar"
                                     Foreground="{StaticResource TextPrimary}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statActivos" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ACTIVOS" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="CheckCircle"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statSinInstructor" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="#D4830A"/>
                        <TextBlock Text="SIN INSTRUCTOR" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="UserTimes"
                                     Foreground="#D4830A"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statCupoTotal" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="CUPO TOTAL" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Users"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FILTRO de actividad -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="ACTIVIDAD:" Foreground="{StaticResource TextMuted}" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="cmbFiltroActividad"
                      DisplayMemberPath="Nombre"
                      Width="250"
                      Height="36"
                      SelectionChanged="cmbFiltroActividad_SelectionChanged"
                      Style="{StaticResource ComboBoxEstilo}">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                </ComboBox.Resources>
            </ComboBox>
        </StackPanel>

        <!-- CALENDARIO + PANEL FORMULARIO -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Calendario semanal -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <!-- Header dias -->
                    <Grid Grid.Row="1" Background="#0F0F1E" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LUNES"     HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="MARTES"    HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="MIÉRCOLES" HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="JUEVES"    HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="VIERNES"   HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="SÁBADO"    HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="6" Text="DOMINGO"   HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Columnas con turnos -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="colLunes"     Margin="6,8"/>
                            <StackPanel Grid.Column="1" x:Name="colMartes"    Margin="6,8"/>
                            <StackPanel Grid.Column="2" x:Name="colMiercoles" Margin="6,8"/>
                            <StackPanel Grid.Column="3" x:Name="colJueves"    Margin="6,8"/>
                            <StackPanel Grid.Column="4" x:Name="colViernes"   Margin="6,8"/>
                            <StackPanel Grid.Column="5" x:Name="colSabado"    Margin="6,8"/>
                            <StackPanel Grid.Column="6" x:Name="colDomingo"   Margin="6,8"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Estado vacio -->
                    <StackPanel Grid.Row="2" x:Name="panelVacio"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,40,0,0" Visibility="Collapsed">
                        <TextBlock Text="📅" FontSize="64" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No hay turnos cargados"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text='Hace click en "+ NUEVO TURNO" para empezar'
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANEL FORMULARIO -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="380"
                    Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="NUEVO TURNO"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,14,22,0" Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel>

                            <TextBlock Text="ACTIVIDAD *" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbActividad"
                                      DisplayMemberPath="Nombre" 
                                      Style="{StaticResource ComboBoxEstilo}">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                </ComboBox.Resources>
                            </ComboBox>

                            <TextBlock Text="DÍA DE LA SEMANA *" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbDia" BorderThickness="0" Background="Transparent"
          Foreground="{StaticResource TextPrimary}" VerticalContentAlignment="Center"
          FontSize="13" Padding="10,0" Style="{StaticResource ComboBoxEstilo}">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Lunes"     Tag="1" Foreground="{StaticResource TextPrimary}"/>
                                <ComboBoxItem Content="Martes"    Tag="2" Foreground="{StaticResource TextPrimary}"/>
                                <ComboBoxItem Content="Miércoles" Tag="3" Foreground="{StaticResource TextPrimary}"/>
                                <ComboBoxItem Content="Jueves"    Tag="4" Foreground="{StaticResource TextPrimary}"/>
                                <ComboBoxItem Content="Viernes"   Tag="5" Foreground="{StaticResource TextPrimary}"/>
                                <ComboBoxItem Content="Sábado"    Tag="6" Foreground="{StaticResource TextPrimary}"/>
                                <ComboBoxItem Content="Domingo"   Tag="7" Foreground="{StaticResource TextPrimary}"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="HORA INICIO * (HH:MM)" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtHoraInicio" Style="{StaticResource InputEstilo}"
                                             MaxLength="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="HORA FIN * (HH:MM)" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtHoraFin" Style="{StaticResource InputEstilo}"
                                             MaxLength="5"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="INSTRUCTOR (opcional)" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbInstructor" BorderThickness="0" Background="Transparent"
                                      Foreground="{StaticResource TextPrimary}" VerticalContentAlignment="Center"
                                      FontSize="13" Padding="10,0" Style="{StaticResource ComboBoxEstilo}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NombreCompleto}" Foreground="{StaticResource TextPrimary}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="CUPO MÁXIMO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtCupo" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                     Text="30"/>

                            <Border x:Name="panelEliminar" Visibility="Collapsed"
                                    Background="#1A0A0A" BorderBrush="#5A1A1A" BorderThickness="0.5"
                                    CornerRadius="10" Padding="14" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="ZONA PELIGROSA" Foreground="#FF5555"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Button x:Name="btnEliminar" Content="🗑️  ELIMINAR TURNO"
                                            Style="{StaticResource ButtonStyleCancelar}"
                                            FontWeight="SemiBold" FontSize="12"
                                            Height="36"
                                            ToolTip="Eliminar turno"
                                            Click="btnEliminar_Click"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>

