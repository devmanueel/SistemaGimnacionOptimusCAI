<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.TurnosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Turnos">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#4A4A7A"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00CFFF" Offset="0"/>
                            <GradientStop Color="#A78BFA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="HORARIOS Y TURNOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Cronograma semanal de actividades"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="＋ NUEVO TURNO"
                    Style="{StaticResource BotonNaranjaEstilo}"
                    Width="180" Height="46" Click="btnNuevo_Click"/>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statTotal" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="TOTAL TURNOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statActivos" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text="ACTIVOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statSinInstructor" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#FFA726"/>
                    <TextBlock Text="SIN INSTRUCTOR" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statCupoTotal" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="CUPO TOTAL" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILTRO de actividad -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="ACTIVIDAD:" Foreground="#4A4A7A" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border Background="#16162A" CornerRadius="10" Height="36"
                    BorderBrush="#252540" BorderThickness="1.5" Width="280">
                <ComboBox x:Name="cmbFiltroActividad"
                          BorderThickness="0" Background="Transparent"
                          Foreground="#E8E8FF" VerticalContentAlignment="Center"
                          FontSize="12" Padding="10,0"
                          DisplayMemberPath="Nombre"
                          SelectionChanged="cmbFiltroActividad_SelectionChanged">
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                    </ComboBox.Resources>
                </ComboBox>
            </Border>
        </StackPanel>

        <!-- CALENDARIO + PANEL FORMULARIO -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Calendario semanal -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Header dias -->
                    <Grid Grid.Row="1" Background="#0F0F1E" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LUNES"     HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="MARTES"    HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="MIÉRCOLES" HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="JUEVES"    HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="VIERNES"   HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="SÁBADO"    HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="6" Text="DOMINGO"   HorizontalAlignment="Center" Padding="0,12"
                                   Foreground="#A0A0C0" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Columnas con turnos -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="colLunes"     Margin="6,8"/>
                            <StackPanel Grid.Column="1" x:Name="colMartes"    Margin="6,8"/>
                            <StackPanel Grid.Column="2" x:Name="colMiercoles" Margin="6,8"/>
                            <StackPanel Grid.Column="3" x:Name="colJueves"    Margin="6,8"/>
                            <StackPanel Grid.Column="4" x:Name="colViernes"   Margin="6,8"/>
                            <StackPanel Grid.Column="5" x:Name="colSabado"    Margin="6,8"/>
                            <StackPanel Grid.Column="6" x:Name="colDomingo"   Margin="6,8"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Estado vacio -->
                    <StackPanel Grid.Row="2" x:Name="panelVacio"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,40,0,0" Visibility="Collapsed">
                        <TextBlock Text="📅" FontSize="64" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No hay turnos cargados"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#6A6A9A"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text='Hace click en "+ NUEVO TURNO" para empezar'
                                   FontSize="12" Foreground="#4A4A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANEL FORMULARIO -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="380"
                    Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="NUEVO TURNO"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                        <StackPanel>

                            <TextBlock Text="ACTIVIDAD *" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10" Height="46"
                                    BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                <ComboBox x:Name="cmbActividad" BorderThickness="0" Background="Transparent"
                                          Foreground="#E8E8FF" VerticalContentAlignment="Center"
                                          FontSize="13" Padding="10,0"
                                          DisplayMemberPath="Nombre">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </Border>

                            <TextBlock Text="DÍA DE LA SEMANA *" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10" Height="46"
                                    BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                <ComboBox x:Name="cmbDia" BorderThickness="0" Background="Transparent"
                                          Foreground="#E8E8FF" VerticalContentAlignment="Center"
                                          FontSize="13" Padding="10,0">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Lunes"     Tag="1" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Martes"    Tag="2" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Miércoles" Tag="3" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Jueves"    Tag="4" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Viernes"   Tag="5" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Sábado"    Tag="6" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Domingo"   Tag="7" Foreground="#E8E8FF"/>
                                </ComboBox>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="HORA INICIO * (HH:MM)" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtHoraInicio" Style="{StaticResource InputEstilo}"
                                             MaxLength="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="HORA FIN * (HH:MM)" Style="{StaticResource LabelCampoEstilo}"/>
                                    <TextBox x:Name="txtHoraFin" Style="{StaticResource InputEstilo}"
                                             MaxLength="5"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="INSTRUCTOR (opcional)" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10" Height="46"
                                    BorderBrush="#252540" BorderThickness="1.5" Margin="0,0,0,14">
                                <ComboBox x:Name="cmbInstructor" BorderThickness="0" Background="Transparent"
                                          Foreground="#E8E8FF" VerticalContentAlignment="Center"
                                          FontSize="13" Padding="10,0"
                                          DisplayMemberPath="NombreCompleto">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </Border>

                            <TextBlock Text="CUPO MÁXIMO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtCupo" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                                     Text="30"/>

                            <Border x:Name="panelEliminar" Visibility="Collapsed"
                                    Background="#1A0A0A" BorderBrush="#5A1A1A" BorderThickness="1"
                                    CornerRadius="10" Padding="14" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="ZONA PELIGROSA" Foreground="#FF5555"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Button x:Name="btnEliminar" Content="🗑️  ELIMINAR TURNO"
                                            Background="Transparent" Foreground="#FF5555"
                                            BorderThickness="1" BorderBrush="#5A1A1A"
                                            FontWeight="SemiBold" FontSize="12"
                                            Cursor="Hand" Height="36"
                                            Click="btnEliminar_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Margin="0,0,8,0" Click="btnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
