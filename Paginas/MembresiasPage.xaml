<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.MembresiasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      d:DesignHeight="768" d:DesignWidth="1360"
       Title="Membresías"
       Background="#080A08"
       Loaded="Page_Loaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="{StaticResource ColorError}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <!-- Margin: 2 (izq), 18 (arriba para separar del campo anterior), 0 (der), 6 (abajo para pegar al input) -->
                <Setter Property="Margin"      Value="2,15"/>
                <Setter Property="Opacity"     Value="0.9"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0"
                        Background="{StaticResource GreenMain}"/>
                <StackPanel>
                    <TextBlock Text="MEMBRESÍAS Y CUOTAS"
                               Style="{StaticResource TopbarTituloStyle}"
                               FontSize="19"/>
                    <TextBlock Text="Cobros, vencimientos y renovaciones"
                               Style="{StaticResource TopbarSubtituloStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Buscador -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtBuscar" Tag="Buscar por socio, DNI, N° o actividad..."
                         Style="{StaticResource BuscadorStyle}" Width="290" 
                         Margin="0,0,12,0" TextChanged="txtBuscar_TextChanged"/>

                <Button x:Name="btnNuevo" Content="COBRAR CUOTA"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Tag="UserPlus"
                        Width="180" Height="46" Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ STATS ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BorderStyleStatCard}">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="statActivas" Text="1"
                                   Foreground="{StaticResource GreenMain}"
                                   Style="{StaticResource TextBlockStatValor}"/>
                        <TextBlock Text="MEMBRESÍAS ACTIVAS" Style="{StaticResource TextBlockStatEtiqueta}"/>
                    </StackPanel>
                    <Path Data="{StaticResource IconRayo}" Fill="{StaticResource GreenMain}"
                          Opacity="0.12" Width="32" Height="32"
                          Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BorderStyleStatCard}">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="statPorVencer" Text="0"
                                   Foreground="#D4830A"
                                   Style="{StaticResource TextBlockStatValor}"/>
                        <TextBlock Text="PRÓXIMOS VENCIMIENTOS" Style="{StaticResource TextBlockStatEtiqueta}"/>
                    </StackPanel>
                    <Path Data="{StaticResource IconReloj}" Fill="#D4830A"
                          Opacity="0.12" Width="35" Height="35"
                          Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource BorderStyleStatCard}">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="statVencidas" Text="0"
                                   Foreground="{StaticResource ColorError}"
                                   Style="{StaticResource TextBlockStatValor}"/>
                        <TextBlock Text="MEMBRESÍAS EXPIRADAS" Style="{StaticResource TextBlockStatEtiqueta}"/>
                    </StackPanel>
                    <Path Data="{StaticResource IconAlerta}" Fill="{StaticResource ColorError}"
                          Opacity="0.12" Width="35" Height="35"
                          Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border x:Name="panelStatRecaudado" Grid.Column="6" Style="{StaticResource BorderStyleStatCard}"
                    BorderBrush="{StaticResource GreenDim}" BorderThickness="1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="INGRESOS MENSUALES"
                                   Style="{StaticResource TextBlockStatEtiqueta}"
                                   Foreground="{StaticResource GreenMain}"
                                   Margin="0,0,0,4"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="statRecaudadoMes" Text="$25.000"
                                           Foreground="{StaticResource TextPrimary}"
                                           Style="{StaticResource TextBlockStatValor}"
                                           FontSize="30"/>
                                <Path Data="M7,14l5-5 5 5H7z"
                                      Fill="{StaticResource GreenMain}"
                                      Width="12" Height="12"
                                      Margin="8,0,0,10"
                                      VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Path Data="{StaticResource IconGraficoCrecimiento}"
                          Fill="{StaticResource GreenMain}"
                          Opacity="0.15"
                          Width="45" Height="45"
                          Stretch="Uniform"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS ══════════════════ -->
        <!-- Agregamos un poco de Padding al StackPanel para que el resplandor no se corte -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" >
            <TextBlock Text="MOSTRAR:" Foreground="{StaticResource TextMuted}" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <Button x:Name="chipTodos"     Click="chipFiltro_Click" Tag="todos"
                    Style="{StaticResource BotonChipActivoEstilo}" Margin="0,0,8,0" Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Todas"/>
                    <TextBlock x:Name="chipTodosNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="chipActivas"   Click="chipFiltro_Click" Tag="activa"
                    Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0" Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Activas"/>
                    <TextBlock x:Name="chipActivasNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="chipPorVencer" Click="chipFiltro_Click" Tag="por_vencer"
                    Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0" Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Por vencer"/>
                    <TextBlock x:Name="chipPorVencerNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="chipVencidas"  Click="chipFiltro_Click" Tag="vencida"
                    Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0" Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Vencidas"/>
                    <TextBlock x:Name="chipVencidasNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="chipCanceladas" Click="chipFiltro_Click" Tag="cancelada"
                    Style="{StaticResource BotonChipEstilo}" Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Canceladas"/>
                    <TextBlock x:Name="chipCanceladasNum" Text="(0)" FontSize="11" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ══════════════════ CONTENIDO ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATAGRID -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource GreenMid}"
        CornerRadius="10,10,0,0"/>

                    <DataGrid Grid.Row="1" x:Name="gridMembresias"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="64"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Border1}">
                        <DataGrid.Columns>

                            <!-- Foto + N° de socio -->
                            <DataGridTemplateColumn Width="250" Header="SOCIO">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Margin="0,0,10,0">
                                                <Ellipse Width="42" Height="42" Fill="{StaticResource GreenMain}"/>
                                                <Ellipse Width="38" Height="38">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding SocioFoto, Converter={StaticResource BytesAImagen}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SocioNombre}" FontSize="13"
                                                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                                                           Padding="4, 4"/>
                                                <TextBlock Text="{Binding NumeroSocioFormateado}"
                                                                           Padding="4, 0"
                                                                           FontWeight="Bold"
                                                                           FontFamily="Consolas" FontSize="13"
                                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actividad badge -->
                            <DataGridTemplateColumn Header="ACTIVIDAD" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource TipoBadgeStyle}">
                                            <TextBlock Text="{Binding ActividadNombre}" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="{StaticResource GreenMain}"
                                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Monto -->
                            <DataGridTemplateColumn Header="MONTO" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MontoTexto}" FontWeight="Bold"
                                                                   FontFamily="Consolas" Foreground="{StaticResource GreenMain}" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="VENCE"
                                                Binding="{Binding FechaVencimientoTexto}" Width="0.8*"/>

                            <DataGridTemplateColumn Header="ESTADO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Eliminamos el centrado para que todo arranque al principio -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" >

                                            <!-- El Badge ahora arranca desde el borde izquierdo de la celda -->
                                            <Border Style="{StaticResource MembresiaBadgeStyle}" 
                        HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource MembresiaDotStyle}"/>
                                                    <TextBlock Style="{StaticResource MembresiaTextStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- El texto de abajo ahora usa el MISMO margen que el texto del badge -->
                                            <TextBlock Text="{Binding DiasParaVencerTexto}" 
                           FontSize="10" 
                           FontWeight="Medium"
                           Margin="4,6,0,0" 
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones: Renovar / Editar / Cancelar -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- RENOVAR -->
                                            <Button Style="{StaticResource ButtonStyleRenovar}" 
            Click="btnRenovar_Click" 
            ToolTip="Renovar membresía (+31 días)"
                                                        Margin="0,0,4,0">
                                                <TextBlock Text="+31d" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                                            </Button>
                                            <!-- EDITAR -->
                                            <Button Click="btnEditar_Click" Style="{StaticResource ButtonStyleEditar}"
                                                    Margin="4,0" Cursor="Hand" ToolTip="Editar membresía">
                                                <fa:ImageAwesome Icon="Edit" Foreground="{StaticResource ColorEditarCyan}" Height="14"/>
                                            </Button>
                                                <!-- CANCELAR -->
                                            <Button Style="{StaticResource ButtonStyleCancelar}"                           
                                                    Click="btnCancelar_Click" 
                                                    ToolTip="Cancelar membresía">
                                                <fa:ImageAwesome Icon="Times" Foreground="#FF5555" Height="14"/>
                                                
                                                    </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════ PANEL FORMULARIO ══════════════════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="400"
                    Background="{StaticResource Bg2}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource GreenMid}"/>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="COBRAR CUOTA"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Border Height="1" Background="{StaticResource Border1}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer 
                        Grid.Row="2" 
                        VerticalScrollBarVisibility="Auto" 
                        Margin="22,14,22,0" 
                        Style="{StaticResource PanelScrollViewerStyle}"
                        ClipToBounds="False">
                        <StackPanel>

                            <!-- SOCIO -->
                            <TextBlock Text="SOCIO *" Style="{StaticResource LabelCampoEstilo}" Margin="2,5,0,6"/>
                            <ComboBox x:Name="cmbSocio" Style="{StaticResource ComboBoxEstilo}"
                                          DisplayMemberPath="TextoCombo">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                            <!-- ACTIVIDAD -->
                            <TextBlock Text="ACTIVIDAD *" Style="{StaticResource LabelCampoEstilo}"/>
        
                                <ComboBox x:Name="cmbActividad"
                                          Style="{StaticResource ComboBoxEstilo}"
                                          DisplayMemberPath="TextoCombo"
                                          SelectionChanged="cmbActividad_SelectionChanged">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                            <!-- INSTRUCTOR -->
                            <TextBlock Text="INSTRUCTOR" Style="{StaticResource LabelCampoEstilo}"/>
                                <ComboBox x:Name="cmbInstructor" Style="{StaticResource ComboBoxEstilo}"
                                          DisplayMemberPath="TextoCombo">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                            <!-- FECHAS lado a lado (automáticas, no editables) -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="INICIO *" Style="{StaticResource LabelCampoEstilo}"/>
                                    <DatePicker x:Name="dpInicio"
                                                    Style="{StaticResource DatePickerEstilo}"
                                                    IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="VENCIMIENTO *" Style="{StaticResource LabelCampoEstilo}"/>
                                    <DatePicker x:Name="dpVencimiento"
                                                    Style="{StaticResource DatePickerEstilo}"
                                                    IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <!-- MONTO -->
                            <TextBlock Text="MONTO PAGADO * ($)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtMonto" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtMonto_PreviewTextInput"
                                     LostFocus="txtMonto_LostFocus"/>
                            <TextBlock x:Name="errMonto" Style="{StaticResource LabelErrorEstilo}"/>

                            <!-- Preview del monto -->
                            <Border x:Name="panelPreviewMonto" Background="{StaticResource Bg3}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblPreviewMonto" Text="$0"
                                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                               Foreground="#00E676" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- PANEL UPGRADE — solo visible al editar con actividad superior -->
                            <Border x:Name="panelUpgrade" Background="#0A1F0A" CornerRadius="8"
        BorderBrush="{StaticResource GreenDim}" BorderThickness="1"
        Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="UPGRADE DE MEMBRESÍA"
                   FontSize="10" FontWeight="Bold"
                   Foreground="{StaticResource GreenMain}"
                   Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="lblUpgradeDetalle"
                           Text="Diferencia a cobrar:"
                           FontSize="11" Foreground="{StaticResource TextMuted}"
                           Margin="0,0,0,2"/>
                                            <TextBlock x:Name="lblUpgradeMonto"
                           Text="$0"
                           FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource GreenMain}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="lblUpgradeNivel"
                           Text="⬆ Nivel 1 → 2"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#00C850"
                           HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- MÉTODO DE PAGO -->
                            <TextBlock Text="MÉTODO DE PAGO *" Style="{StaticResource LabelCampoEstilo}"/>

                            <ComboBox x:Name="cmbMetodoPago" Style="{StaticResource ComboBoxEstilo}">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111811"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8F5E8"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Efectivo"      Tag="efectivo"      Foreground="{StaticResource TextPrimary}" IsSelected="True"/>
                                    <ComboBoxItem Content="Transferencia" Tag="transferencia" Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Tarjeta"       Tag="tarjeta"       Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBoxItem Content="Otro"          Tag="otro"          Foreground="{StaticResource TextPrimary}"/>
                                </ComboBox>

                            <!-- OBSERVACIONES -->
                            <TextBlock Text="OBSERVACIONES" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="{StaticResource Bg2}" CornerRadius="10"
                                    BorderBrush="{StaticResource Border2}" BorderThickness="1"
                                    Margin="0,0,0,30">
                                <TextBox x:Name="txtObservaciones"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource GreenMain}"
                                         FontSize="13" Padding="14,10"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones -->
                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonDangerLargoEstilo}"
                                Margin="0,0,8,0" Click="btnCancelarFormulario_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
