<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.MembresiasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Membresías">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="#FF4444"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="#A0A8BA"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <!-- Margin: 2 (izq), 18 (arriba para separar del campo anterior), 0 (der), 6 (abajo para pegar al input) -->
                <Setter Property="Margin"      Value="2,15"/>

                <!-- Opcional: Un toque de opacidad si querés un look más moderno -->
                <Setter Property="Opacity"     Value="0.9"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00CFFF" Offset="0"/>
                            <GradientStop Color="#00E676" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="MEMBRESÍAS Y CUOTAS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Cobros, vencimientos y renovaciones"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Buscador -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtBuscar" Tag="Buscar por socio, DNI, N° o actividad..."
                         Style="{StaticResource BuscadorStyle}" Width="290" 
                         Margin="0,0,12,0" TextChanged="txtBuscar_TextChanged"/>

                <Button Content="COBRAR CUOTA"
                        Style="{StaticResource BotonNaranjaEstilo}"
                        Tag="UserPlus"
                        Width="180" Height="46" Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ STATS ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource BorderStyleStatCard}" Grid.Column="0">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="statActivas" Text="1" Foreground="#00E676" Style="{StaticResource TextBlockStatValor}">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00E676" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="MEMBRESÍAS ACTIVAS" Style="{StaticResource TextBlockStatEtiqueta}"/>
                    </StackPanel>

                    <Path Data="{StaticResource IconRayo}" Fill="#00E676" Opacity="0.12" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource BorderStyleStatCard}" Margin="4,0,4,0">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="statPorVencer" Text="0" Foreground="#FFA726" Style="{StaticResource TextBlockStatValor}">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FFA726" Opacity="0.25"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="PRÓXIMOS VENCIMIENTOS" Style="{StaticResource TextBlockStatEtiqueta}"/>
                    </StackPanel>
                    <Path Data="{StaticResource IconReloj}" Fill="#FFA726" Opacity="0.12" Width="35" Height="35" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BorderStyleStatCard}" Margin="4,0,4,0">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="statVencidas" Text="0" Foreground="#FF5555" Style="{StaticResource TextBlockStatValor}">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF5555" Opacity="0.25"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="MEMBRESÍAS EXPIRADAS" Style="{StaticResource TextBlockStatEtiqueta}"/>
                    </StackPanel>
                    <Path Data="{StaticResource IconAlerta}" Fill="#FF5555" Opacity="0.12" Width="35" Height="35" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="3" 
        Margin="8,0,0,0" 
        Style="{StaticResource BorderStyleStatCard}"
        BorderBrush="{StaticResource BrushGlowFinanciero}" 
        BorderThickness="0,0,0,4">
                <Grid>
                    <Border Background="#1A00CFFF" Opacity="0.05" CornerRadius="12" Margin="-18,-14"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="INGRESOS MENSUALES" 
                       Style="{StaticResource TextBlockStatEtiqueta}" 
                       Foreground="#00CFFF" 
                       Opacity="0.9"
                       Margin="0,0,0,4"/>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="statRecaudadoMes" 
                               Text="$25.000" 
                               Foreground="White" 
                               Style="{StaticResource TextBlockStatValor}" 
                               FontSize="30">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00CFFF" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <Path Data="M7,14l5-5 5 5H7z" 
                          Fill="#00E676" 
                          Width="12" Height="12" 
                          Margin="8,0,0,10" 
                          VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Path Data="{StaticResource IconGraficoCrecimiento}" 
              Fill="{StaticResource BrushGlowFinanciero}" 
              Opacity="0.2" 
              Width="45" Height="45" 
              Stretch="Uniform" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS ══════════════════ -->
        <!-- Agregamos un poco de Padding al StackPanel para que el resplandor no se corte -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" >
            <TextBlock Text="MOSTRAR:" Foreground="#4A4A7A" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <Button x:Name="chipTodos"     Content="Todas"     Click="chipFiltro_Click" Tag="todos"
                    Style="{StaticResource BotonChipActivoEstilo}" Margin="0,0,8,0"/>
            <Button x:Name="chipActivas"   Content="Activas"   Click="chipFiltro_Click" Tag="activa"
                    Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
            <Button x:Name="chipPorVencer" Content="Por vencer" Click="chipFiltro_Click" Tag="por_vencer"
                    Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
            <Button x:Name="chipVencidas"  Content="Vencidas"  Click="chipFiltro_Click" Tag="vencida"
                    Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
            <Button x:Name="chipCanceladas" Content="Canceladas" Click="chipFiltro_Click" Tag="cancelada"
                    Style="{StaticResource BotonChipEstilo}"/>
        </StackPanel>

        <!-- ══════════════════ CONTENIDO ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATAGRID -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#00E676" Offset="0.5"/>
                                <GradientStop Color="#12121E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="gridMembresias"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="64"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A1A2E">
                        <DataGrid.Columns>

                            <!-- Foto + N° de socio -->
                            <DataGridTemplateColumn Width="250" Header="SOCIO">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Margin="0,0,10,0">
                                                <Ellipse Width="42" Height="42">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#00CFFF" Offset="0"/>
                                                            <GradientStop Color="#A78BFA" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Width="38" Height="38">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding SocioFoto, Converter={StaticResource BytesAImagen}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SocioNombre}" FontSize="13"
                                                           FontWeight="Bold" Foreground="#E8E8FF"
                                                           Padding="4, 4"/>
                                                <TextBlock Text="{Binding NumeroSocioFormateado}"
                                                           Padding="4, 0"
                                                           FontWeight="Bold"
                                                           FontFamily="Consolas" FontSize="13"
                                                           Foreground="#6C757D"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actividad badge -->
                            <DataGridTemplateColumn Header="ACTIVIDAD" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource TipoBadgeStyle}">
                                            <TextBlock Text="{Binding ActividadNombre}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#A78BFA"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Monto -->
                            <DataGridTemplateColumn Header="MONTO" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MontoTexto}" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="#00E676" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="VENCE"
                                                Binding="{Binding FechaVencimientoTexto}" Width="0.8*"/>

                            <DataGridTemplateColumn Header="ESTADO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Eliminamos el centrado para que todo arranque al principio -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" >

                                            <!-- El Badge ahora arranca desde el borde izquierdo de la celda -->
                                            <Border Style="{StaticResource MembresiaBadgeStyle}" 
                        HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource MembresiaDotStyle}"/>
                                                    <TextBlock Style="{StaticResource MembresiaTextStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- El texto de abajo ahora usa el MISMO margen que el texto del badge -->
                                            <TextBlock Text="{Binding DiasParaVencerTexto}" 
                           FontSize="10" 
                           FontWeight="Medium"
                           Margin="4,6,0,0" 
                           HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8A92A6"/>
                                                        <Style.Triggers>
                                                            <!-- Tus triggers de colores se mantienen -->
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones: Renovar / Editar / Cancelar -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- RENOVAR -->
                                            <Button Style="{StaticResource ButtonStyleRenovar}" 
            Click="btnRenovar_Click" 
            ToolTip="Renovar membresía (+30 días)"
            Margin="0,0,4,0">
                                                <TextBlock Text="+30d" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                                            </Button>
                                            <!-- EDITAR -->
                                            <Button Click="btnEditar_Click" Style="{StaticResource ButtonStyleEditar}"
                                                    Margin="4,0" Cursor="Hand" ToolTip="Editar">
                                                <fa:ImageAwesome Icon="Edit" Foreground="#00CFFF" Height="14"/>
                                            </Button>
                                                <!-- CANCELAR -->
                                            <Button Style="{StaticResource ButtonStyleCancelar}"                           
                                                    Click="btnCancelar_Click" 
                                                    ToolTip="Cancelar membresía">
                                                <fa:ImageAwesome Icon="Times" Foreground="#FF5555" Height="14"/>
                                                
                                                    </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════ PANEL FORMULARIO ══════════════════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="400"
                    Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#00E676" Offset="0.5"/>
                                <GradientStop Color="#FFA726" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="COBRAR CUOTA"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer 
                        Grid.Row="2" 
                        VerticalScrollBarVisibility="Auto" 
                        Margin="22,14,22,0" 
                        Style="{StaticResource PanelScrollViewerStyle}"
                        ClipToBounds="False">
                        <StackPanel>

                            <!-- SOCIO -->
                            <TextBlock Text="SOCIO *" Style="{StaticResource LabelCampoEstilo}" Margin="2,5,0,6"/>
                            <ComboBox x:Name="cmbSocio" Style="{StaticResource ComboBoxEstilo}"
                                          DisplayMemberPath="TextoCombo">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                            <!-- ACTIVIDAD -->
                            <TextBlock Text="ACTIVIDAD *" Style="{StaticResource LabelCampoEstilo}"/>
        
                                <ComboBox x:Name="cmbActividad"
                                          Style="{StaticResource ComboBoxEstilo}"
                                          DisplayMemberPath="TextoCombo"
                                          SelectionChanged="cmbActividad_SelectionChanged">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                            <!-- INSTRUCTOR -->
                            <TextBlock Text="INSTRUCTOR" Style="{StaticResource LabelCampoEstilo}"/>
                                <ComboBox x:Name="cmbInstructor" Style="{StaticResource ComboBoxEstilo}"
                                          DisplayMemberPath="TextoCombo">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                </ComboBox>

                            <!-- FECHAS lado a lado -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="INICIO *" Style="{StaticResource LabelCampoEstilo}"/>
                                    <DatePicker x:Name="dpInicio"
                                                    Style="{StaticResource DatePickerEstilo}"
                                                    SelectedDateChanged="dpInicio_SelectedDateChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="VENCIMIENTO *" Style="{StaticResource LabelCampoEstilo}"/>
                                    <DatePicker x:Name="dpVencimiento"
                                                    Style="{StaticResource DatePickerEstilo}"/>
                                </StackPanel>
                            </Grid>

                            <!-- MONTO -->
                            <TextBlock Text="MONTO PAGADO * ($)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtMonto" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtMonto_PreviewTextInput"
                                     LostFocus="txtMonto_LostFocus"/>
                            <TextBlock x:Name="errMonto" Style="{StaticResource LabelErrorEstilo}"/>

                            <!-- Preview del monto -->
                            <Border x:Name="panelPreviewMonto" Background="#0A1A0A" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblPreviewMonto" Text="$0"
                                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                               Foreground="#00E676" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- MÉTODO DE PAGO -->
                            <TextBlock Text="MÉTODO DE PAGO *" Style="{StaticResource LabelCampoEstilo}"/>

                            <ComboBox x:Name="cmbMetodoPago" Style="{StaticResource ComboBoxEstilo}">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Efectivo"      Tag="efectivo"      Foreground="#E8E8FF" IsSelected="True"/>
                                    <ComboBoxItem Content="Transferencia" Tag="transferencia" Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Tarjeta"       Tag="tarjeta"       Foreground="#E8E8FF"/>
                                    <ComboBoxItem Content="Otro"          Tag="otro"          Foreground="#E8E8FF"/>
                                </ComboBox>

                            <!-- OBSERVACIONES -->
                            <TextBlock Text="OBSERVACIONES" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10"
                                    BorderBrush="#252540" BorderThickness="1.5"
                                    Margin="0,0,0,30">
                                <TextBox x:Name="txtObservaciones"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#E8E8FF" CaretBrush="#00CFFF"
                                         FontSize="13" Padding="14,10"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones -->
                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Margin="0,0,8,0" Click="btnCancelarFormulario_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
