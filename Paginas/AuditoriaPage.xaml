<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.AuditoriaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Auditoría">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#4A4A7A"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A78BFA" Offset="0"/>
                            <GradientStop Color="#00CFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="AUDITORÍA"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Registro de actividad — quién hizo qué y cuándo"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Buscador -->
            <Border Grid.Column="1" Background="#16162A" CornerRadius="10"
                    BorderBrush="#252540" BorderThickness="1.5"
                    Width="300" Height="46">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="15"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="txtBuscar" Height="44" BorderThickness="0"
                                 Background="Transparent" Foreground="#E8E8FF"
                                 CaretBrush="#A78BFA" FontSize="14"
                                 VerticalContentAlignment="Center" Padding="0,0,10,0"
                                 TextChanged="txtBuscar_TextChanged"/>
                        <TextBlock Text="Buscar acción, entidad, usuario..."
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" FontSize="12" Foreground="#3A3A5C">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statTotal" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="TOTAL ACCIONES" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statHoy" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#00CFFF"/>
                    <TextBlock Text="HOY" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statMes" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="ESTE MES" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statUsuarios" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#FF6B35"/>
                    <TextBlock Text="USUARIOS ACTIVOS" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILTROS -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="cmbUsuario" BorderThickness="0" Background="Transparent"
                      Foreground="#E8E8FF" VerticalContentAlignment="Center"
                      FontSize="11" Grid.Column="0" Width="160" Height="36" Margin="0 ,8, 12, 8"
                      SelectionChanged="cmbFiltro_Changed" Style="{StaticResource ComboBoxEstilo}">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                </ComboBox.Resources>
            </ComboBox>

            <ComboBox x:Name="cmbEntidad" BorderThickness="0" Background="Transparent"
                      Foreground="#E8E8FF" VerticalContentAlignment="Center"
                      FontSize="11" Grid.Column="1" Width="160" Height="36"
                      Margin="12, 0" SelectionChanged="cmbFiltro_Changed" 
                      Style="{StaticResource ComboBoxEstilo}">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                </ComboBox.Resources>
            </ComboBox>

            <ComboBox x:Name="cmbAccion" BorderThickness="0" Background="Transparent"
                      Foreground="#E8E8FF" VerticalContentAlignment="Center" Grid.Column="2"
                      FontSize="11" Margin="12, 0" SelectionChanged="cmbFiltro_Changed" 
                      Style="{StaticResource ComboBoxEstilo}" Width="160" Height="36">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                </ComboBox.Resources>
            </ComboBox>

            <TextBlock Grid.Column="4" Text="DESDE:" Foreground="#4A4A7A" FontSize="10"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="dpDesde" Grid.Column="4" Width="140" Margin="45, 0, 0, 0"
                        SelectedDateChanged="dpFecha_Changed" Style="{StaticResource DatePickerEstilo}"/>

            <TextBlock Grid.Column="5" Text="HASTA:" Foreground="#4A4A7A" FontSize="10"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <DatePicker x:Name="dpHasta" BorderThickness="0" Background="Transparent" Grid.Column="5"
                        FontSize="11" VerticalContentAlignment="Center" Margin="60, 0, 0, 0" Width="140"
                        Foreground="#E8E8FF" SelectedDateChanged="dpFecha_Changed" Style="{StaticResource DatePickerEstilo}"/>
        </Grid>

        <!-- CONTENIDO: timeline + detalle -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- ══ TIMELINE ══ -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#00CFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" x:Name="panelVacio"
                                        HorizontalAlignment="Center" Margin="0,80,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="📜" FontSize="64" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="No hay registros en este período"
                                           FontFamily="Bahnschrift SemiBold"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#6A6A9A"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Probá ampliar el rango de fechas o limpiar los filtros"
                                           FontSize="12" Foreground="#4A4A7A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" x:Name="panelTimeline"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ DETALLE ══ -->
            <Border Grid.Column="1" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Estado vacio -->
                    <StackPanel Grid.Row="1" x:Name="panelSinSeleccion"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📜" FontSize="80" Opacity="0.3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Seleccioná un evento"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="18" FontWeight="Bold" Foreground="#6A6A9A"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Hace click en uno del timeline"
                                   FontSize="12" Foreground="#4A4A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Detalle -->
                    <ScrollViewer Grid.Row="1" x:Name="scrollDetalle"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,18">

                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Grid Margin="0,0,12,0">
                                    <Ellipse Width="48" Height="48">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF6B35" Offset="0"/>
                                                <GradientStop Color="#A78BFA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="44" Height="44">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="imgDetalleFoto" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblDetalleActor" Text="—"
                                               FontFamily="Bahnschrift SemiBold"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#E8E8FF"/>
                                    <TextBlock x:Name="lblDetalleRol" Text="—"
                                               FontSize="11" Foreground="#A78BFA"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="#252540" Margin="0,0,0,14"/>

                            <!-- Resumen accion -->
                            <Border Background="#1A1840" CornerRadius="10" Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="lblIconoEntidad" Text="📝" FontSize="22"
                                                   Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="lblDetalleResumen" Text="—"
                                                       FontFamily="Bahnschrift SemiBold"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="#E8E8FF"/>
                                            <TextBlock x:Name="lblDetalleFechaHora" Text="—"
                                                       FontSize="11" Foreground="#A0A0C0"
                                                       FontFamily="Consolas"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Datos basicos -->
                            <TextBlock Text="DATOS DEL EVENTO" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10" Padding="14,10"
                                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Acción:"
                                                   FontSize="11" Foreground="#6A6A9A" Grid.Column="0"/>
                                        <TextBlock x:Name="lblDatoAccion" Text="—"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#E8E8FF" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Entidad:"
                                                   FontSize="11" Foreground="#6A6A9A" Grid.Column="0"/>
                                        <TextBlock x:Name="lblDatoEntidad" Text="—"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#E8E8FF" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ID afectado:"
                                                   FontSize="11" Foreground="#6A6A9A" Grid.Column="0"/>
                                        <TextBlock x:Name="lblDatoEntidadId" Text="—"
                                                   FontSize="11" FontFamily="Consolas"
                                                   Foreground="#FF6B35" Grid.Column="1"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ID registro:"
                                                   FontSize="11" Foreground="#6A6A9A" Grid.Column="0"/>
                                        <TextBlock x:Name="lblDatoRegId" Text="—"
                                                   FontSize="11" FontFamily="Consolas"
                                                   Foreground="#A78BFA" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- JSON detalle -->
                            <TextBlock Text="DATOS ADICIONALES (JSON)" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#0A0A14" CornerRadius="10" Padding="14"
                                    BorderBrush="#252540" BorderThickness="1">
                                <TextBlock x:Name="lblDetalleJson" Text="—"
                                           FontFamily="Consolas, Courier New"
                                           FontSize="11" Foreground="#A0A0C0"
                                           TextWrapping="Wrap"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
