<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.EstadisticasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:oxy="http://oxyplot.org/wpf"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Estadisticas">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" Text="Estadisticas del Gimnasio"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#E8F0E8" Margin="0,0,0,12"/>

        <!-- KPIs GLOBALES -->
        <Border Grid.Row="1" Background="#121812" BorderBrush="#2A3A2A"
                BorderThickness="1" CornerRadius="10"
                Padding="20,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="SOCIOS ACTIVOS" FontSize="9" FontWeight="Bold"
                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblSociosActivos" Text="-"
                               FontSize="28" FontWeight="Bold" Foreground="#00897B"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="VENCEN ESTA SEMANA" FontSize="9" FontWeight="Bold"
                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblMembresiasVencer" Text="-"
                               FontSize="18" FontWeight="Bold" Foreground="#E65100"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="PRODUCTO + VENDIDO (MES)" FontSize="9" FontWeight="Bold"
                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblProductoTop" Text="-"
                               FontSize="13" FontWeight="Bold" Foreground="#42A5F5"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="180"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="INGRESOS DEL MES" FontSize="9" FontWeight="Bold"
                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblIngresosMes" Text="-"
                               FontSize="18" FontWeight="Bold" Foreground="#66BB6A"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTRO DE PERIODO -->
        <Border Grid.Row="2" Background="#121812" BorderBrush="#2A3A2A"
                BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ver:" Foreground="#9FB89F" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbPeriodo" Width="180" FontSize="12"
                          Style="{StaticResource ComboBoxEstilo}"
                          Height="34" Margin="0"
                          SelectionChanged="cmbPeriodo_SelectionChanged">
                    <ComboBoxItem Content="Esta semana" IsSelected="True"/>
                    <ComboBoxItem Content="Este mes"/>
                    <ComboBoxItem Content="Este ano"/>
                    <ComboBoxItem Content="Definir periodo"/>
                    <ComboBoxItem Content="Ultima semana"/>
                    <ComboBoxItem Content="Ultimo mes"/>
                    <ComboBoxItem Content="Ultimo ano"/>
                </ComboBox>

                <StackPanel x:Name="panelFechasCustom" Orientation="Horizontal"
                            Visibility="Collapsed" Margin="20,0,0,0">
                    <TextBlock Text="Desde:" Foreground="#9FB89F" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="dpDesde" Width="130" FontSize="11"/>
                    <TextBlock Text="Hasta:" Foreground="#9FB89F" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <DatePicker x:Name="dpHasta" Width="130" FontSize="11"/>
                    <Border Background="#2E7D32" CornerRadius="4"
                            Padding="16,5" Margin="16,0,0,0" Cursor="Hand"
                            MouseLeftButtonDown="btnMostrar_Click">
                        <TextBlock Text="Mostrar" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TAB CONTROL -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0"
                    Foreground="#E8F0E8">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#6B7B6B"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" Background="Transparent"
                                        CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1A2A1A"/>
                                        <Setter Property="Foreground" Value="#9FD96E"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#162216"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB CAJA -->
            <TabItem Header="Caja">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="0,16,0,0">
                        <!-- Periodo elegido -->
                        <TextBlock x:Name="lblPeriodoCaja" FontSize="11"
                                   Foreground="#6B7B6B" Margin="0,0,0,12"
                                   Text="Periodo elegido: ..."/>

                        <!-- KPIs de caja -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0D1F0D" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="INGRESOS" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="lblIngresos" Text="$ 0"
                                               FontSize="24" FontWeight="Bold" Foreground="#66BB6A"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#1F0D0D" CornerRadius="8"
                                    Padding="16,12" Margin="4,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="GASTOS" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="lblGastos" Text="$ 0"
                                               FontSize="24" FontWeight="Bold" Foreground="#EF5350"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0D0D1F" CornerRadius="8"
                                    Padding="16,12" Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="GANANCIA" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7B6B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="lblGanancias" Text="$ 0"
                                               FontSize="24" FontWeight="Bold" Foreground="#42A5F5"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Grafico Ingresos -->
                        <Border Background="#121812" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <oxy:PlotView x:Name="plotIngresos" Height="230" Background="Transparent"/>
                        </Border>

                        <!-- Grafico Gastos -->
                        <Border Background="#121812" CornerRadius="8" Padding="12">
                            <oxy:PlotView x:Name="plotGastos" Height="230" Background="Transparent"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB ASISTENCIAS -->
            <TabItem Header="Asistencias">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Filtro por actividad -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Por actividad:" Foreground="#9FB89F"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbActividad" Width="240" FontSize="12"
                                      Style="{StaticResource ComboBoxEstilo}"
                                      Height="34" Margin="0"
                                      SelectionChanged="cmbActividad_SelectionChanged"/>
                        </StackPanel>

                        <!-- Graficos -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Promedio por hora -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#121812"
                                    CornerRadius="8" Padding="12" Margin="0,0,6,12">
                                <oxy:PlotView x:Name="plotPromedioHora" Height="230" Background="Transparent"/>
                            </Border>

                            <!-- Pie chart por actividad (ocupa 2 filas a la derecha) -->
                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                    Background="#121812" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                <oxy:PlotView x:Name="plotPieActividades" Height="472" Background="Transparent"/>
                            </Border>

                            <!-- Porcentaje por hora -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#121812"
                                    CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                <oxy:PlotView x:Name="plotPorcentajeHora" Height="230" Background="Transparent"/>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB SOCIOS -->
            <TabItem Header="Socios">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nuevos socios -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#121812"
                                CornerRadius="8" Padding="12" Margin="0,0,6,12">
                            <oxy:PlotView x:Name="plotNuevosSocios" Height="230" Background="Transparent"/>
                        </Border>

                        <!-- Top 5 socios (ocupa 2 filas a la derecha) -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                Background="#121812" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                            <oxy:PlotView x:Name="plotTop5" Height="472" Background="Transparent"/>
                        </Border>

                        <!-- Socios inactivos -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#121812"
                                CornerRadius="8" Padding="20,16" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Considerar que un alumno dejo de asistir pasados los:"
                                           Foreground="#9FB89F" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Background="#1A2A1A" CornerRadius="4"
                                            BorderBrush="#3A5A3A" BorderThickness="1"
                                            Padding="4,2">
                                        <TextBox x:Name="txtDiasInactivo" Text="20"
                                                 Width="50" FontSize="16" FontWeight="Bold"
                                                 TextAlignment="Center"
                                                 Background="Transparent" Foreground="#E8F0E8"
                                                 BorderThickness="0" CaretBrush="#9FD96E"
                                                 LostFocus="txtDiasInactivo_LostFocus"
                                                 KeyDown="txtDiasInactivo_KeyDown"/>
                                    </Border>
                                    <TextBlock Text=" dias" Foreground="#9FB89F" FontSize="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="SOCIOS QUE DEJARON DE ASISTIR" FontSize="9"
                                           FontWeight="Bold" Foreground="#6B7B6B"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="lblInactivos" Text="-" FontSize="42"
                                           FontWeight="Bold" Foreground="#EF5350"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
