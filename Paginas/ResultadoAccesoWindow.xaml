<Window x:Class="SistemaGimnacionOptimusCAI.Paginas.ResultadoAccesoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Resultado de Acceso"
        Height="480" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="panelResultado"
            Background="#0D110D"
            CornerRadius="16"
            BorderThickness="2"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="lblBarra" Height="4" CornerRadius="2,2,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#4ADE80"/>
                </Border.Background>
            </Border>

            <TextBlock Grid.Row="1" x:Name="lblIcono" Text="✓"
                       FontSize="64" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,18,0,4"/>

            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,12">
                <Ellipse Width="92" Height="92">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#4ADE80"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="86" Height="86">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="imgFoto" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                <TextBlock x:Name="lblSocioNombre"
                           Text="—"
                           FontFamily="Bahnschrift SemiBold, Segoe UI"
                           FontSize="16" FontWeight="Bold" Foreground="#E8F5E8"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="lblNumeroSocio"
                           Text="#0000"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="#4ADE80" HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
            </StackPanel>

            <Border Grid.Row="4" x:Name="panelDetalles"
                    CornerRadius="10" Padding="16,14"
                    Margin="20,0,20,20">
                <Border.Background>
                    <SolidColorBrush Color="#00E676" Opacity="0.1"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="lblMensaje" Text="—"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,8"
                               Foreground="#E8F5E8"/>

                    <StackPanel x:Name="panelInfoMembresia" Visibility="Collapsed">
                        <Border Height="1" Background="#33FFFFFF" Margin="0,4,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Plan: "
                                       FontSize="11" Foreground="#AAAACC"/>
                            <TextBlock Grid.Column="1" x:Name="lblActividad"
                                       Text="—" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#E8F5E8"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vence: "
                                       FontSize="11" Foreground="#AAAACC"/>
                            <TextBlock Grid.Column="1" x:Name="lblVencimiento"
                                       Text="—" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#E8F5E8"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Asistencias restantes: "
                                       FontSize="11" Foreground="#AAAACC"/>
                            <TextBlock Grid.Column="1" x:Name="lblAsistenciasRestantes"
                                       Text="—" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#E8F5E8"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
