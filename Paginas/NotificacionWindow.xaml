<Window x:Class="SistemaGimnacionOptimusCAI.Helpers.NotificacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="420"
        SizeToContent="Height"
        Topmost="True">

    <Window.Resources>
        <!-- Botón de cerrar/aceptar -->
        <Style x:Key="BtnNotifStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Sombra exterior y borde redondeado -->
    <Border x:Name="contenedorPrincipal"
            CornerRadius="14"
            Background="#1E1E2E"
            Padding="0,0,0,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000"
                              Opacity="0.55" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Banda de color superior -->
                <RowDefinition Height="Auto"/>
                <!-- Icono + Título -->
                <RowDefinition Height="Auto"/>
                <!-- Mensaje -->
                <RowDefinition Height="Auto"/>
                <!-- Botones -->
            </Grid.RowDefinitions>

            <!-- BANDA DE COLOR SUPERIOR (cambia por tipo) -->
            <Border x:Name="bandaColor"
                    Grid.Row="0"
                    Height="8"
                    CornerRadius="14,14,0,0"
                    Background="#00AEEF"/>

            <!-- ICONO + TÍTULO -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="30,24,30,8"
                        VerticalAlignment="Center">

                <!-- Círculo de icono -->
                <Border x:Name="circuloIcono"
                        Width="52" Height="52"
                        CornerRadius="26"
                        Background="#2A2A3E"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtIcono"
                               Text="✅"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Título -->
                <TextBlock x:Name="txtTitulo"
                           Text="Operación exitosa"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- MENSAJE -->
            <TextBlock x:Name="txtMensaje"
                       Grid.Row="2"
                       Text="Todo salió correctamente."
                       FontSize="14"
                       Foreground="#B0B0C8"
                       Margin="30,4,30,20"
                       TextWrapping="Wrap"
                       LineHeight="22"/>

            <!-- LÍNEA SEPARADORA -->
            <Border Grid.Row="3"
                    Height="1"
                    Background="#2A2A3E"
                    Margin="0,0,0,20"/>

            <!-- BOTÓN ACEPTAR -->
            <Button x:Name="btnAceptar"
                    Grid.Row="3"
                    Content="Aceptar"
                    Style="{StaticResource BtnNotifStyle}"
                    Background="#00AEEF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0"
                    Click="btnAceptar_Click"/>
        </Grid>
    </Border>
</Window>
