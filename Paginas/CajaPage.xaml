<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.CajaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
            xmlns:fa="http://schemas.fontawesome.io/icons/"

      Title="Caja">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="#FF4444"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="#4A4A7A"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Dashboard balance del día -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- DataGrid + panel -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00E676" Offset="0"/>
                            <GradientStop Color="#00CFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="CAJA Y MOVIMIENTOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Ingresos, gastos y balance del gimnasio"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Buscador oscuro -->
                <TextBox x:Name="txtBuscar"
                         Tag="Buscar movimiento..."
Style="{StaticResource BuscadorStyle}"
Width="290" 
Margin="0,0,12,0"
TextChanged="txtBuscar_TextChanged"/>

                <!-- Botón verde para INGRESO MANUAL -->
                <Button Content="＋ INGRESO" Click="btnIngreso_Click"
                        Background="#0A2A14" Foreground="#00E676"
                        BorderThickness="1.5" BorderBrush="#00E676"
                        FontWeight="Bold" FontSize="13"
                        Cursor="Hand" Width="120" Height="46" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Botón rojo para GASTO -->
                <Button Content="－ GASTO" Click="btnGasto_Click"
                        Background="#2A0A0A" Foreground="#FF5555"
                        BorderThickness="1.5" BorderBrush="#FF5555"
                        FontWeight="Bold" FontSize="13"
                        Cursor="Hand" Width="120" Height="46">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ DASHBOARD BALANCE ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Card grande de balance del día -->
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="12"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <fa:ImageAwesome Icon="Dollar" 
                 Foreground="{StaticResource ColorExito}" 
                 Height="30" Width="30" 
                 VerticalAlignment="Center"
                                         Margin="0, 0, 8, 0"/>
                        <TextBlock Text="BALANCE DEL DÍA" Foreground="#6A6A9A"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Balance grande -->
                    <TextBlock Grid.Row="1" x:Name="lblBalanceDia" Text="$0"
                               FontFamily="Bahnschrift SemiBold, Consolas"
                               FontSize="42" FontWeight="Bold" Foreground="#00E676"/>

                    <!-- Detalle: ingresos vs gastos -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#00E676"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="Ingresos" Foreground="#6A6A9A" FontSize="10"/>
                                <TextBlock x:Name="lblIngresosDia" Text="$0"
                                           Foreground="#00E676" FontFamily="Consolas"
                                           FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF5555"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="Gastos" Foreground="#6A6A9A" FontSize="10"/>
                                <TextBlock x:Name="lblGastosDia" Text="$0"
                                           Foreground="#FF5555" FontFamily="Consolas"
                                           FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Mini gráfico de los últimos 7 días + balance del mes -->
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="12"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gráfico de barras -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <fa:ImageAwesome Icon="LineChart" Foreground="#00E676"
                                             Height="30" Width="30" VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                            <TextBlock Text="ÚLTIMOS 7 DÍAS" Foreground="#6A6A9A"
                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="gridChart" Height="80" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Las barras se llenan por código en xaml.cs -->
                        </Grid>
                        <Grid x:Name="gridChartLabels" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>

                    <!-- Card balance del mes -->
                    <Border Grid.Column="1" Margin="20,0,0,0"
                            Background="#0A1A2A" CornerRadius="10"
                            BorderBrush="#1A3A5A" BorderThickness="1"
                            Padding="16,12" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="BALANCE DEL MES"
                                       Foreground="#6A8AAA" FontSize="10"
                                       FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblBalanceMes" Text="$0"
                                       FontFamily="Bahnschrift SemiBold"
                                       FontSize="22" FontWeight="Bold" Foreground="#00CFFF"/>
                            <TextBlock x:Name="lblMovimientosMes" Text="0 movim."
                                       Foreground="#6A6A9A" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS ══════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="MOSTRAR:" Foreground="#4A4A7A" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="chipTodos"   Content="Todos"   Click="chipFiltro_Click" Tag="todos"
                        Style="{StaticResource BotonChipActivoEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipIngresos" Content="Ingresos" Click="chipFiltro_Click" Tag="ingreso"
                        Style="{StaticResource BotonChipEstilo}" Margin="0,0,8,0"/>
                <Button x:Name="chipGastos"  Content="Gastos"  Click="chipFiltro_Click" Tag="gasto"
                        Style="{StaticResource BotonChipEstilo}"/>
            </StackPanel>

            <!-- Selector de rango de fechas -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DESDE:" Foreground="#4A4A7A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="dpDesde"
                    Style="{StaticResource DatePickerEstilo}"
                    SelectedDateChanged="dpFecha_Changed"
                             Width="180" />

                <TextBlock Text="HASTA:" Foreground="#4A4A7A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <DatePicker x:Name="dpHasta"
    Style="{StaticResource DatePickerEstilo}"
    SelectedDateChanged="dpFecha_Changed"
             Width="180"/>
                
            </StackPanel>
        </Grid>

        <!-- ══════════════════ DATAGRID + PANEL ══════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATAGRID -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00E676" Offset="0"/>
                                <GradientStop Color="#00CFFF" Offset="0.5"/>
                                <GradientStop Color="#12121E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="gridMovimientos"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="56"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A1A2E">
                        <DataGrid.Columns>

                            <!-- Indicador visual: barra de color a la izquierda -->
                            <DataGridTemplateColumn Width="6" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="4" CornerRadius="2" Margin="2,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF5555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsIngreso}" Value="True">
                                                            <Setter Property="Background" Value="#00E676"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tipo badge -->
                            <DataGridTemplateColumn Header="TIPO" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A0A0A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsIngreso}" Value="True">
                                                            <Setter Property="Background" Value="#0A2A14"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TipoTexto}" FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF6666"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsIngreso}" Value="True">
                                                                <Setter Property="Foreground" Value="#00E676"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="DESCRIPCIÓN"
                                                Binding="{Binding DescripcionInteligente}" Width="2*"/>

                            <DataGridTextColumn Header="SOCIO"
                                                Binding="{Binding SocioNombre}" Width="1.4*"/>

                            <!-- Monto con signo -->
                            <DataGridTemplateColumn Header="MONTO" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MontoConSigno}"
                                                   FontWeight="Bold" FontFamily="Consolas" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsIngreso}" Value="True">
                                                            <Setter Property="Foreground" Value="#00E676"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Método -->
                            <DataGridTemplateColumn Header="MÉTODO" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A30" CornerRadius="6"
                                                Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding MetodoPagoTexto}"
                                                       FontSize="11" Foreground="#A0A0C0"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding FechaCorta}" Width="0.9*"/>

                            <DataGridTextColumn Header="REGISTRADO POR"
                                                Binding="{Binding UsuarioNombre}" Width="1*"/>

                            <!-- Acción: eliminar (solo para gastos / movimientos manuales) -->
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="btnEliminar_Click"
        Background="Transparent" BorderThickness="0"
        Cursor="Hand" ToolTip="Eliminar movimiento"
        Style="{StaticResource ButtonStyleCancelar}">
                                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold"
               Foreground="#FF5555"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════ PANEL FORMULARIO ══════════════════ -->
            <Border x:Name="panelFormulario" Grid.Column="1" Width="380"
                    Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1"
                    Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="lineaSuperior" Grid.Row="0" Background="#00E676"/>

                    <StackPanel Grid.Row="1" Margin="22,18,22,0">
                        <TextBlock x:Name="lblTituloFormulario" Text="REGISTRAR INGRESO"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="15" FontWeight="Bold" Foreground="#E8E8FF"/>
                        <Border Height="1" Background="#252540" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                        <StackPanel>

                            <TextBlock Text="CONCEPTO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbConcepto" BorderThickness="0" Background="Transparent"
          Foreground="#E8E8FF" VerticalContentAlignment="Center"
          FontSize="13" Padding="10,0" IsEditable="True" Style="{StaticResource ComboBoxEstilo}">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                </ComboBox.Resources>
                            </ComboBox>
                            <TextBlock x:Name="errConcepto" Style="{StaticResource LabelErrorEstilo}"/>

                            <TextBlock Text="MONTO * ($)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtMonto" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtMonto_PreviewTextInput"
                                     LostFocus="txtMonto_LostFocus"/>
                            <TextBlock x:Name="errMonto" Style="{StaticResource LabelErrorEstilo}"/>

                            <Border x:Name="panelPreviewMonto" Background="#0A1A0A" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="lblPreviewIcono" Text="💰" FontSize="16"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblPreviewMonto" Text="$0"
                                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                               Foreground="#00E676" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="MÉTODO DE PAGO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbMetodoPago" BorderThickness="0" Background="Transparent" Style="{StaticResource ComboBoxEstilo}"
          Foreground="#E8E8FF" VerticalContentAlignment="Center"
          FontSize="13" Padding="10,0">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A2E"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8FF"/>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Efectivo"      Tag="efectivo"      Foreground="#E8E8FF" IsSelected="True"/>
                                <ComboBoxItem Content="Transferencia" Tag="transferencia" Foreground="#E8E8FF"/>
                                <ComboBoxItem Content="Tarjeta"       Tag="tarjeta"       Foreground="#E8E8FF"/>
                                <ComboBoxItem Content="Otro"          Tag="otro"          Foreground="#E8E8FF"/>
                            </ComboBox>

                            <TextBlock Text="DETALLE (opcional)" Style="{StaticResource LabelCampoEstilo}"/>
                            <Border Background="#16162A" CornerRadius="10"
                                    BorderBrush="#252540" BorderThickness="1.5"
                                    Margin="0,0,0,14">
                                <TextBox x:Name="txtDetalle"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#E8E8FF" CaretBrush="#00CFFF"
                                         FontSize="13" Padding="14,10"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource BotonCerrarEstilo}"
                                Margin="0,0,8,0" Click="btnCancelarFormulario_Click"/>
                        <Button x:Name="btnGuardar" Grid.Column="1" Content="REGISTRAR"
                                Style="{StaticResource BotonPrincipalEstilo}"
                                Margin="8,0,0,0" Click="btnGuardar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
