<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.CajaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1360"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      Title="Caja">

    <Page.Background>
        <SolidColorBrush Color="#080A08"/>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="#1E0A0A"/>
                <Setter Property="BorderBrush"     Value="{StaticResource ColorError}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="#FF5555"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                                <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,6"/>
            </Style>

            <!-- Estilo para botones de rango rápido -->
            <Style x:Key="BtnRangoEstilo" TargetType="Button">
                <Setter Property="Background"      Value="{StaticResource Bg2}"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush"     Value="{StaticResource Border1}"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Padding"         Value="10,4"/>
                <Setter Property="FontSize"        Value="10"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Height"          Value="26"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="borde" Property="Background" Value="{StaticResource Bg3}"/>
                                    <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource GreenMid}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GreenMid}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Estilo hover para filas del DataGrid -->
            <Style x:Key="FilaMovimientoEstilo" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bg3}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bg3}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,16,24,16" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0" Background="#00E676"/>
                <StackPanel>
                    <TextBlock Text="CAJA Y MOVIMIENTOS"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="lblSubtituloCaja"
                               Text="Ingresos, gastos y balance del gimnasio"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtBuscar"
                         Tag="Buscar movimiento..." Style="{StaticResource BuscadorStyle}"
                         Width="290" Margin="0,0,12,0" TextChanged="txtBuscar_TextChanged"/>
                <Button x:Name="btnIngresoCaja" Content="+ INGRESO" Style="{StaticResource ButtonIngresoStyle}"
                        Click="btnIngreso_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnGastoCaja" Content="− GASTO" Style="{StaticResource ButtonGastoStyle}"
                        Click="btnGasto_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ DASHBOARD BALANCE ══════════════════ -->
        <Grid x:Name="panelEstadisticasCaja" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Card balance del día — mejorada -->
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="12"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                    Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <fa:ImageAwesome Icon="Dollar"
                                         Foreground="{StaticResource GreenMain}"
                                         Height="16" Width="16"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                        <TextBlock Text="BALANCE DEL DÍA" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="lblBalanceDia" Text="+$0"
                               FontFamily="Bahnschrift SemiBold, Consolas"
                               FontSize="34" FontWeight="Bold" Foreground="#00E676"
                               Margin="0,0,0,8"/>

                    <!-- Barra de progreso ingresos vs gastos -->
                    <Grid Grid.Row="2" Margin="0,0,0,10" Height="4">
                        <Border CornerRadius="2" Background="{StaticResource Bg4}"/>
                        <Border x:Name="barraBalance" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="#00E676"/>
                    </Grid>

                    <!-- Detalle ingresos / gastos — mejorado -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ingresos -->
                        <Border Grid.Column="0" Background="{StaticResource Bg3}" CornerRadius="8"
                                Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <fa:ImageAwesome Icon="ArrowUp"
                                                     Foreground="#00E676"
                                                     Height="10" Width="10"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0"/>
                                    <TextBlock Text="Ingresos" Foreground="#00A855"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="lblIngresosDia" Text="$0"
                                           Foreground="#00E676" FontFamily="Consolas"
                                           FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Gastos -->
                        <Border Grid.Column="1" Background="{StaticResource Bg4}" CornerRadius="8"
                                Padding="10,8" Margin="6,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <fa:ImageAwesome Icon="ArrowDown"
                                                     Foreground="#FF5555"
                                                     Height="10" Width="10"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0"/>
                                    <TextBlock Text="Gastos" Foreground="#CC3333"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="lblGastosDia" Text="$0"
                                           Foreground="#FF5555" FontFamily="Consolas"
                                           FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Mini gráfico 7 días + balance del mes -->
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="12"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                             <fa:ImageAwesome Icon="LineChart" Foreground="{StaticResource GreenMid}"
                                             Height="16" Width="16" VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                            <TextBlock Text="ÚLTIMOS 7 DÍAS" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="gridChart" Height="62" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="gridChartLabels" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>

                    <!-- Card balance del mes -->
                    <Border Grid.Column="1" Margin="20,0,0,0"
                            Background="{StaticResource Bg3}" CornerRadius="10"
                            BorderBrush="{StaticResource Border2}" BorderThickness="0.5"
                            Padding="16,12" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:ImageAwesome Icon="Calendar"
                                                 Foreground="{StaticResource GreenMid}"
                                                 Height="11" Width="11"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"/>
                                <TextBlock Text="BALANCE DEL MES"
                                            Foreground="{StaticResource TextSecondary}" FontSize="10"
                                           FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock x:Name="lblBalanceMes" Text="$0"
                                       FontFamily="Bahnschrift SemiBold"
                                        FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenMid}"/>
                            <TextBlock x:Name="lblMovimientosMes" Text="0 movim."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ FILTROS ══════════════════ -->
        <Grid x:Name="panelFiltrosCaja" Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Chips de filtro -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MOSTRAR:" Foreground="{StaticResource TextMuted}" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="chipTodos"    Content="Todos"    Click="chipFiltro_Click" Tag="todos"
                        Style="{StaticResource BotonChipActivoEstilo}" Margin="0,0,12,0"/>
                <Button x:Name="chipIngresos" Content="Ingresos" Click="chipFiltro_Click" Tag="ingreso"
                        Style="{StaticResource BotonChipEstilo}" Margin="0,0,12,0"/>
                <Button x:Name="chipGastos"   Content="Gastos"   Click="chipFiltro_Click" Tag="gasto"
                        Style="{StaticResource BotonChipEstilo}"/>
            </StackPanel>

            <!-- Selector de fechas + rangos rápidos -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Rangos rápidos -->
                <Button Content="Hoy"   Style="{StaticResource BtnRangoEstilo}"
                        Click="btnRangoHoy_Click"    Margin="0,0,10,0"/>
                <Button Content="Semana" Style="{StaticResource BtnRangoEstilo}"
                        Click="btnRangoSemana_Click" Margin="0,0,10,0"/>
                <Button Content="Mes"   Style="{StaticResource BtnRangoEstilo}"
                        Click="btnRangoMes_Click"    Margin="0,0,16,0"/>

                <TextBlock Text="DESDE:" Foreground="{StaticResource TextMuted}" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="dpDesde"
                            Style="{StaticResource DatePickerEstilo}"
                            SelectedDateChanged="dpFecha_Changed"
                            Width="150"/>

                <TextBlock Text="HASTA:" Foreground="{StaticResource TextMuted}" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <DatePicker x:Name="dpHasta"
                            Style="{StaticResource DatePickerEstilo}"
                            SelectedDateChanged="dpFecha_Changed"
                            Width="150"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ DATAGRID ══════════════════ -->
        <Grid Grid.Row="3">

            <!-- DATAGRID con footer de totales -->
            <Border Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" ClipToBounds="True">
               
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    

                    <!-- Línea superior verde -->
                    <Border Grid.Row="0" Background="{StaticResource GreenMid}"/>

                      <DataGrid Grid.Row="1" x:Name="gridMovimientos"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="48"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Border1}"
                              RowStyle="{StaticResource FilaMovimientoEstilo}">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Background" Value="{StaticResource Bg0}"/>
                                </Style>
                            </DataGrid.Resources>

                        <DataGrid.Columns>

                            <!-- Barra lateral de color -->
                            <DataGridTemplateColumn Width="6" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="3" CornerRadius="2" Margin="2,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF5555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsIngreso}" Value="True">
                                                            <Setter Property="Background" Value="#00E676"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- TIPO badge con ícono según tipo -->
                            <DataGridTemplateColumn Header="TIPO" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="7,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A0A0A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TipoTexto}" Value="Cuota">
                                                            <Setter Property="Background" Value="{StaticResource Bg3}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TipoTexto}" Value="Venta">
                                                            <Setter Property="Background" Value="{StaticResource Bg4}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TipoTexto}" Value="Clase">
                                                            <Setter Property="Background" Value="{StaticResource Bg3}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TipoTexto}" Value="Gasto">
                                                            <Setter Property="Background" Value="#2A0A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Ícono según tipo -->
                                                <fa:ImageAwesome Height="10" Width="10"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,5,0">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Icon"       Value="Times"/>
                                                            <Setter Property="Foreground" Value="#FF6666"/>
                                                            <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding TipoTexto}" Value="Cuota">
                                                                     <Setter Property="Icon"       Value="CreditCard"/>
                                                                     <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding TipoTexto}" Value="Venta">
                                                                     <Setter Property="Icon"       Value="ShoppingCart"/>
                                                                     <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                                 </DataTrigger>
                                                                <DataTrigger Binding="{Binding TipoTexto}" Value="Clase">
                                                                    <Setter Property="Icon"       Value="Heartbeat"/>
                                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TipoTexto}" Value="Gasto">
                                                                    <Setter Property="Icon"       Value="ArrowDown"/>
                                                                    <Setter Property="Foreground" Value="#FF6666"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                                <TextBlock Text="{Binding TipoTexto}" FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF6666"/>
                                                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TipoTexto}" Value="Cuota">
                                                                     <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding TipoTexto}" Value="Venta">
                                                                     <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                                 </DataTrigger>
                                                                <DataTrigger Binding="{Binding TipoTexto}" Value="Clase">
                                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="DESCRIPCIÓN"
                                                Binding="{Binding DescripcionInteligente}" Width="2*"/>

                            <DataGridTextColumn Header="SOCIO"
                                                Binding="{Binding SocioNombre}" Width="1.2*"/>

                            <!-- Monto con signo — alineado a la derecha -->
                            <DataGridTemplateColumn Header="MONTO" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MontoConSigno}"
                                                   FontWeight="Bold" FontFamily="Consolas"
                                                   FontSize="14" HorizontalAlignment="left"
                                                   Margin="0,0,12,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsIngreso}" Value="True">
                                                            <Setter Property="Foreground" Value="#00E676"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Método -->
                            <DataGridTemplateColumn Header="MÉTODO" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Bg4}" CornerRadius="6"
                                                Padding="8, 4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:ImageAwesome Height="9" Width="25"
                                                                 Foreground="{StaticResource TextMuted}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,2,2,0">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Icon" Value="Money"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MetodoPagoTexto}" Value="Transferencia">
                                                                    <Setter Property="Icon" Value="Exchange"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MetodoPagoTexto}" Value="Tarjeta">
                                                                    <Setter Property="Icon" Value="CreditCard"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                                <TextBlock Text="{Binding MetodoPagoTexto}"
                                                           FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding FechaCorta}" Width="0.9*"/>

                            <DataGridTextColumn Header="REGISTRADO POR"
                                                Binding="{Binding UsuarioNombre}" Width="1*"/>

                            <!-- Eliminar -->
                            <!-- Eliminar -->
                            <DataGridTemplateColumn x:Name="colAccion" Header="Accion" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="btnEliminar_Click"
                                                Cursor="Hand" ToolTip="Eliminar movimiento"
                                                Style="{StaticResource ButtonStyleCancelar}">
                                            <fa:ImageAwesome Icon="TrashOutline"
                                                             Foreground="#FF5555"
                                                             Height="13" Width="13"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Footer de totales del período ── -->
                    <Border x:Name="footerTotalesCaja" Grid.Row="2" Background="{StaticResource Bg2}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="Filter" Foreground="{StaticResource TextMuted}"
                                                 Height="11" Width="11" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblTotalRegistros" Text="0 movimientos"
                                           Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            </StackPanel>

                            <!-- Total ingresos período -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,24,0">
                                <fa:ImageAwesome Icon="ArrowUp" Foreground="#00A855"
                                                 Height="10" Width="10" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="Ingresos:" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblTotalIngresos" Text="$0"
                                           Foreground="#00E676" FontFamily="Consolas"
                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Total gastos período -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,24,0">
                                <fa:ImageAwesome Icon="ArrowDown" Foreground="#CC3333"
                                                 Height="10" Width="10" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="Gastos:" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblTotalGastos" Text="$0"
                                           Foreground="#FF5555" FontFamily="Consolas"
                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Neto período -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Neto:" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="Bold"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblTotalNeto" Text="$0"
                                           FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF5555"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=lblTotalNeto, Path=Tag}" Value="positivo">
                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
