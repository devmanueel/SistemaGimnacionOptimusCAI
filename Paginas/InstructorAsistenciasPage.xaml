<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.InstructorAsistenciasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Asistencias de Instructores">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0A14" Offset="0"/>
            <GradientStop Color="#0D0D22" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#4A4A7A"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A78BFA" Offset="0"/>
                            <GradientStop Color="#00E676" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="ASISTENCIAS DE INSTRUCTORES"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="#E8E8FF"/>
                    <TextBlock Text="Fichaje y control de presencia"
                               FontSize="12" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- Reloj en vivo -->
            <Border Grid.Column="1" Background="#12121E" CornerRadius="10"
                    BorderBrush="#252540" BorderThickness="1" Padding="16,8">
                <StackPanel>
                    <TextBlock x:Name="lblReloj" Text="00:00:00"
                               FontFamily="Bahnschrift SemiBold, Consolas"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#A78BFA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblFecha" Text="—"
                               FontSize="10" Foreground="#6A6A9A"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statHoy" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#00CFFF"/>
                    <TextBlock Text="ASISTENCIAS HOY" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statAbiertas" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#FFA726"/>
                    <TextBlock Text="EN CURSO" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="4,0,4,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statInstructores" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#00E676"/>
                    <TextBlock Text="INSTRUCTORES HOY" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="10"
                    Background="#12121E" BorderBrush="#252540" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="statMes" Text="—" FontFamily="Bahnschrift SemiBold"
                               FontSize="26" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text="ASISTENCIAS DEL MES" FontSize="10" Foreground="#6A6A9A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CONTENIDO: Turnos de hoy + Historial -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ PANEL TURNOS DE HOY (fichaje rapido) ══ -->
            <Border Grid.Column="0" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#00E676" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,18,22,12">
                        <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="TURNOS DE HOY"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="14" FontWeight="Bold" Foreground="#E8E8FF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Padding="16,0,16,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" x:Name="panelSinTurnos"
                                        HorizontalAlignment="Center" Margin="0,40,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="No hay turnos hoy"
                                           FontSize="13" Foreground="#6A6A9A"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" x:Name="panelTurnosHoy"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ HISTORIAL ══ -->
            <Border Grid.Column="1" Background="#12121E" CornerRadius="12"
                    BorderBrush="#252540" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00CFFF" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Grid.Row="1" Margin="22,18,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="HISTORIAL"
                                       FontFamily="Bahnschrift SemiBold"
                                       FontSize="14" FontWeight="Bold" Foreground="#E8E8FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filtro fechas -->
                    <Grid Grid.Row="2" Margin="22,20,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DESDE:" Foreground="#4A4A7A" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpDesde" Style="{StaticResource DatePickerEstilo}" 
                    Width="140" Height="42" Margin="0,0,15,0"
                    SelectedDateChanged="dpFecha_Changed"/>

                            <TextBlock Text="HASTA:" Foreground="#4A4A7A" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpHasta" Style="{StaticResource DatePickerEstilo}" 
                    Width="140" Height="42" Margin="0, 0,0 ,0"
                    SelectedDateChanged="dpFecha_Changed"/>
                        </StackPanel>

                        <TextBox x:Name="txtBuscar" Tag="Buscar instructor..." Grid.Column="1"
             Style="{StaticResource BuscadorStyle}" Width="290" Height="42"
             VerticalAlignment="Center" TextChanged="txtBuscar_TextChanged"/>
                    </Grid>

                    <DataGrid Grid.Row="3" x:Name="gridHistorial"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="58"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A1A2E">
                        <DataGrid.Columns>

                            <!-- Indicador lateral -->
                            <DataGridTemplateColumn Width="6" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="4" CornerRadius="2" Margin="2,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#00E676"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                            <Setter Property="Background" Value="#FFA726"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Foto + nombre -->
                            <DataGridTemplateColumn Header="INSTRUCTOR" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Margin="0,0,10,0">
                                                <Ellipse Width="38" Height="38">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#A78BFA" Offset="0"/>
                                                            <GradientStop Color="#00CFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Width="34" Height="34">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding InstructorFoto, Converter={StaticResource BytesAImagen}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InstructorNombre}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="#E8E8FF"/>
                                                <TextBlock Text="{Binding ActividadNombre}"
                                                           FontSize="11" Foreground="#A78BFA"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding FechaCorta}" Width="0.7*"/>

                            <DataGridTemplateColumn Header="ENTRADA" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HoraEntradaTexto}"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   FontSize="13" Foreground="#00E676"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SALIDA" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HoraSalidaTexto}"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF6B35"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFA726"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="DURACIÓN"
                                                Binding="{Binding DuracionTexto}" Width="0.8*"/>

                            <!-- Estado badge -->
                            <DataGridTemplateColumn Header="ESTADO" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#0A2A14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                            <Setter Property="Background" Value="#2A1F00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoTexto}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#00E676"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFA726"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="32" Height="32" CornerRadius="8" Background="#1A1A30">
                                            <Button Click="btnEliminar_Click"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Eliminar">
                                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold"
                                                           Foreground="#FF5555"/>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
