<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.InstructorAsistenciasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1360"
      Title="Asistencias de Instructores">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="ASISTENCIAS DE INSTRUCTORES"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Fichaje y control de presencia"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="10"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,8">
                <StackPanel>
                    <TextBlock x:Name="lblReloj" Text="00:00:00"
                               FontFamily="Bahnschrift SemiBold, Consolas"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource GreenMain}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblFecha" Text="—"
                               FontSize="10" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="statHoy" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ASISTENCIAS HOY" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="CheckCircle" Foreground="{StaticResource GreenMain}" Height="28" Width="28" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="statAbiertas" Text="—" FontSize="26" FontWeight="Bold" Foreground="#D4830A"/>
                        <TextBlock Text="EN CURSO" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="ClockOutline" Foreground="#D4830A" Height="28" Width="28" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="statInstructores" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="INSTRUCTORES HOY" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Users" Foreground="{StaticResource GreenMain}" Height="28" Width="28" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="statMes" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ASISTENCIAS DEL MES" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Calendar" Foreground="{StaticResource GreenMain}" Height="28" Width="28" Opacity="0.3" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="2">
            <!-- PANEL ADMIN -->
            <Border x:Name="borderAdmin"
                    Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#4ADE80"/>

                        <!-- Tabs -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="btnTabHistorial" Content="HISTORIAL"
                                    Style="{StaticResource TabBtnEstilo}"
                                    Click="btnTabHistorial_Click"/>
                            <Button x:Name="btnTabSemanal" Content="REPORTE SEMANAL"
                                    Style="{StaticResource TabBtnEstilo}"
                                    Click="btnTabSemanal_Click"/>
                            <Button x:Name="btnTabMensual" Content="REPORTE MENSUAL"
                                    Style="{StaticResource TabBtnEstilo}"
                                    Click="btnTabMensual_Click"/>
                        </StackPanel>

                        <!-- ─── TAB HISTORIAL ─── -->
                        <Grid x:Name="panelHistorial" Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Filtros -->
                            <Grid Grid.Row="0" Margin="22,14,22,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DESDE:" Foreground="{StaticResource TextMuted}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="dpDesde" Style="{StaticResource DatePickerEstilo}"
                                                Width="140" Height="42" Margin="0,0,15,0"
                                                SelectedDateChanged="dpFecha_Changed"/>
                                    <TextBlock Text="HASTA:" Foreground="{StaticResource TextMuted}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="dpHasta" Style="{StaticResource DatePickerEstilo}"
                                                Width="140" Height="42"
                                                SelectedDateChanged="dpFecha_Changed"/>
                                </StackPanel>
                                <TextBox x:Name="txtBuscar" Tag="Buscar instructor..." Grid.Column="1"
                                         Style="{StaticResource BuscadorStyle}" Width="250" Height="42"
                                         VerticalAlignment="Center" TextChanged="txtBuscar_TextChanged"/>
                            </Grid>

                            <!-- DataGrid historial -->
                            <DataGrid Grid.Row="1" x:Name="gridHistorial"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeaderWidth="0" RowHeight="56"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#111811"
                                      SelectionMode="Single"
                                      SelectionChanged="gridHistorial_SelectionChanged">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Width="6" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="4" CornerRadius="2" Margin="2,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#00E676"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                    <Setter Property="Background" Value="#D4830A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="INSTRUCTOR" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Margin="0,0,10,0">
                                                        <Ellipse Width="36" Height="36">
                                                            <Ellipse.Fill><SolidColorBrush Color="#4ADE80"/></Ellipse.Fill>
                                                        </Ellipse>
                                                        <Ellipse Width="32" Height="32">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding InstructorFoto, Converter={StaticResource BytesAImagen}}"
                                                                            Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding InstructorNombre}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding ActividadNombre}"
                                                                   FontSize="11" Foreground="{StaticResource GreenMain}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaCorta}" Width="0.7*"/>

                                    <DataGridTemplateColumn Header="ENTRADA" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HoraEntradaTexto}"
                                                           FontFamily="Consolas" FontWeight="Bold"
                                                           Margin="3,0,0,0" FontSize="13" Foreground="#00E676"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="SALIDA" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HoraSalidaTexto}"
                                                           FontFamily="Consolas" FontWeight="Bold"
                                                           Margin="3,0,0,0" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D4830A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="HORAS" Binding="{Binding HorasTrabajadasTexto}" Width="0.8*"/>

                                    <DataGridTemplateColumn Header="ESTADO" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="10,4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0A2A14"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                    <Setter Property="Background" Value="#1E1600"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#00E676"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                        <Setter Property="Foreground" Value="#D4830A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Click="btnEditarFichaje_Click"
                                                            Style="{StaticResource ButtonStyleEditar}"
                                                            Cursor="Hand" ToolTip="Editar" Margin="0,0,6,0">
                                                        <fa:ImageAwesome Icon="Pencil" Foreground="#00CFFF" Height="13"/>
                                                    </Button>
                                                    <Button Click="btnEliminar_Click"
                                                            Style="{StaticResource ButtonStyleCancelar}"
                                                            Cursor="Hand" ToolTip="Eliminar">
                                                        <fa:ImageAwesome Icon="Times" Foreground="#FF5555" Height="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Panel edición de fichaje -->
                            <Border x:Name="panelEditarFichaje" Grid.Row="2" Visibility="Collapsed"
                                    Background="#090F09" BorderThickness="0,1,0,0"
                                    BorderBrush="#1E281E" Padding="22,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="CORREGIR:" FontWeight="Bold" FontSize="10"
                                                   Foreground="{StaticResource GreenMain}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="lblEditarInstructor"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,24,0"/>
                                        <TextBlock Text="ENTRADA:" Foreground="{StaticResource TextMuted}"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="txtEditHoraEntrada" Width="80" Height="36"
                                                 Style="{StaticResource InputEstilo}"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,20,0"/>
                                        <TextBlock Text="SALIDA:" Foreground="{StaticResource TextMuted}"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="txtEditHoraSalida" Width="80" Height="36"
                                                 Style="{StaticResource InputEstilo}"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="GUARDAR" Style="{StaticResource BotonPrincipalEstilo}"
                                                Height="36" Width="100" Margin="0,0,8,0"
                                                Click="btnGuardarEdicion_Click"/>
                                        <Button Content="CANCELAR" Style="{StaticResource BotonGhostEstilo}"
                                                Height="36" Width="100"
                                                Click="btnCancelarEdicion_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ─── TAB REPORTE SEMANAL ─── -->
                        <Grid x:Name="panelSemanal" Grid.Row="2" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="22,14,22,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="SEMANA:" Foreground="{StaticResource TextMuted}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="dpSemanalDesde" Style="{StaticResource DatePickerEstilo}"
                                                Width="150" Height="42" Margin="0,0,12,0"/>
                                    <TextBlock Text="AL:" Foreground="{StaticResource TextMuted}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="dpSemanalHasta" Style="{StaticResource DatePickerEstilo}"
                                                Width="150" Height="42" Margin="0,0,12,0"/>
                                    <Button Content="BUSCAR" Style="{StaticResource BotonPrincipalEstilo}"
                                            Height="42" Width="90"
                                            Click="btnCargarSemanal_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="gridSemanal"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeaderWidth="0" RowHeight="50"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#111811">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INSTRUCTOR"  Binding="{Binding InstructorNombre}" Width="2*"/>
                                    <DataGridTextColumn Header="FECHA"       Binding="{Binding FechaCorta}"       Width="0.8*"/>
                                    <DataGridTemplateColumn Header="ENTRADA" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HoraEntradaTexto}" FontFamily="Consolas"
                                                           FontSize="13" Foreground="#00E676" Margin="3,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="SALIDA" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HoraSalidaTexto}" FontFamily="Consolas"
                                                           FontSize="13" Foreground="{StaticResource GreenMain}" Margin="3,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="HORAS"      Binding="{Binding HorasTrabajadasTexto}" Width="0.8*"/>
                                    <DataGridTemplateColumn Header="ESTADO" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0A2A14"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                    <Setter Property="Background" Value="#1E1600"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#00E676"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                        <Setter Property="Foreground" Value="#D4830A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- ─── TAB REPORTE MENSUAL ─── -->
                        <Grid x:Name="panelMensual" Grid.Row="2" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="22,14,22,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MES:" Foreground="{StaticResource TextMuted}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cmbMes" Style="{StaticResource ComboBoxEstilo}"
                                              Width="160" Height="42" Margin="0,0,12,0"/>
                                    <TextBlock Text="AÑO:" Foreground="{StaticResource TextMuted}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cmbAnio" Style="{StaticResource ComboBoxEstilo}"
                                              Width="100" Height="42" Margin="0,0,12,0"/>
                                    <Button Content="LIQUIDAR" Style="{StaticResource BotonPrincipalEstilo}"
                                            Height="42" Width="100"
                                            Click="btnCargarMensual_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="gridMensual"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeaderWidth="0" RowHeight="54"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#111811">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INSTRUCTOR"     Binding="{Binding NombreCompleto}"  Width="2*"/>
                                    <DataGridTextColumn Header="ACTIVIDAD"      Binding="{Binding ActividadNombre}" Width="1.2*"/>
                                    <DataGridTextColumn Header="DÍAS"           Binding="{Binding DiasAsistidos}"   Width="0.6*"/>
                                    <DataGridTextColumn Header="HORAS TOTALES"  Binding="{Binding TotalHorasTexto}" Width="1*"/>
                                    <DataGridTextColumn Header="TARIFA"         Binding="{Binding TarifaTexto}"     Width="0.8*"/>
                                    <DataGridTemplateColumn Header="SUELDO ESTIMADO" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SueldoTexto}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource GreenMain}"
                                                           VerticalAlignment="Center" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                    </Grid>
                </Border>
        </Grid>
    </Grid>
</Page>
