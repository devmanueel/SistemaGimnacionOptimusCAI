<Page x:Class="SistemaGimnacionOptimusCAI.Paginas.InstructorAsistenciasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:SistemaGimnacionOptimusCAI.Helpers"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      mc:Ignorable="d"
      d:DesignHeight="768" d:DesignWidth="1280"
      Title="Asistencias de Instructores">

    <Page.Background><SolidColorBrush Color="#080A08"/></Page.Background>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:ByteToImageConverter x:Key="BytesAImagen"/>
            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin"     Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="gridRaiz" Margin="24,20,24,20" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="gridRaiz"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.5"
                                         DecelerationRatio="0.6"/>
                        <DoubleAnimation Storyboard.TargetName="translateEntrada"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.5"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="translateEntrada" Y="20"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="ASISTENCIAS DE INSTRUCTORES"
                               FontFamily="Bahnschrift SemiBold, Segoe UI"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Fichaje y control de presencia"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- Reloj en vivo -->
            <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="10"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,8">
                <StackPanel>
                    <TextBlock x:Name="lblReloj" Text="00:00:00"
                               FontFamily="Bahnschrift SemiBold, Consolas"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource GreenMain}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblFecha" Text="—"
                               FontSize="10" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statHoy" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ASISTENCIAS HOY" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="CheckCircle"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statAbiertas" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="#D4830A"/>
                        <TextBlock Text="EN CURSO" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="ClockOutline"
                                     Foreground="#D4830A"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statInstructores" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="INSTRUCTORES HOY" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Users"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" CornerRadius="10"
                    Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="statMes" Text="—"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenMain}"/>
                        <TextBlock Text="ASISTENCIAS DEL MES" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <fa:ImageAwesome Grid.Column="1" Icon="Calendar"
                                     Foreground="{StaticResource GreenMain}"
                                     Height="28" Width="28"
                                     Opacity="0.3"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- CONTENIDO: Turnos de hoy + Historial -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="415"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ PANEL TURNOS DE HOY (fichaje rapido) ══ -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,18,22,12">
                        <fa:ImageAwesome Icon="Calendar" Foreground="#00E676" Height="25" Margin="0,0,8,0"/>
                        <TextBlock Text="TURNOS DE HOY"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI"
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="0,3, 0, 0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Padding="16,0,16,16"  Style="{StaticResource PanelScrollViewerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" x:Name="panelSinTurnos"
                                        HorizontalAlignment="Center" Margin="0,40,0,0"
                                        Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center" >
                                    <fa:ImageAwesome Icon="Calendar" Foreground="#FF000000" Opacity="0.4" Height="80" Margin="0, 50, 0, 10"/>
                                </TextBlock>
                                <TextBlock Text="No hay turnos hoy"
                                           FontSize="13" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0">
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="1" x:Name="panelTurnosHoy"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ HISTORIAL ══ -->
            <Border Grid.Column="1" Background="{StaticResource Bg1}" CornerRadius="12"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0.5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Border.Background><SolidColorBrush Color="#4ADE80"/></Border.Background>
                    </Border>

                    <Grid Grid.Row="1" Margin="22,18,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <fa:ImageAwesome Icon="History" Foreground="{StaticResource GreenMain}" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="HISTORIAL"
                                       FontFamily="Bahnschrift SemiBold"
                                       FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Filtro fechas -->
                    <Grid Grid.Row="2" Margin="22,20,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DESDE:" Foreground="{StaticResource TextMuted}" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpDesde" Style="{StaticResource DatePickerEstilo}" 
                    Width="140" Height="42" Margin="0,0,15,0"
                    SelectedDateChanged="dpFecha_Changed"/>

                            <TextBlock Text="HASTA:" Foreground="{StaticResource TextMuted}" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpHasta" Style="{StaticResource DatePickerEstilo}" 
                    Width="140" Height="42" Margin="0, 0,0 ,0"
                    SelectedDateChanged="dpFecha_Changed"/>
                        </StackPanel>

                        <TextBox x:Name="txtBuscar" Tag="Buscar instructor..." Grid.Column="1"
             Style="{StaticResource BuscadorStyle}" Width="290" Height="42"
             VerticalAlignment="Center" TextChanged="txtBuscar_TextChanged"/>
                    </Grid>

                    <DataGrid Grid.Row="3" x:Name="gridHistorial"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="58"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#111811">
                        <DataGrid.Columns>

                            <!-- Indicador lateral -->
                            <DataGridTemplateColumn Width="6" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="4" CornerRadius="2" Margin="2,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#00E676"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                            <Setter Property="Background" Value="#D4830A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Foto + nombre -->
                            <DataGridTemplateColumn Header="INSTRUCTOR" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Margin="0,0,10,0">
                                                <Ellipse Width="38" Height="38">
                                                    <Ellipse.Fill><SolidColorBrush Color="#4ADE80"/></Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Width="34" Height="34">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding InstructorFoto, Converter={StaticResource BytesAImagen}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InstructorNombre}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding ActividadNombre}"
                                                           FontSize="11" Foreground="{StaticResource GreenMain}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding FechaCorta}" Width="0.7*"/>

                            <DataGridTemplateColumn Header="ENTRADA" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HoraEntradaTexto}"
                                                   FontFamily="Consolas" FontWeight="Bold" Margin="3, 0, 0, 0"
                                                   FontSize="13" Foreground="#00E676"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SALIDA" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HoraSalidaTexto}"
                                                   FontFamily="Consolas" FontWeight="Bold" Margin="3, 0, 0, 0"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource GreenMain}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                            <Setter Property="Foreground" Value="#D4830A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="DURACIÓN"
                                                Binding="{Binding DuracionTexto}" Width="0.8*"/>

                            <!-- Estado badge -->
                            <DataGridTemplateColumn Header="ESTADO" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="10,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#0A2A14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                            <Setter Property="Background" Value="#1E1600"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoTexto}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#00E676"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AsistenciaAbierta}" Value="True">
                                                                <Setter Property="Foreground" Value="#D4830A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="btnEliminar_Click"
                                                Style="{StaticResource ButtonStyleCancelar}"
                                                Cursor="Hand" ToolTip="Eliminar">
                                            <fa:ImageAwesome Icon="Times" Foreground="#FF5555" Height="14"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

