<Window x:Class="SistemaGimnacionOptimusCAI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimusCAI — Acceso"
        Height="620" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="InputErrorEstilo" TargetType="TextBox" BasedOn="{StaticResource InputEstilo}">
                <Setter Property="Background"      Value="{StaticResource BrushVencidaFondo}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource ColorError}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>

            <Style x:Key="LabelErrorEstilo" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="Foreground"   Value="{StaticResource ColorError}"/>
                <Setter Property="Margin"       Value="4,-10,0,8"/>
                <Setter Property="FontStyle"    Value="Italic"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Permite mover la ventana arrastrando -->
    <Border x:Name="borderRaiz" CornerRadius="16"
            BorderBrush="{StaticResource Border1}" BorderThickness="1"
            Background="{StaticResource Bg1}"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <!-- Franja de color superior -->
                <RowDefinition Height="Auto"/>
                <!-- Logo + título -->
                <RowDefinition Height="*"/>
                <!-- Formulario -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Franja verde superior -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{StaticResource GreenMain}"/>

            <!-- Logo -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,36,0,28">
                <Image Source="/Assets/Logo-gimnasio.png" 
                       Width="250" 
                       Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Sistema de Gestión"
                           FontSize="12" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Formulario -->
            <StackPanel Grid.Row="2" Margin="40,0,40,0">

                <!-- DNI -->
                <TextBlock Text="DNI" Style="{StaticResource LabelCampoEstilo}"/>
                <Border Background="{StaticResource Bg4}" CornerRadius="10" Height="48"
                        BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0, 0, 0, 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👤" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDni" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource GreenMain}"
                                 FontSize="16" FontFamily="Consolas"
                                 VerticalContentAlignment="Center"
                                 MaxLength="8"
                                 PreviewTextInput="txtDni_PreviewTextInput"
                                 KeyDown="txtDni_KeyDown"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="errDni" Text="" Visibility="Collapsed" Style="{StaticResource LabelErrorEstilo}"/>

                <!-- Contraseña -->
                <TextBlock Text="CONTRASEÑA" Style="{StaticResource LabelCampoEstilo}"/>
                <Border Background="{StaticResource Bg4}" CornerRadius="10" Height="48"
                        BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔒" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <PasswordBox x:Name="txtPassword" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource GreenMain}"
                                     FontSize="16" VerticalContentAlignment="Center"
                                     PasswordChar="●"
                                     KeyDown="txtPassword_KeyDown"/>
                        <!-- Mostrar/ocultar contraseña -->
                        <Button Grid.Column="2" x:Name="btnTogglePass"
                                Click="btnTogglePass_Click"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Mostrar/ocultar">
                            <TextBlock x:Name="lblTogglePass" Text="👁" FontSize="15"
                                       Foreground="{StaticResource TextMuted}"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock x:Name="errPassword" Text="" Style="{StaticResource LabelErrorEstilo}" Visibility="Collapsed"/>

                <!-- Mensaje de error general -->
                <Border x:Name="panelError" Background="#2A0A0A"
                        BorderBrush="#FF4444" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="14" Foreground="#FF5555"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblError" Text=""
                                   Foreground="#FF8888" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Botón ingresar -->
                <Button x:Name="btnIngresar" 
        Height="50" FontSize="14" FontWeight="Bold"
        Cursor="Hand" Margin="0,0,0,0"
        Click="btnIngresar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource GreenMain}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <TextBlock Text="INGRESAR" FontFamily="Bahnschrift SemiBold, Segoe UI"
               FontSize="15" FontWeight="Bold" Foreground="White"/>
                </Button>

            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Margin="0,18,0,22">
                <TextBlock Text="OptimusCAI — Gestión de Gimnasio"
                           FontSize="10" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"/>
                <!-- Botón cerrar -->
                <Button Content="✕ Salir" Click="btnSalir_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}" FontSize="10"
                        Cursor="Hand" HorizontalAlignment="Center"
                        Margin="0,6,0,0"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
