<Window x:Class="SistemaGimnacionOptimusCAI.Ventanas.EjercicioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio"
        Width="460" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Bg1}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border1}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#4ADE80" CornerRadius="14,14,0,0"/>

            <Grid Grid.Row="1" Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblTituloFormulario" Text="NUEVO EJERCICIO"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}"
                        FontSize="14" Cursor="Hand"
                        Click="btnCerrar_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,14,22,0">
                <StackPanel>
                    <TextBlock Text="NOMBRE DEL EJERCICIO *"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                    <TextBox x:Name="txtEjjNombre" Style="{StaticResource InputEstilo}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERIES" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <TextBox x:Name="txtEjjSeries" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtSoloNumeros_PreviewTextInput" Text="3"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="REPETICIONES" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <TextBox x:Name="txtEjjRepeticiones" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtSoloNumeros_PreviewTextInput" Text="10"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PESO (kg)" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <TextBox x:Name="txtEjjPeso" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtDecimal_PreviewTextInput" Text="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DESCANSO (seg)" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <TextBox x:Name="txtEjjDescanso" Style="{StaticResource InputEstilo}"
                                     PreviewTextInput="txtSoloNumeros_PreviewTextInput" Text="60"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="NOTAS (observaciones, técnica, etc.)"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,14,0,6"/>
                    <Border Background="{StaticResource Bg2}" CornerRadius="10"
                            BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,14">
                        <TextBox x:Name="txtEjjNotas" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource GreenMain}" FontSize="13" Padding="14,10"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="80" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="22,12,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar"
                        Style="{StaticResource BotonDangerLargoEstilo}"
                        Margin="0,0,8,0" Click="btnCancelar_Click"/>
                <Button Grid.Column="1" Content="GUARDAR"
                        Style="{StaticResource BotonPrincipalEstilo}"
                        Margin="8,0,0,0" Click="btnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>