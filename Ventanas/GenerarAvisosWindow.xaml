<Window x:Class="SistemaGimnacionOptimusCAI.Ventanas.GenerarAvisosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar Avisos"
        Width="460" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Bg1}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border1}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#25D366" CornerRadius="14,14,0,0"/>

            <Grid Grid.Row="1" Margin="24,18,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔔" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="GENERAR AVISOS"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}"
                        FontSize="14" Cursor="Hand"
                        Click="btnCerrar_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="24,8,24,0">
                <TextBlock Text="Crea mensajes pendientes para socios con vencimiento proximo."
                           FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="DIAS DE ANTICIPACION" Foreground="{StaticResource TextMuted}"
                           FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                <TextBox x:Name="txtDiasAntes" Style="{StaticResource InputEstilo}"
                         PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                         Text="3"/>
                <TextBlock Text="Buscara membresias que vencen entre hoy y los proximos N dias."
                           FontSize="10" Foreground="{StaticResource TextMuted}" FontStyle="Italic"
                           Margin="2,-8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="24,12,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar"
                        Style="{StaticResource BotonDangerLargoEstilo}"
                        Margin="0,0,8,0" Click="btnCancelar_Click"/>
                <Button Grid.Column="1" Content="GENERAR"
                        Style="{StaticResource BotonPrincipalEstilo}"
                        Margin="8,0,0,0" Click="btnGenerar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>