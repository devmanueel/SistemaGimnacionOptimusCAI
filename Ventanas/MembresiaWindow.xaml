<Window x:Class="SistemaGimnacionOptimusCAI.Ventanas.MembresiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Membresía"
        Width="420" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Bg1}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border1}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#4ADE80" CornerRadius="14,14,0,0"/>

            <Grid Grid.Row="1" Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblTituloFormulario" Text="EDITAR MEMBRESÍA"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}"
                        FontSize="14" Cursor="Hand"
                        Click="btnCerrar_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" 
                          Margin="22,14,22,0" Style="{StaticResource DataGridScrollViewerStyle}">
                <StackPanel>
                    <TextBlock Text="SOCIO" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                    <ComboBox x:Name="cmbSocio" Style="{StaticResource ComboBoxEstilo}"
                              IsEnabled="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NombreCompleto}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="ACTIVIDAD *" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,14,0,6"/>
                    <ComboBox x:Name="cmbActividad" Style="{StaticResource ComboBoxEstilo}"
                              SelectionChanged="cmbActividad_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Nombre}" FontSize="13"/>
                                    <TextBlock Text=" — $" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding Precio, StringFormat=N0}" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="INSTRUCTOR (opcional)" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,14,0,6"/>
                    <ComboBox x:Name="cmbInstructor" Style="{StaticResource ComboBoxEstilo}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NombreCompleto}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="INICIO" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <DatePicker x:Name="dpInicio" Style="{StaticResource DatePickerEstilo}" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VENCIMIENTO" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                            <DatePicker x:Name="dpVencimiento" Style="{StaticResource DatePickerEstilo}" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="MONTO PAGADO * ($)" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,14,0,6"/>
                    <TextBox x:Name="txtMonto" Style="{StaticResource InputEstilo}"
                             PreviewTextInput="txtSoloNumerosYComa_PreviewTextInput"
                             TextChanged="txtMonto_TextChanged"
                             LostFocus="txtMonto_LostFocus"/>
                    <TextBlock x:Name="errMonto" Foreground="#FF5555"
                               FontSize="11" FontStyle="Italic" Margin="4,-6,0,8"
                               Visibility="Collapsed"/>

                    <Border x:Name="panelPreviewCobro" Visibility="Collapsed"
                            Background="{StaticResource Bg2}" CornerRadius="10"
                            BorderBrush="{StaticResource GreenMain}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL A COBRAR"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="lblPreviewActividad"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="lblPreviewMonto" Grid.Column="1"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource GreenMain}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="panelUpgrade" Background="#0A1F0A" CornerRadius="8"
                            BorderBrush="{StaticResource GreenDim}" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="MEJORA DE PLAN"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource GreenMain}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblUpgradeDetalle" Text="Diferencia a cobrar:"
                                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblUpgradeMonto" Text="$0"
                                               FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource GreenMain}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblUpgradeNivel" Text="⬆ Nivel"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#00C850" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MÉTODO DE PAGO *" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                    <ComboBox x:Name="cmbMetodoPago" Style="{StaticResource ComboBoxEstilo}">
                        <ComboBoxItem Content="Efectivo" Tag="efectivo" IsSelected="True"/>
                        <ComboBoxItem Content="Transferencia" Tag="transferencia"/>
                        <ComboBoxItem Content="Tarjeta" Tag="tarjeta"/>
                        <ComboBoxItem Content="Otro" Tag="otro"/>
                    </ComboBox>

                    <TextBlock Text="OBSERVACIONES" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,14,0,6"/>
                    <Border Background="{StaticResource Bg2}" CornerRadius="10"
                            BorderBrush="{StaticResource Border1}" BorderThickness="1.5" Margin="0,0,0,14">
                        <TextBox x:Name="txtObservaciones" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource GreenMain}" FontSize="13" Padding="14,10"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="80" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="22,12,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar"
                        Style="{StaticResource BotonDangerLargoEstilo}"
                        Margin="0,0,8,0" Click="btnCancelar_Click"/>
                <Button x:Name="btnGuardar" Grid.Column="1" Content="GUARDAR"
                        Style="{StaticResource BotonPrincipalEstilo}"
                        Margin="8,0,0,0" Click="btnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
