<Window x:Class="SistemaGimnacionOptimusCAI.Ventanas.BloqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloque"
        Width="400" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource Bg1}"
            CornerRadius="14"
            BorderBrush="{StaticResource Border1}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#4ADE80" CornerRadius="14,14,0,0"/>

            <Grid Grid.Row="1" Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblTituloFormulario" Text="NUEVO BLOQUE"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}"
                        FontSize="14" Cursor="Hand"
                        Click="btnCerrar_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="22,14,22,0">
                <TextBlock Text="NOMBRE DEL BLOQUE *"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                <TextBox x:Name="txtBlqNombre" Style="{StaticResource InputEstilo}"/>

                <TextBlock Text="ORDEN"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="10" FontWeight="Bold" Margin="2,12,0,6"/>
                <TextBox x:Name="txtBlqOrden" Style="{StaticResource InputEstilo}"
                         PreviewTextInput="txtSoloNumeros_PreviewTextInput"
                         Text="1"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="22,12,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar"
                        Style="{StaticResource BotonDangerLargoEstilo}"
                        Margin="0,0,8,0" Click="btnCancelar_Click"/>
                <Button Grid.Column="1" Content="GUARDAR"
                        Style="{StaticResource BotonPrincipalEstilo}"
                        Margin="8,0,0,0" Click="btnGuardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>