<Window x:Class="SistemaGimnacionOptimusCAI.Ventanas.EditarSocioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar datos del socio"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LabelCampoEstilo" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="FontFamily"  Value="Segoe UI Semibold, Segoe UI"/>
                <Setter Property="Margin"      Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Bg1}" CornerRadius="14"
            BorderBrush="{StaticResource Border1}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior decorativa -->
            <Border Grid.Row="0" Background="{StaticResource GreenMid}" CornerRadius="14,14,0,0"/>

            <!-- Header -->
            <Grid Grid.Row="1" Margin="24,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="EDITAR DATOS DEL SOCIO" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="lblSubtitulo" Text="Modificá los datos personales"
                               FontSize="12" Foreground="{StaticResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}" FontSize="14" Cursor="Hand"
                        Click="btnCerrar_Click"/>
            </Grid>

            <!-- Contenido -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                          Margin="24,16,12,0" Style="{StaticResource PanelScrollViewerStyle}">
                <StackPanel>

                    <!-- Foto -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Grid>
                            <Ellipse Width="90" Height="90">
                                <Ellipse.Fill><SolidColorBrush Color="#1C2A1C"/></Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="84" Height="84" HorizontalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="imgFoto" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Button Width="24" Height="24"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Cursor="Hand" Click="btnCambiarFoto_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="12" Background="{StaticResource GreenMain}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="📷" FontSize="11"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Nombre y Apellido -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NOMBRE *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource InputEstilo}" MaxLength="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="APELLIDO *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtApellido" Style="{StaticResource InputEstilo}" MaxLength="100"/>
                        </StackPanel>
                    </Grid>

                    <!-- DNI y Fecha de nacimiento -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DNI * (7 u 8 dígitos)" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtDni" Style="{StaticResource InputEstilo}" MaxLength="8"
                                     PreviewTextInput="txtDni_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource LabelCampoEstilo}"/>
                            <DatePicker x:Name="dpNacimiento" Style="{StaticResource DatePickerEstilo}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sexo y Teléfono -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SEXO" Style="{StaticResource LabelCampoEstilo}"/>
                            <ComboBox x:Name="cmbSexo" Style="{StaticResource ComboBoxEstilo}">
                                <ComboBoxItem Content="Masculino" Tag="M"/>
                                <ComboBoxItem Content="Femenino"  Tag="F"/>
                                <ComboBoxItem Content="Otro"      Tag="Otro" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CELULAR *" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtTelefono" Style="{StaticResource InputEstilo}" MaxLength="20"/>
                        </StackPanel>
                    </Grid>

                    <!-- Email y Domicilio -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EMAIL" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtEmail" Style="{StaticResource InputEstilo}" MaxLength="191"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DOMICILIO" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtDomicilio" Style="{StaticResource InputEstilo}" MaxLength="200"/>
                        </StackPanel>
                    </Grid>

                    <!-- Profesión -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROFESIÓN" Style="{StaticResource LabelCampoEstilo}"/>
                            <TextBox x:Name="txtProfesion" Style="{StaticResource InputEstilo}" MaxLength="100"/>
                        </StackPanel>
                    </Grid>

                    <!-- Observaciones -->
                    <TextBlock Text="OBSERVACIONES" Style="{StaticResource LabelCampoEstilo}" Margin="2,14,0,6"/>
                    <Border Background="{StaticResource Bg2}" CornerRadius="8"
                            BorderBrush="{StaticResource Border2}" BorderThickness="1">
                        <TextBox x:Name="txtObservaciones"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource GreenMain}"
                                 FontSize="13" Padding="12,10"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="70" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="24,14,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblError" Grid.Column="0" Text="" FontSize="11"
                           Foreground="{StaticResource ColorError}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <Button Grid.Column="1" Content="Cancelar" Click="btnCancelar_Click"
                        Style="{StaticResource BotonDangerLargoEstilo}"
                        Padding="18,0" Width="110" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="GUARDAR CAMBIOS" Click="btnGuardar_Click"
                        Style="{StaticResource BotonPrincipalEstilo}"
                        Height="40" Padding="24,0" FontSize="12" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
