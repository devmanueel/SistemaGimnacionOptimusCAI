<Window x:Class="SistemaGimnacionOptimusCAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimusCAI Gym"
        Height="800" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#0A0A14">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0" Background="#0D0D22"
                BorderBrush="#1A1A2E" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Usuario -->
                    <RowDefinition Height="*"/>
                    <!-- Menu -->
                    <RowDefinition Height="Auto"/>
                    <!-- Cerrar sesion -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,24,20,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6B35" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🥊" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OPTIMUS CAI"
                                       FontFamily="Bahnschrift SemiBold, Segoe UI"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#E8E8FF"/>
                            <TextBlock Text="Gimnasio"
                                       FontSize="10" Foreground="#6A6A9A"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Usuario logueado -->
                <Border Grid.Row="1" Margin="14,0,14,18" Padding="12,10"
                        Background="#16162A" CornerRadius="10"
                        BorderBrush="#252540" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00CFFF" Offset="0"/>
                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="lblUserIniciales" Text="?"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="lblUserNombre" Text="—"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E8E8FF"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="150"/>
                                <Border x:Name="badgeRol" CornerRadius="6"
                                        Padding="6,1" HorizontalAlignment="Left"
                                        Margin="0,2,0,0"
                                        Background="#2A1600">
                                    <TextBlock x:Name="lblUserRol" Text="—"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="#FF6B35"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menu de navegacion -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="panelMenu" Margin="10,0,10,10"/>
                </ScrollViewer>

                <!-- Cerrar sesion -->
                <Button Grid.Row="3" Click="btnLogout_Click"
                        Background="Transparent" Foreground="#FF5555"
                        BorderThickness="1" BorderBrush="#3A1A1A"
                        Cursor="Hand" Margin="14,8,14,18" Height="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CERRAR SESIÓN" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════ AREA DE CONTENIDO ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <!-- Barra superior con botones de ventana -->
                <RowDefinition Height="*"/>
                <!-- Frame -->
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="#0D0D22"
                    BorderBrush="#1A1A2E" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titulo de la pagina actual -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="lblPaginaActual" Text=""
                                   FontSize="13" Foreground="#6A6A9A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botones de ventana -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="btnMinimizar_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="46" Height="48" Cursor="Hand">
                            <TextBlock Text="🗕" FontSize="12" Foreground="#A0A0C0"/>
                        </Button>
                        <Button Click="btnMaximizar_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="46" Height="48" Cursor="Hand">
                            <TextBlock x:Name="lblMaxIcon" Text="🗖" FontSize="12" Foreground="#A0A0C0"/>
                        </Button>
                        <Button Click="btnCerrarVentana_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="46" Height="48" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#FF5555"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Frame de navegacion -->
            <Frame Grid.Row="1" x:Name="frameContenido"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
