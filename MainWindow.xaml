<Window x:Class="SistemaGimnacionOptimusCAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimusCAI Gym"
        Height="768" Width="1360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource Bg0}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MiDiccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Usuario -->
                    <RowDefinition Height="*"/>
                    <!-- Menu -->
                    <RowDefinition Height="Auto"/>
                    <!-- Cerrar sesion -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="16,20,16,16" HorizontalAlignment="Center">
                    <Image Source="/Assets/Logo-gimnasio.png" 
                           Width="200" 
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Usuario logueado -->
                <Button Grid.Row="1" Margin="14,0,14,18" Padding="12,10"
                        Background="{StaticResource Bg2}"
                        BorderBrush="{StaticResource Border2}" BorderThickness="1"
                        Click="btnUsuario_Click" Cursor="Hand"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0"
                                    Background="{StaticResource GreenMain}">
                                <TextBlock x:Name="lblUserIniciales" Text="?"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#071207"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="lblUserNombre" Text="—"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="150"/>
                                <Border x:Name="badgeRol" CornerRadius="6"
                                        Padding="6,1" HorizontalAlignment="Left"
                                        Margin="0,2,0,0"
                                        Background="{StaticResource Bg4}">
                                    <TextBlock x:Name="lblUserRol" Text="—"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource GreenMain}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Menu de navegacion -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource PanelScrollViewerStyle}">
                    <StackPanel x:Name="panelMenu" Margin="10,0,10,10"/>
                </ScrollViewer>

                <!-- Cerrar sesion -->
                <Button Grid.Row="3" Click="btnLogout_Click"
                        Background="Transparent" Foreground="{StaticResource ColorError}"
                        BorderThickness="1" BorderBrush="#3D1A1A"
                        Cursor="Hand" Margin="14,8,14,18" Height="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="borde"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="borde" Property="Background" Value="#2A0E0E"/>
                                    <Setter Property="Foreground" Value="#FF7777"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CERRAR SESIÓN" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════ AREA DE CONTENIDO ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <!-- Barra superior con botones de ventana -->
                <RowDefinition Height="*"/>
                <!-- Frame -->
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{StaticResource Bg1}"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,0.5"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <!-- Buscador global -->
                        <TextBox x:Name="txtBuscadorGlobal"
                                 Style="{StaticResource BuscadorStyle}"
                                 Width="320"
                                 Margin="0,0,20,0"
                                 VerticalAlignment="Center"
                                 Tag="Buscar socio por nombre, apellido o DNI..."
                                 KeyDown="txtBuscadorGlobal_KeyDown"
                                 TextChanged="txtBuscadorGlobal_TextChanged"/>
                        <TextBlock x:Name="lblPaginaActual" Text=""
                                   FontSize="13" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botones de ventana -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="btnMinimizar_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="46" Height="48" Cursor="Hand">
                            <TextBlock Text="🗕" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </Button>
                        <Button Click="btnMaximizar_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="46" Height="48" Cursor="Hand">
                            <TextBlock x:Name="lblMaxIcon" Text="🗖" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </Button>
                        <Button Click="btnCerrarVentana_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="46" Height="48" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#FF5555"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Frame de navegacion -->
            <Frame Grid.Row="1" x:Name="frameContenido"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
